      ((l + 4, 1, 0) : ℕ × ℕ × ℕ) :: shiftr01 (l + 5) 0 B := by
  show ((l + 1, 1, 0) : ℕ × ℕ × ℕ) :: ((l + 1 + 1, 2, 0) : ℕ × ℕ × ℕ) ::
    ((l + 1 + 1 + 1, 2, 0) : ℕ × ℕ × ℕ) :: ((l + 1 + 1 + 1, 1, 0) : ℕ × ℕ × ℕ) ::
    ((l + 1 + 1 + 1 + 1, 1, 0) : ℕ × ℕ × ℕ) ::
    shiftr01 (l + 1 + 1 + 1 + 1 + 1) 0 B = _

        (by simpa using R316s_chain n [] (JkU_nil' (by omega) (n + 2)))
      rw [R316s_succ (n + 3)]
      simpa [show n + 3 + 1 = n + 4 from by omega, show n + 2 + 1 + 1 = n + 4 from by omega,
        show n + 2 + 1 = n + 3 from by omega] using h


              (Jk1.two Wl (Jk1.pay X (Y' ++ [((0, 0, 0) : ℕ × ℕ × ℕ)])))) := by
            have h := JkT_plug_Cok jc (mc + 1) ctx0 hctx0
              (Jk1.two Wl0 (plug (ctx' ++ [Frm.fone V]) (Jk1.two Wl (Jk1.pay X

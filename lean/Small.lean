    (Jk1.one (Jk1.two Jk1.nil Jk1.nil)
      (Jk1.two Jk1.nil (Jk1.one (Jk1.two Jk1.nil Jk1.nil) (Jk1.two Jk1.nil Jk1.nil)))))


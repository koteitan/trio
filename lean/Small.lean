theorem PU_z1 {y : ℕ} (hy : 1 ≤ y) {h : ℕ} {Y0 : TrioSeq}
    (hZ : PU y h (Y0 ++ [((h, y + 1, 0) : ℕ × ℕ × ℕ)])) :

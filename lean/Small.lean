theorem Flat_append {A B : TrioSeq} (hA : Flat A) (hB : Flat B) : Flat (A ++ B) := by
  intro c hc
  rcases List.mem_append.mp hc with h | h
  · exact hA c h
  · exact hB c h

theorem Flat_copies {A : TrioSeq} (hA : Flat A) : ∀ n : ℕ, Flat (copies A n)
  | 0 => by intro c hc; simp [copies] at hc

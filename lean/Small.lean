    (Y0 := A ++ [((1, 1, 0) : ℕ × ℕ × ℕ), ((2, 2, 1) : ℕ × ℕ × ℕ), ((3, 1, 0) : ℕ × ℕ × ℕ)])
    (M := U375d) (d := 5) MidD_U375d.ne (by have := MidD_U375d.head; omega) MidD_U375d.tail
    (R344_copies_mem_gen hA)

  | 0, r, m, hf => TwOk_two trivial (NTw_nil r) hf (TwOk_nil (r + 1) 0)
  | (n + 1), r, m, hf => by
      refine TwOk_two trivial (NTw_nil r) hf ?_
      exact TwOk_one (r + 1) 0 trivial (TwOk_nil (r + 1) 0)
        (TwOk_YX2 n (r + 1) 1 (Fter_succ (r + 1) 0))


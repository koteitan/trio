/-- ★★★★★ 2 の記録は、その左 junk が良ければ 2 の記録の枠として使える。 -/
theorem APd_twoNilB (ks : List Bool) : APd (false :: ks) Jk1.nil :=
  (APd_cf ks _).mpr (fun m U N hU hR hUk hN hNt =>
    (APd_ct _ _).mp (APd_twoNilGen N hN _ hNt) U hU hR hUk)

theorem APd_nil : ∀ ks : List Bool, APd ks Jk1.nil
  | [] => (APd_bnil _).mpr GOK_nil
  | (true :: ks) => APd_nilT ks
  | (false :: ks) => APd_twoNilB ks




/-- ★★★★★ どの妥当な木も、どの形でも項として継げる。 -/
theorem APd_all : ∀ (T : Jk1), JkJ T → ∀ (ks : List Bool), ks ≠ [] → Rq ks T → APd ks T
  | Jk1.nil, _, ks, _, _ => APd_nil ks
  | Jk1.pay V C, h, ks, hne, hR =>
      APd_payA ks V (FrmJ_of_ne ks hne V h.1) (Rq_pay ks V C hR)
        (APd_all V h.1 ks hne (Rq_pay ks V C hR)) C h.2
  | Jk1.one A B, h, ks, hne, hR =>
      APd_step ks (FrmJ_of_ne ks hne A h.1) (Rq_one ks A B hR)
        (APd_all A h.1 ks hne (Rq_one ks A B hR))
        (APd_all B h.2 (true :: ks) (by simp) trivial)
  | Jk1.two N M, h, ks, hne, hR => by
      cases ks with
      | nil => exact absurd rfl hne
      | cons b ks' =>
          cases b with
          | false => exact absurd hR (by simp [Rq, TopOk])
          | true =>
              rw [APd_ct]
              intro U hU hRU hUk
              have hM := APd_all M h.2.1 (false :: ks') (by simp) h.2.2
              have hNall : ∀ j : ℕ, APd (List.replicate j true ++ (true :: ks')) N := by
                intro j
                exact APd_all N h.1 _ (by simp [rep_true_cons]) (by rw [rep_true_cons]; trivial)
              have h0 := (APd_cf ks' M).mp hM 0 U N (by simpa using hU) (by simpa using hRU)
                (by simpa using hUk) (JkA_of_JkJ _ h.1) (by simpa using hNall)
              simpa using h0

/-- ★★★★★ どの妥当な木も、字として語の右に継げる（GoodFb 3 段すべて）。 -/
theorem GOK_all : ∀ (T : Jk1), JkOk T → GOK T
  | Jk1.nil, _ => GOK_nil
  | Jk1.pay N Y, h => AY0 Y h.2 N (JkT_of_JkOk N h.1) (GOK_all N h.1)
  | Jk1.one N M, h => (APd_bnil _).mp
      (APd_step [] (JkT_of_JkOk N h.1 : FrmJ [] N) trivial ((APd_bnil N).mpr (GOK_all N h.1))
        (APd_all M h.2 [true] (by simp) trivial))
  | Jk1.two _ _, h => absurd h (by simp [JkOk])

#print axioms GOK_all


/-! ### 語版と、階段の塔 -/

theorem GoodFb_wordJ : ∀ ws : List Jk1, WJ ws → GoodFb (fun a b => wordJ a b ws) := by
  intro ws
  induction ws using List.reverseRecOn with
  | nil => intro _; exact GoodFb_wordJ_nil
  | append_singleton ws N ih =>
      intro hw
      have hw' : WJ ws := WJ_of_append_left hw
      exact GOK_all N (hw N (by simp)) ws (WOk_of_WJ hw') (ih hw')

/-- ★★★★★ `R338` の上に、木の字の語をどれでも継げる。 -/
theorem rowJ_mem (ws : List Jk1) (hw : WJ ws) :
    R338 ++ (((1, 1, 0) : ℕ × ℕ × ℕ) :: wordJ 1 1 ws) ∈ W 0 := by
  have h := ((GoodFb_wordJ ws hw).seg 0).reapp P0 BaseOk_zero 0 R338
    (LwB_of_base ⟨Aok_R338, rfl⟩)
  simpa using h

theorem stair_tower (n : ℕ) :
    R338 ++ (((1, 1, 0) : ℕ × ℕ × ℕ) :: wordJ 1 1 [stairJ n])
      = Mtw R341 [((3, 1, 0) : ℕ × ℕ × ℕ)] n := by
  have e : (List.range n).flatMap (fun k => shiftr01 k 0 [((3, 1, 0) : ℕ × ℕ × ℕ)])
      = (List.range n).map (fun k => ((3 + k, 1, 0) : ℕ × ℕ × ℕ)) := by
    rw [← flatMap_sing]
    apply List.flatMap_congr
    intro k _
    simp only [shiftr01, List.map_cons, List.map_nil, List.cons.injEq, Prod.mk.injEq,
      and_true, and_self]
    try omega
  rw [wordJ_singleton, colJ, jk1_stairJ n 2, Mtw, e, R341, R338]
  simp

/-- 階段の塔はすべて `W 0`。 -/
theorem stair_tower_mem (n : ℕ) : Mtw R341 [((3, 1, 0) : ℕ × ℕ × ℕ)] n ∈ W 0 := by
  rw [← stair_tower n]
  exact rowJ_mem [stairJ n] (WJ_singleton (JkOk_stairJ n))

/-- ★★★★★ シート行373 `R344 (4,2,0) = psi(W_w*psi_1(W_2))`。 -/
theorem R373_mem : R344 ++ [((4, 2, 0) : ℕ × ℕ × ℕ)] ∈ W 0 := by
  have hM : MidD 4 [((3, 1, 0) : ℕ × ℕ × ℕ)] := by
    have h := MidD_col 3 1 (by omega) (by omega)
    rwa [show 3 + 1 = 4 from rfl] at h
  have h := snocY_mem (Y0 := R341) (M := [((3, 1, 0) : ℕ × ℕ × ℕ)]) (L := 3) (y := 2)
    (by simp [R341, R338]) hM (by simp [entry]) (by omega) stair_tower_mem
  simpa [R344, R341, List.append_assoc] using h


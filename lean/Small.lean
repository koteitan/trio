/-! ### z=1 の列を記録の junk として: `JkGU_z1`, `JkU_z1`。行 312〜316 -/

theorem PkGA_DiaV_W {h : ℕ} {Z : TrioSeq} (hZ : PkGA h Z) : ∀ k : ℕ, Z ++ DiaV h 2 k ∈ W 0
  | 0 => by simpa [DiaV] using (PkGA_Aok hZ).mem

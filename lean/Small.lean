  | (m + 1), l => by
      show jk1 l (TLK m) ++ (((l + 1, 1, 0) : ℕ × ℕ × ℕ) :: jk1 (l + 1) WttK) = _
      rw [jk1_TLK m l, jk1_WttK (l + 1), copies_snoc,
        show l + 1 + 1 = l + 2 from by omega, show l + 1 + 2 = l + 3 from by omega,
        show l + 1 + 3 = l + 4 from by omega, show l + 1 + 4 = l + 5 from by omega,

  obtain ⟨W, fs', rfl, hfs', hJW, hW, hWp⟩ := (Fok_s k fs).mp hfs
  rw [plug_snoc]
  exact Tk_chn m k W Jk1.nil hJW hW (fun C hC => hWp C hC) trivial
    (fun j => Dk_nil (j + 1))
    (fun j C hC => Dk_pay (j + 1) C hC Jk1.nil trivial (Dk_nil (j + 1))) fs' hfs'

theorem TTwA_oneTwoChn (m : ℕ) :

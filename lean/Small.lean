        show c + 2 + t = c + t + 2 from by omega, show c + 3 + t = c + t + 3 from by omega,
        show y + 1 + 1 = y + 2 from by omega] using h1
    · intro B hB
      have h2 := (GoodP_all [B] (Wp_singleton hB)).pu y c hy

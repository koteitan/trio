/-- `R294 ++ (4,2,0)(5,2,0)...(n+3,2,0)` は語 `2^n 3 2`。 -/
theorem Pw_R294_tw2 : ∀ n : ℕ,
    Pw (List.replicate n 2 ++ [3, 2]) 0 (Mtw R294 [((4, 2, 0) : ℕ × ℕ × ℕ)] n)
  | 0 => by rw [Mtw_zero]; exact Pw32_R294

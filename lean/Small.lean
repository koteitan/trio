                  (Jk1.one U (Jk1.pay X (([] : TrioSeq)
                    ++ [((0, 0, 0) : ℕ × ℕ × ℕ)]))))))))
                ⟨hJN, JkA_plug_Fok k fs hfs _
                  ⟨hJV, hJW, JkA_plug_Gok n gs' hgs' _ ⟨hJU, hJX, hYn⟩⟩⟩
              rwa [← plug_snoc2, ← plug_append, ← plug_snoc, ← plug_snoc2,

  | 0 => by simpa [R316s] using W_nil 0
  | 1 => by simpa [R316s, Q] using Q_mem
  | 2 => by
      have h := R296_mem
      simpa [R316s, R296, List.range_succ] using h
  | 3 => by rw [R316s_three]; exact R310_mem

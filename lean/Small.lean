            refine GoodFb_snoc_dupJs0 hw hJT hYn Bok_nil ?_
            intro j _
            have h := (Ek_itJ (T := Jk1.pay X ([] : TrioSeq)) ⟨hJX, Bok_nil⟩ hprev hpn j
              hJU hU (fun C hC => hUp C hC)).2.1 gs' hgs' k V Wl hJV hV hpV hJW hW hWp

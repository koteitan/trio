    jk1 l (HB B) = [((l + 1, 2, 0) : ℕ × ℕ × ℕ), ((l + 1, 1, 0) : ℕ × ℕ × ℕ),
      ((l + 2, 1, 0) : ℕ × ℕ × ℕ)] ++ shiftr01 (l + 3) 0 B := by
  show jk1 l (Jk1.two Jk1.nil Jk1.nil) ++ (((l + 1, 1, 0) : ℕ × ℕ × ℕ) ::
    (jk1 (l + 1) Jk1.nil ++ (((l + 1 + 1, 1, 0) : ℕ × ℕ × ℕ) ::
      (jk1 (l + 1 + 1) Jk1.nil ++ shiftr01 (l + 1 + 1 + 1) 0 B)))) = _

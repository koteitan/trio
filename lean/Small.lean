theorem TwoOk_oneTwoNil : TwoOk (Jk1.one (Jk1.two Jk1.nil Jk1.nil) Jk1.nil) :=
  TwoOk_oneNil ⟨trivial, trivial⟩ TwoOk_twoNil
    (fun C hC => TwoOk_pay C hC (Jk1.two Jk1.nil Jk1.nil) ⟨trivial, trivial⟩ TwoOk_twoNil)


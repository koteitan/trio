      rw [Mtw_one_succ R292 2 n, show 2 + (n + 1) = 2 + n + 1 from by omega]
      exact h

theorem Mtw_R292_310_mem (n : ℕ) : Mtw R292 [((3, 1, 0) : ℕ × ℕ × ℕ)] n ∈ W 0 :=

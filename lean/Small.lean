theorem Kw_itJL {n : ℕ} {T : Jk1} (hJT : JkA T) (hT : Kw (n + 1) T)
    (hpa : ∀ (Y : TrioSeq), Bok Y → ∀ X : Jk1, JkA X → Kw n X → Kw n (Jk1.pay X Y)) :
    ∀ (k : ℕ) {U : Jk1}, Adm n U → Adm n (itJ T k U)
  | 0, _, hU => hU

      have ih := Kw_itJR hJT hT hpb k hU
      have h4 : KwT n (Jk1.one (itJ T k U) T) := fun N hN =>
        Kw_blkT hN ih.ja ih.base (fun C hC => ih.hang C hC) hT
      exact ⟨⟨ih.ja, hJT⟩, h4,
        fun C hC => hpb (Jk1.one (itJ T k U) T) ⟨ih.ja, hJT⟩ h4 C hC⟩


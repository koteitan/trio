theorem jk1_NUB (B : TrioSeq) (l : ℕ) :
    jk1 l (NUB B) = ((l + 1, 1, 0) : ℕ × ℕ × ℕ) :: ((l + 2, 2, 0) : ℕ × ℕ × ℕ) ::

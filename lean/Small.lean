/-! ### ★★★★★ 走りの直上の荷を「塔」1 本に落とす

A2' の dup が要求する横鎖 `twoIt N (pay nil Y) n` は、`n = m+1` のとき
`two (twoIt N (pay nil Y) m) (pay nil Y)`、つまり**兄弟を鎖に取り替えただけの
同じ主張**（荷は 1 つ小さい）。だから兄弟の族が鎖で閉じてさえいれば、A2' は
族の兄弟についての**塔**（先端 `nil`）だけを外から要求する。文脈は任意。 -/

theorem GOK_twoPay_of {ctx : List Frm} (NN : Jk1 → Prop)
    (hJN : ∀ N : Jk1, NN N → JkA N)
    (hcl : ∀ N : Jk1, NN N → ∀ Y : TrioSeq, Bok Y → ∀ k : ℕ,
      NN (twoIt N (Jk1.pay Jk1.nil Y) k))
    (hJTg : ∀ N T : Jk1, JkA N → JkA T → JkT (plug ctx (Jk1.two N T)))
    (htow : ∀ N : Jk1, NN N → GOK (plug ctx (Jk1.two N Jk1.nil))) :
    ∀ Y : TrioSeq, Bok Y → ∀ N : Jk1, NN N →
      GOK (plug ctx (Jk1.two N (Jk1.pay Jk1.nil Y))) := by
  have hnilc : ∀ N : Jk1, NN N →
      GOK (plug ctx (Jk1.two N (Jk1.pay Jk1.nil ([] : TrioSeq)))) := by
    intro N hN
    refine GOK_congr (jk1_plug_congr ctx ?_) (htow N hN)
    intro l
    show jk1 l N ++ (((l + 1, 2, 0) : ℕ × ℕ × ℕ) :: jk1 (l + 1) Jk1.nil)
      = jk1 l N ++ (((l + 1, 2, 0) : ℕ × ℕ × ℕ) ::
          jk1 (l + 1) (Jk1.pay Jk1.nil ([] : TrioSeq)))
    rw [jk1_pay_nil]
  have key : W 0 ⊆ {Y : TrioSeq | Bok Y → ∀ N : Jk1, NN N →
      GOK (plug ctx (Jk1.two N (Jk1.pay Jk1.nil Y)))} := by
    refine A2' ?_
    intro Y hY
    simp only [Set.mem_setOf_eq]
    intro hYb N hN
    by_cases hshort : Y.length ≤ 1
    · rcases (by omega : Y.length = 0 ∨ Y.length = 1) with h0 | h1
      · have hnil0 : Y = [] := List.length_eq_zero_iff.mp h0
        subst hnil0
        exact hnilc N hN
      · obtain ⟨c, rfl⟩ := List.length_eq_one_iff.mp h1
        have hc0 : c.1 = 0 := hYb.root
        obtain ⟨hc1, hc2⟩ := hYb.zroot c (by simp) hc0
        have hcz : c = ((0, 0, 0) : ℕ × ℕ × ℕ) := Prod.ext hc0 (Prod.ext hc1 hc2)
        subst hcz
        have e : ([((0, 0, 0) : ℕ × ℕ × ℕ)] : TrioSeq)
            = ([] : TrioSeq) ++ [((0, 0, 0) : ℕ × ℕ × ℕ)] := by simp
        rw [e]
        have hYn : Bok (([] : TrioSeq) ++ [((0, 0, 0) : ℕ × ℕ × ℕ)]) := by simpa using hYb
        intro ws hw hG
        refine GoodFb_snoc_dupJt0 hw (hJTg N _ (hJN N hN) ⟨trivial, hYn⟩) ?_
        intro n hn
        obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
        exact hnilc (twoIt N (Jk1.pay Jk1.nil ([] : TrioSeq)) m)
          (hcl N hN ([] : TrioSeq) Bok_nil m) ws hw hG
    have hlen2 : 2 ≤ Y.length := by omega
    have hYne : Y ≠ [] := by intro hcc; rw [hcc] at hlen2; simp at hlen2
    rcases hY with ⟨hl, -⟩ | hnat | ⟨mm, hm, -, -⟩
    · exact absurd hl hshort
    · by_cases hlast : entry Y 0 (Y.length - 1) = 0
      · obtain ⟨he1, he2⟩ := Zroot_entry hYb.zroot hlast
        have hcol : Y.getD (Y.length - 1) ((0, 0, 0) : ℕ × ℕ × ℕ)
            = ((0, 0, 0) : ℕ × ℕ × ℕ) := Prod.ext hlast (Prod.ext he1 he2)
        have hgl : Y.getLast hYne = ((0, 0, 0) : ℕ × ℕ × ℕ) := by
          have h1 : Y.getLast hYne = Y.getD (Y.length - 1) ((0, 0, 0) : ℕ × ℕ × ℕ) := by
            rw [List.getLast_eq_getElem, List.getD_eq_getElem?_getD,
              List.getElem?_eq_getElem (show Y.length - 1 < Y.length by omega)]
            rfl
          rw [h1, hcol]
        have hsplit : Y = Y.dropLast ++ [((0, 0, 0) : ℕ × ℕ × ℕ)] := by
          rw [← hgl]; exact (List.dropLast_append_getLast hYne).symm
        have hop : Y⟦1⟧ = Y.dropLast := by
          rw [oper_eq_pred_of_zero 1 (by omega) ⟨hlast, he1, he2⟩]
          unfold Pred
          rw [if_neg (by omega)]
        have hdl := hnat 1 le_rfl
        rw [hop] at hdl
        simp only [Set.mem_setOf_eq] at hdl
        have hdb : Bok Y.dropLast := Bok_dropLast hYb
        have hprev := hdl hdb
        rw [hsplit]
        intro ws hw hG
        refine GoodFb_snoc_dupJt0 hw
          (hJTg N _ (hJN N hN) ⟨trivial, by rw [← hsplit]; exact hYb⟩) ?_
        intro n hn
        obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
        exact hprev (twoIt N (Jk1.pay Jk1.nil Y.dropLast) m)
          (hcl N hN Y.dropLast hdb m) ws hw hG
      · have hnz : ¬ (entry Y 0 (Y.length - 1) = 0 ∧ entry Y 1 (Y.length - 1) = 0 ∧
            entry Y 2 (Y.length - 1) = 0) := fun h => hlast h.1
        have hp := hasParent_of_ZrootMono hYb.zroot hYb.mono hYb.root hlen2 hnz
        intro ws hw hG
        refine GoodFb_snoc_innerJt0 hw (hJTg N _ (hJN N hN) ⟨trivial, hYb⟩) hlen2 hp ?_
        intro n hn
        have hh := hnat n hn
        simp only [Set.mem_setOf_eq] at hh
        exact hh (Bok_oper hYb hn) N hN ws hw hG
    · exact absurd hm (Nat.not_lt_zero mm)
  intro Y hYb N hN
  exact key hYb.mem hYb N hN

#print axioms GOK_twoPay_of

/-! ### ★★★★★ ブロック文脈 `DCtx` と、そこに差せる木の族 `NNo`

枠木の条件を**その場の文脈での良さ**だけにした文脈の族（`NSt` と同じ弱さ）。
塔の文脈（`blkR N Bs i`）も、兄弟 `N` が族 `NNo` に入っていれば `DCtx` になる。
だから `GOK_runGNil_gen` の階段は `NNo N` から出る。 -/

/-- ブロック文脈。1 の枠の兄弟はその場で差せればよく、2 の枠の兄弟は `JkA` だけ。 -/
inductive DCtx : List Frm → Prop
  | base : ∀ {U : Jk1}, JkT U → GOK U → (∀ C : TrioSeq, Bok C → GOK (Jk1.pay U C)) →
      DCtx [Frm.fone U]
  | blk : ∀ {ctx : List Frm} {V : Jk1} {Bs : List Jk1}, DCtx ctx → JkA V →
      (∀ B ∈ Bs, JkA B) → GOK (plug ctx V) → DCtx (ctx ++ blkC V Bs)

/-- どの `DCtx` 文脈にも差せる木。 -/
def NNo (N : Jk1) : Prop := JkA N ∧ ∀ ctx : List Frm, DCtx ctx → GOK (plug ctx N)

theorem blkR_zero (A : Jk1) (Bs : List Jk1) : blkR A Bs 0 = [] := rfl

theorem blkR_snoc (A : Jk1) (Bs : List Jk1) : ∀ i : ℕ,
    blkR A Bs (i + 1) = blkR A Bs i ++ blkC A Bs
  | 0 => by
      show blkC A Bs ++ [] = [] ++ blkC A Bs
      simp
  | (i + 1) => by
      show blkC A Bs ++ blkR A Bs (i + 1) = blkR A Bs (i + 1) ++ blkC A Bs
      conv_lhs => rw [blkR_snoc A Bs i]
      rw [← List.append_assoc]
      rfl

theorem blkR_nil_rep (A : Jk1) : ∀ i : ℕ,
    blkR A ([] : List Jk1) i = List.replicate i (Frm.fone A)
  | 0 => rfl
  | (i + 1) => by
      show blkC A [] ++ blkR A ([] : List Jk1) i = _
      rw [blkR_nil_rep A i, List.replicate_succ]
      rfl

theorem JkA_plug_DCtx : ∀ {ctx : List Frm}, DCtx ctx → ∀ T : Jk1, JkA T →
    JkA (plug ctx T)
  | _, DCtx.base hJU _ _, T, hT => ⟨hJU.1, hT⟩
  | _, DCtx.blk hc hJV hB _, T, hT => by
      rw [plug_blkC]
      exact JkA_plug_DCtx hc _ ⟨hJV, JkA_plug_ftw _ hB hT⟩

theorem JkT_plug_DCtx : ∀ {ctx : List Frm}, DCtx ctx → ∀ T : Jk1, JkA T →
    JkT (plug ctx T)
  | _, DCtx.base hJU _ _, T, hT => ⟨⟨hJU.1, hT⟩, hJU.2⟩
  | _, DCtx.blk hc hJV hB _, T, hT => by
      rw [plug_blkC]
      exact JkT_plug_DCtx hc _ ⟨hJV, JkA_plug_ftw _ hB hT⟩

/-- 塔の文脈も `DCtx`（兄弟 `N` が族に入っていれば）。 -/
theorem DCtx_tow {ctx : List Frm} {N : Jk1} {Bs : List Jk1} (hc : DCtx ctx) (hN : NNo N)
    (hB : ∀ B ∈ Bs, JkA B) : ∀ i : ℕ, DCtx (ctx ++ blkR N Bs i)
  | 0 => by
      rw [blkR_zero, List.append_nil]
      exact hc
  | (i + 1) => by
      have ih := DCtx_tow hc hN hB i
      rw [blkR_snoc, ← List.append_assoc]
      exact DCtx.blk ih hN.1 hB (hN.2 _ ih)

/-- ★★★★★ 族の木は「走りの先端 `nil`」の位置に置ける（階段は族から出る）。 -/
theorem Tow_of_NNo {N : Jk1} (hN : NNo N) :
    ∀ ctx : List Frm, DCtx ctx → GOK (plug ctx (Jk1.two N Jk1.nil)) := by
  intro ctx hc
  cases hc with
  | @base U hJU hGU hUp =>
      have hb : DCtx [Frm.fone U] := DCtx.base hJU hGU hUp
      have hst : ∀ m : ℕ, GOK (plug (([] : List Frm) ++ [Frm.fone U])
          (plug (List.replicate m (Frm.fone N)) N)) := by
        intro m
        rw [← plug_append, List.nil_append, ← blkR_nil_rep N m]
        exact hN.2 _ (DCtx_tow hb hN (by simp) m)
      have hJT : JkT (plug (([] : List Frm) ++ [Frm.fone U])
          (Jk1.two N Jk1.nil)) := by
        rw [List.nil_append]
        exact JkT_plug_DCtx hb _ ⟨hN.1, trivial⟩
      have h := GOK_twoNil_gen [] U hN.1 hJT hGU hst
      rwa [List.nil_append] at h
  | @blk ctx' V Bs hc' hJV hB hGV =>
      have hJT : JkT (plug (ctx' ++ blkC V Bs) (Jk1.two N Jk1.nil)) :=
        JkT_plug_DCtx (DCtx.blk hc' hJV hB hGV) _ ⟨hN.1, trivial⟩
      refine GOK_runGNil_gen hN.1 hB ctx' hJT hGV ?_
      intro i
      have hd : DCtx ((ctx' ++ blkC V Bs) ++ blkR N Bs i) :=
        DCtx_tow (DCtx.blk hc' hJV hB hGV) hN hB i
      exact hN.2 _ hd

#print axioms Tow_of_NNo

/-! ### ★★★★★ 族は「2 の記録 + 荷」で閉じる

A2' の dup が要求する横鎖 `twoIt N (pay nil Y) m` は
`two (twoIt N (pay nil Y) (m-1)) (pay nil Y)` なので、**この定理自身を `m` 回
使えば族に入る**（荷は 1 つ小さいので A2' の帰納法の仮定）。A2' の基底
（荷が空）は `Tow_of_NNo`。 -/

theorem NNo_step : ∀ Y : TrioSeq, Bok Y → ∀ N : Jk1, NNo N →
    NNo (Jk1.two N (Jk1.pay Jk1.nil Y)) := by
  have hnilstep : ∀ N : Jk1, NNo N →
      NNo (Jk1.two N (Jk1.pay Jk1.nil ([] : TrioSeq))) := by
    intro N hN
    refine ⟨⟨hN.1, trivial, Bok_nil⟩, ?_⟩
    intro ctx hctx
    refine GOK_congr (jk1_plug_congr ctx ?_) (Tow_of_NNo hN ctx hctx)
    intro l
    show jk1 l N ++ (((l + 1, 2, 0) : ℕ × ℕ × ℕ) :: jk1 (l + 1) Jk1.nil)
      = jk1 l N ++ (((l + 1, 2, 0) : ℕ × ℕ × ℕ) ::
          jk1 (l + 1) (Jk1.pay Jk1.nil ([] : TrioSeq)))
    rw [jk1_pay_nil]
  have hchain : ∀ (Y : TrioSeq),
      (∀ N : Jk1, NNo N → NNo (Jk1.two N (Jk1.pay Jk1.nil Y))) →
      ∀ N : Jk1, NNo N → ∀ m : ℕ, NNo (twoIt N (Jk1.pay Jk1.nil Y) m) := by
    intro Y hstep N hN m
    induction m with
    | zero => exact hN
    | succ m ih => exact hstep _ ih
  have key : W 0 ⊆ {Y : TrioSeq | Bok Y → ∀ N : Jk1, NNo N →
      NNo (Jk1.two N (Jk1.pay Jk1.nil Y))} := by
    refine A2' ?_
    intro Y hY
    simp only [Set.mem_setOf_eq]
    intro hYb N hN
    by_cases hshort : Y.length ≤ 1
    · rcases (by omega : Y.length = 0 ∨ Y.length = 1) with h0 | h1
      · have hnil0 : Y = [] := List.length_eq_zero_iff.mp h0
        subst hnil0
        exact hnilstep N hN
      · obtain ⟨c, rfl⟩ := List.length_eq_one_iff.mp h1
        have hc0 : c.1 = 0 := hYb.root
        obtain ⟨hc1, hc2⟩ := hYb.zroot c (by simp) hc0
        have hcz : c = ((0, 0, 0) : ℕ × ℕ × ℕ) := Prod.ext hc0 (Prod.ext hc1 hc2)
        subst hcz
        have e : ([((0, 0, 0) : ℕ × ℕ × ℕ)] : TrioSeq)
            = ([] : TrioSeq) ++ [((0, 0, 0) : ℕ × ℕ × ℕ)] := by simp
        have hYn : Bok (([] : TrioSeq) ++ [((0, 0, 0) : ℕ × ℕ × ℕ)]) := by simpa using hYb
        rw [e]
        refine ⟨⟨hN.1, trivial, hYn⟩, ?_⟩
        intro ctx hctx ws hw hG
        refine GoodFb_snoc_dupJt0 hw
          (JkT_plug_DCtx hctx _ ⟨hN.1, trivial, hYn⟩) ?_
        intro n hn
        obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
        exact (hchain ([] : TrioSeq) hnilstep N hN (m + 1)).2 ctx hctx ws hw hG
    have hlen2 : 2 ≤ Y.length := by omega
    have hYne : Y ≠ [] := by intro hcc; rw [hcc] at hlen2; simp at hlen2
    rcases hY with ⟨hl, -⟩ | hnat | ⟨mm, hm, -, -⟩
    · exact absurd hl hshort
    · by_cases hlast : entry Y 0 (Y.length - 1) = 0
      · obtain ⟨he1, he2⟩ := Zroot_entry hYb.zroot hlast
        have hcol : Y.getD (Y.length - 1) ((0, 0, 0) : ℕ × ℕ × ℕ)
            = ((0, 0, 0) : ℕ × ℕ × ℕ) := Prod.ext hlast (Prod.ext he1 he2)
        have hgl : Y.getLast hYne = ((0, 0, 0) : ℕ × ℕ × ℕ) := by
          have h1 : Y.getLast hYne = Y.getD (Y.length - 1) ((0, 0, 0) : ℕ × ℕ × ℕ) := by
            rw [List.getLast_eq_getElem, List.getD_eq_getElem?_getD,
              List.getElem?_eq_getElem (show Y.length - 1 < Y.length by omega)]
            rfl
          rw [h1, hcol]
        have hsplit : Y = Y.dropLast ++ [((0, 0, 0) : ℕ × ℕ × ℕ)] := by
          rw [← hgl]; exact (List.dropLast_append_getLast hYne).symm
        have hop : Y⟦1⟧ = Y.dropLast := by
          rw [oper_eq_pred_of_zero 1 (by omega) ⟨hlast, he1, he2⟩]
          unfold Pred
          rw [if_neg (by omega)]
        have hdl := hnat 1 le_rfl
        rw [hop] at hdl
        simp only [Set.mem_setOf_eq] at hdl
        have hdb : Bok Y.dropLast := Bok_dropLast hYb
        have hprev := hdl hdb
        have hYn : Bok (Y.dropLast ++ [((0, 0, 0) : ℕ × ℕ × ℕ)]) := by
          rw [← hsplit]; exact hYb
        rw [hsplit]
        refine ⟨⟨hN.1, trivial, hYn⟩, ?_⟩
        intro ctx hctx ws hw hG
        refine GoodFb_snoc_dupJt0 hw
          (JkT_plug_DCtx hctx _ ⟨hN.1, trivial, hYn⟩) ?_
        intro n hn
        obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
        exact (hchain Y.dropLast hprev N hN (m + 1)).2 ctx hctx ws hw hG
      · have hnz : ¬ (entry Y 0 (Y.length - 1) = 0 ∧ entry Y 1 (Y.length - 1) = 0 ∧
            entry Y 2 (Y.length - 1) = 0) := fun h => hlast h.1
        have hp := hasParent_of_ZrootMono hYb.zroot hYb.mono hYb.root hlen2 hnz
        refine ⟨⟨hN.1, trivial, hYb⟩, ?_⟩
        intro ctx hctx ws hw hG
        refine GoodFb_snoc_innerJt0 hw
          (JkT_plug_DCtx hctx _ ⟨hN.1, trivial, hYb⟩) hlen2 hp ?_
        intro n hn
        have hh := hnat n hn
        simp only [Set.mem_setOf_eq] at hh
        exact (hh (Bok_oper hYb hn) N hN).2 ctx hctx ws hw hG
    · exact absurd hm (Nat.not_lt_zero mm)
  intro Y hYb N hN
  exact key hYb.mem hYb N hN

#print axioms NNo_step

theorem NNo_congr {A B : Jk1} (hJB : JkA B) (h : ∀ l, jk1 l A = jk1 l B) (hA : NNo A) :
    NNo B :=
  ⟨hJB, fun ctx hctx => GOK_congr (jk1_plug_congr ctx h) (hA.2 ctx hctx)⟩

/-- 1 の記録を足しても族に残る（文脈に詰め替えるだけ）。 -/
theorem NNo_one {U X : Jk1} (hU : NNo U) (hX : NNo X) : NNo (Jk1.one U X) := by
  refine ⟨⟨hU.1, hX.1⟩, ?_⟩
  intro ctx hctx
  have hd : DCtx (ctx ++ blkC U ([] : List Jk1)) :=
    DCtx.blk hctx hU.1 (by simp) (hU.2 ctx hctx)
  have h := hX.2 _ hd
  rw [show blkC U ([] : List Jk1) = [Frm.fone U] from rfl, plug_snoc] at h
  exact h

/-- ★★★★★ 1 の記録の直上の荷（A2' と鎖 `itJ` の帰納法）。 -/
theorem NNo_payU : ∀ Y : TrioSeq, Bok Y → ∀ U X : Jk1, NNo U → NNo X →
    NNo (Jk1.one U (Jk1.pay X Y)) := by
  have hnilstep : ∀ U X : Jk1, NNo U → NNo X →
      NNo (Jk1.one U (Jk1.pay X ([] : TrioSeq))) := by
    intro U X hU hX
    exact NNo_congr ⟨hU.1, hX.1, Bok_nil⟩ (fun l => (jk1_one_pay_nil U X l).symm)
      (NNo_one hU hX)
  have hchain : ∀ (X : Jk1) (Y : TrioSeq),
      (∀ U : Jk1, NNo U → NNo (Jk1.one U (Jk1.pay X Y))) →
      ∀ U : Jk1, NNo U → ∀ n : ℕ, NNo (itJ (Jk1.pay X Y) n U) := by
    intro X Y hstep U hU n
    induction n with
    | zero => exact hU
    | succ n ih => exact hstep _ ih
  have key : W 0 ⊆ {Y : TrioSeq | Bok Y → ∀ U X : Jk1, NNo U → NNo X →
      NNo (Jk1.one U (Jk1.pay X Y))} := by
    refine A2' ?_
    intro Y hY
    simp only [Set.mem_setOf_eq]
    intro hYb U X hU hX
    by_cases hshort : Y.length ≤ 1
    · rcases (by omega : Y.length = 0 ∨ Y.length = 1) with h0 | h1
      · have hnil0 : Y = [] := List.length_eq_zero_iff.mp h0
        subst hnil0
        exact hnilstep U X hU hX
      · obtain ⟨c, rfl⟩ := List.length_eq_one_iff.mp h1
        have hc0 : c.1 = 0 := hYb.root
        obtain ⟨hc1, hc2⟩ := hYb.zroot c (by simp) hc0
        have hcz : c = ((0, 0, 0) : ℕ × ℕ × ℕ) := Prod.ext hc0 (Prod.ext hc1 hc2)
        subst hcz
        have e : ([((0, 0, 0) : ℕ × ℕ × ℕ)] : TrioSeq)
            = ([] : TrioSeq) ++ [((0, 0, 0) : ℕ × ℕ × ℕ)] := by simp
        have hYn : Bok (([] : TrioSeq) ++ [((0, 0, 0) : ℕ × ℕ × ℕ)]) := by simpa using hYb
        rw [e]
        refine ⟨⟨hU.1, hX.1, hYn⟩, ?_⟩
        intro ctx hctx ws hw hG
        refine GoodFb_snoc_dupJs0 hw
          (JkT_plug_DCtx hctx _ ⟨hU.1, hX.1, hYn⟩) hYn Bok_nil ?_
        intro n hn
        exact (hchain X ([] : TrioSeq) (fun U' hU' => hnilstep U' X hU' hX) U hU n).2
          ctx hctx ws hw hG
    have hlen2 : 2 ≤ Y.length := by omega
    have hYne : Y ≠ [] := by intro hcc; rw [hcc] at hlen2; simp at hlen2
    rcases hY with ⟨hl, -⟩ | hnat | ⟨mm, hm, -, -⟩
    · exact absurd hl hshort
    · by_cases hlast : entry Y 0 (Y.length - 1) = 0
      · obtain ⟨he1, he2⟩ := Zroot_entry hYb.zroot hlast
        have hcol : Y.getD (Y.length - 1) ((0, 0, 0) : ℕ × ℕ × ℕ)
            = ((0, 0, 0) : ℕ × ℕ × ℕ) := Prod.ext hlast (Prod.ext he1 he2)
        have hgl : Y.getLast hYne = ((0, 0, 0) : ℕ × ℕ × ℕ) := by
          have h1 : Y.getLast hYne = Y.getD (Y.length - 1) ((0, 0, 0) : ℕ × ℕ × ℕ) := by
            rw [List.getLast_eq_getElem, List.getD_eq_getElem?_getD,
              List.getElem?_eq_getElem (show Y.length - 1 < Y.length by omega)]
            rfl
          rw [h1, hcol]
        have hsplit : Y = Y.dropLast ++ [((0, 0, 0) : ℕ × ℕ × ℕ)] := by
          rw [← hgl]; exact (List.dropLast_append_getLast hYne).symm
        have hop : Y⟦1⟧ = Y.dropLast := by
          rw [oper_eq_pred_of_zero 1 (by omega) ⟨hlast, he1, he2⟩]
          unfold Pred
          rw [if_neg (by omega)]
        have hdl := hnat 1 le_rfl
        rw [hop] at hdl
        simp only [Set.mem_setOf_eq] at hdl
        have hdb : Bok Y.dropLast := Bok_dropLast hYb
        have hprev := hdl hdb
        have hYn : Bok (Y.dropLast ++ [((0, 0, 0) : ℕ × ℕ × ℕ)]) := by
          rw [← hsplit]; exact hYb
        rw [hsplit]
        refine ⟨⟨hU.1, hX.1, hYn⟩, ?_⟩
        intro ctx hctx ws hw hG
        refine GoodFb_snoc_dupJs0 hw
          (JkT_plug_DCtx hctx _ ⟨hU.1, hX.1, hYn⟩) hYn hdb ?_
        intro n hn
        exact (hchain X Y.dropLast (fun U' hU' => hprev U' X hU' hX) U hU n).2
          ctx hctx ws hw hG
      · have hnz : ¬ (entry Y 0 (Y.length - 1) = 0 ∧ entry Y 1 (Y.length - 1) = 0 ∧
            entry Y 2 (Y.length - 1) = 0) := fun h => hlast h.1
        have hp := hasParent_of_ZrootMono hYb.zroot hYb.mono hYb.root hlen2 hnz
        refine ⟨⟨hU.1, hX.1, hYb⟩, ?_⟩
        intro ctx hctx ws hw hG
        refine GoodFb_snoc_innerJs0 hw
          (JkT_plug_DCtx hctx _ ⟨hU.1, hX.1, hYb⟩) hYb hlen2 hp ?_
        intro n hn
        have hh := hnat n hn
        simp only [Set.mem_setOf_eq] at hh
        exact (hh (Bok_oper hYb hn) U X hU hX).2 ctx hctx ws hw hG
    · exact absurd hm (Nat.not_lt_zero mm)
  intro Y hYb U X hU hX
  exact key hYb.mem hYb U X hU hX


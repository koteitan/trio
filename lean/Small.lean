theorem Kw_itJR {n : ℕ} {T : Jk1} (hJT : JkA T) (hT : Kw (n + 1) T)
    (hpb : ∀ (Z : Jk1), JkA Z → KwT n Z → ∀ (B : TrioSeq), Bok B → KwT n (Jk1.pay Z B)) :
    ∀ (k : ℕ) {U : Jk1}, AdmT n U → AdmT n (itJ T k U)
  | 0, _, hU => hU

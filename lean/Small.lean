/-- `PkGA` の元（頂上が `(h,2,0)`）の上に `(h+1,3,1)`。 -/
theorem PkGA_z1 {h : ℕ} {Y0 : TrioSeq} (hZ : PkGA h (Y0 ++ [((h, 2, 0) : ℕ × ℕ × ℕ)])) :
    Y0 ++ [((h, 2, 0) : ℕ × ℕ × ℕ), ((h + 1, 2 + 1, 1) : ℕ × ℕ × ℕ)] ∈ W 0 := by

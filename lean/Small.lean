  | (m + 1) => GOK_oneU_twotwo (TL m) (JkT_TL m) (GOK_TL m)

theorem jk1_TL : ∀ (m l : ℕ),
    jk1 l (TL m) = copies [((l + 1, 1, 0) : ℕ × ℕ × ℕ), ((l + 2, 2, 0) : ℕ × ℕ × ℕ),
      ((l + 3, 2, 0) : ℕ × ℕ × ℕ)] m

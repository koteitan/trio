  have e : jk1 2 (Jk1.one Jk1.nil (Jk1.two Jk1.nil
        (Jk1.one (Jk1.two Jk1.nil Jk1.nil) (YX2 m))))
      = [((3, 1, 0) : ℕ × ℕ × ℕ), ((4, 2, 0) : ℕ × ℕ × ℕ), ((5, 2, 0) : ℕ × ℕ × ℕ),

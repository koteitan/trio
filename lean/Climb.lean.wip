/-
Climb.lean.wip: シート登り（フロンティア R_pm3 = 行 1690 の直上）。**未完（sorry あり）**。
lakefile には入れない。次の行 1691 の壁の scaffolding を記録する。

確定事項:
- 真のフロンティア = HeW.R_pm3 = (0,0,0)(1,1,1)(2,1,1)(2,1,0)(3,2,0)(4,2,0)(1,1,1)(2,1,1)
  = シート行 1690 = psi(W_(w^2+1)^2+W_(w^2))。全 lean の無条件 `∈ W 0` を translate+olt で機械照合。
- 次の行 1691 = (0,0,0)(1,1,1)(2,1,1)(2,1,0)(3,2,0)(4,2,0)(3,2,0) = psi(W_(w^2+1)^2+W_(w^2+1))。
  語 w1691（下記）は **検証済み**: R1691 の simpa が sorry ベースの hK_1691 で閉じる ⇒
  (0,0,0) :: rword 0 0 [w1691] が行 1691 の行列にちょうど一致する。
- 残る唯一の穴 = hK_1691 : GTC CLTL 0 w1691。これが壁。

壁の正体（Subst1 とは別、それより下）:
- w1691 の F のタイ (2,1,0) の子 = [深い葉 tie 1 [tie 1 []], shallow 兄弟 tie 1 []]。
- 深い葉はトップレベルなので TreeTs でなく HeT の upleaf 経路（upleaf_deep_coreDT）が要る。
  下記 hK_1691 は upleaf_deep_coreDT を適用済み（side condition 全て decide で discharge）、
  **残る唯一の穴 = hrep（tower の GTC）**:
    ⊢ GTC CLTL 0 ([(1,1,1)] ++ shiftr01 0 0 (shiftr01 1 0 (tow 1 0 [(1,2,0),(2,2,0),(1,2,0)] m')))
  この tower = base (0,1,0)(1,2,0)(2,2,0) + 階段ブロック (b,1,0)(b+1,2,0)(b+2,2,0)（b=1..j）。
  各ブロックは深い葉 (b+1,2,0)(b+2,2,0) = tie 1 [tie 1 []] を含む ⇒ **tower が木に潰れない**
  （単一深い葉 R_pm の tow_dtree は tie1/tie0 交互で TreeTs=木、GTC_wLTL で閉じる。兄弟つきは
  ブロックごとに tie0 分離子がなく深い葉が残る）。∴ GTC_wLTL 不可。
- 一般の「深い葉の塔の良さ」は **HeR.Gd_deep_towers**（Xtow・SpineL・clD で各段 clD-good）に存在。
  ただしこれは far-word 側の GdT/clD 述語パス用。トップレベルの GTC_wLTL/GoodTTL/TreeTs パスへ
  配線する新規統合（HeU 規模）が要る。生成器 gen_gyk.py も同理由で 1688-1780 全滅
  （treelit_top の p<l 検査が深い葉を弾く）。
- 領域 [1691,1948] の壁: 直上 18 行（1691,1692,1693,1695,1696,1697,1698,1701,1702,1703,1706,
  1707,1709,1710,1711,1712,1713,1714）が深い葉の塔族（壁 A）。行 1715 以降は (3,2,1) 等の
  入れ子 z=1 far-word = Subst1 系。
-/
import HeW

namespace TRIO
namespace Climb

open Wset Small HdA HdB HdE HdQ HeI HeK HeL
open GwS GxL GxJ GzJ GxP GxN HbP
open HeN HeT HeU HeW

/-- 深い葉 tie 1 [tie 1 []]。 -/
noncomputable def dl : HdA.UT := HdA.UT.tie 1 [HdA.UT.tie 1 []]

/-- ★ tower 方程式: 深い葉+兄弟の descent [(1,2,0),(2,2,0),(1,2,0)] の塔
    = towT 0 [dl] j の topTs。towT 0 [dl] j = [dl, tie 0 [dl, tie 0 [...]]]（各段に深い葉）。 -/
theorem tow_sib (j : ℕ) :
    (tow 1 0 [((1,2,0):ℕ×ℕ×ℕ),((2,2,0):ℕ×ℕ×ℕ),((1,2,0):ℕ×ℕ×ℕ)] (j+1) : TrioSeq)
      = ((0,1,0):ℕ×ℕ×ℕ) :: topTs 0 (HeH.towT 0 [dl] j) := by
  induction j with
  | zero =>
      simp [dl, tow, graft_eq_shift, topTs, topT, shiftr01, HeH.towT, entry, List.getD]
  | succ j ih =>
      rw [tow, graft_eq_shift]
      simp only [show [((1,2,0):ℕ×ℕ×ℕ),((2,2,0):ℕ×ℕ×ℕ),((1,2,0):ℕ×ℕ×ℕ)].dropLast
          = [((1,2,0):ℕ×ℕ×ℕ),((2,2,0):ℕ×ℕ×ℕ)] from rfl,
        show entry [((1,2,0):ℕ×ℕ×ℕ),((2,2,0):ℕ×ℕ×ℕ),((1,2,0):ℕ×ℕ×ℕ)] 0
          ([((1,2,0):ℕ×ℕ×ℕ),((2,2,0):ℕ×ℕ×ℕ),((1,2,0):ℕ×ℕ×ℕ)].length - 1) = 1 from rfl]
      rw [ih]
      simp [dl, HeH.towT, topTs, topT, shiftr01]

/-- ★★ 一般補題（残る穴 = 壁 A）: 深い葉の塔 towT 0 [dl] j の語は GTC-good。
    base(j=0) = HeT.hK_pm（純粋な深い葉）。succ = TreeTs-free の GdT/tower 版が要る
    （GdT_towT は GdT の定義に TreeTs を含み base [dl] が不可、TExt/GdT_jump も TreeTs 依存）。 -/
theorem key_towT (j : ℕ) :
    GTC CLTL 0 (wLT 0 ([HeH.towT 0 [dl] j], ([] : List (Option TrioSeq)))) := by
  induction j with
  | zero =>
      have h := HeT.hK_pm
      simpa [dl, HeH.towT] using h
  | succ j ih =>
      -- towT 0 [dl] (j+1) = [dl] ++ [tie 0 (towT 0 [dl] j)]。IH = GTC of towT 0 [dl] j。
      -- 深い葉 dl を base に持つ塔の段追加。GdT_towT/GdT_jump は TreeTs 要求で不可。
      -- 必要: TreeTs-free の「deep-leaf 塔」補題（HeL/HeM/HeN の GdT/TExt/path の TreeTs-free 版）。
      sorry

/-- 行 1691 の語: 深い葉 tie 1 [tie 1 []] の F のタイに shallow 兄弟 tie 1 [] を足す。 -/
noncomputable def w1691 : TrioSeq :=
  wLT 0 ([[HdA.UT.tie 1 [HdA.UT.tie 1 []], HdA.UT.tie 1 []]], ([] : List (Option TrioSeq)))

/-- ★ 残る穴（壁）: 深い葉+兄弟の tower が木に潰れないため未証明。 -/
theorem hK_1691 : GTC CLTL 0 w1691 := by
  unfold w1691
  have e : wLT 0 ([[HdA.UT.tie 1 [HdA.UT.tie 1 []], HdA.UT.tie 1 []]], ([] : List (Option TrioSeq)))
      = ([(1,1,1)] : TrioSeq) ++ shiftr01 0 0 (shiftr01 1 0
        (((0, 1, 0) : ℕ×ℕ×ℕ) :: ([((1,2,0):ℕ×ℕ×ℕ),((2,2,0):ℕ×ℕ×ℕ)] ++ [((1,2,0):ℕ×ℕ×ℕ)]))) := by
    simp [wLT, FTL0, topTs, topT, unitsC, shiftr01]
  rw [e]
  refine upleaf_deep_coreDT (C := CLTL) (u := 0) (d := 0) (q := 1) (d0 := 1) (m := 2)
    (D := [((1,2,0):ℕ×ℕ×ℕ),((2,2,0):ℕ×ℕ×ℕ)])
    (by intro p hp; simp at hp; rcases hp with rfl | rfl <;> decide)
    (by intro p hp; simp at hp; rcases hp with rfl | rfl <;> decide)
    (by decide) (by decide) (by decide) (fun m' hm' => ?_)
  obtain ⟨j, rfl⟩ : ∃ j, m' = j + 1 := ⟨m' - 1, by omega⟩
  rw [show ([((1,2,0):ℕ×ℕ×ℕ),((2,2,0):ℕ×ℕ×ℕ)] ++ [((1,2,0):ℕ×ℕ×ℕ)])
      = [((1,2,0):ℕ×ℕ×ℕ),((2,2,0):ℕ×ℕ×ℕ),((1,2,0):ℕ×ℕ×ℕ)] from rfl, tow_sib j]
  have ekey : ([(1,1,1)] : TrioSeq) ++ shiftr01 0 0 (shiftr01 1 0
        (((0,1,0):ℕ×ℕ×ℕ) :: topTs 0 (HeH.towT 0 [dl] j)))
      = wLT 0 ([HeH.towT 0 [dl] j], ([] : List (Option TrioSeq))) := by
    rw [shiftr01_zero]
    simp [wLT, FTL0, shiftr01, unitsC]
  rw [ekey]
  exact key_towT j

/-- 行 1691 = (0,0,0)(1,1,1)(2,1,1)(2,1,0)(3,2,0)(4,2,0)(3,2,0)。語 w1691 が正しいことの確認
    （hK_1691 が sorry でも simpa が閉じる ⇒ 行列一致）。 -/
theorem R1691 : ([(0,0,0),(1,1,1),(2,1,1),(2,1,0),(3,2,0),(4,2,0),(3,2,0)] : TrioSeq) ∈ W 0 := by
  have hB := hK_1691 [] ⟨[], PsLTL_nil 0, rfl⟩ (by simp) (BwT_nil 0)
  have hS : StarOK 0 (rword 0 0 [w1691]) := by
    refine ⟨?_, fun p hp => rword_ge 0 0 _ p hp⟩
    have h2 := hB 0 le_rfl
    rw [Nat.sub_self] at h2
    simpa only [mlift_zero, List.map_id', List.nil_append] using h2
  have h := W0_of_starOK hS
  simpa [w1691, rword, rcol, wLT, FTL0, topTs, topT, unitsC, shiftr01] using h

end Climb
end TRIO

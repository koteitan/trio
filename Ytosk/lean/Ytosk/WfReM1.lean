def ρ : Valn := ⟨fun i => ρO.getD i z, fun i => ρV.getD i z⟩

theorem expand_eq : expand WfSrcC3Cex.M 3 = N := by decide

theorem standard : Std N := expand_eq ▸ Std.exp 3 WfSrcC3Cex.standard

theorem ne_sro : N ≠ SRO := by decide

theorem take_eq : N.take 36 = expand WfSrcC3Cex.M 2 := by decide

theorem cons : Cons N ρ := by unfold Cons; decide

theorem consT : Cons (N.take 36) WfSrcC3Cex.σ := take_eq ▸ WfSrcC3Cex.consN

theorem not_bad2 : ¬ Bad2 N := by
  rintro ⟨⟨k, hk⟩, _⟩
  have h : upg N (N.length - 2) = none := by decide
  rw [h] at hk; cases hk

theorem s_mem : s ∈ summands (vOpt ρ (par N 1 32)) := by decide

theorem s_lt : s < bumpW N ρ 32 := by decide

theorem s_geT : ¬ s < bumpW (N.take 36) WfSrcC3Cex.σ 32 := by decide

theorem s_not_lhd : ¬ Lhd z s (bumpW N ρ 32) := by
  intro h
  have hd := h.2 z (bumpW N ρ 32) h.1 (le_refl _)
  have hno : ¬ ∀ g ∈ comps z s, ∃ y ∈ comps z (bumpW N ρ 32) ++ Gc z z, g ≤ y := by decide
  exact hno hd

theorem hx_any (ρ' : Valn) :
    ∀ j ∈ children N 32, col N j = bump N 32 → children N j = [36] → ρ'.v 36 = z := by
  have h : ∀ j ∈ children N 32, col N j = bump N 32 → children N j ≠ [36] := by decide
  intro j hj hb hc
  exact absurd hc (h j hj hb)

theorem xparnb : XParNB N 36 := by
  intro q i hq hi
  have hq' : par N 0 36 = some 35 := by decide
  have hi' : par N 0 35 = some 34 := by decide
  rw [hq'] at hq; cases hq
  rw [hi'] at hi; cases hi
  decide

/-- `BumpAbsC` fails for every valuation that agrees with `ρ` on the columns. -/
theorem not_bumpAbsC_of (ρ' : Valn) (hu : ∀ i, i < N.length → ρ'.o i = ρ.o i ∧ ρ'.v i = ρ.v i) :
    ¬ BumpAbsC N 36 ρ' := by
  intro h
  have hW : bumpW N ρ' 32 = bumpW N ρ 32 := by
    unfold bumpW
    congr 2
    congr 1
    apply List.map_congr_left
    intro j hj
    unfold bumpTerm
    split
    · congr 2
      apply List.map_congr_left
      intro c hc
      exact (hu c (mem_children hc).2).1
    · rfl
  have hp : par N 1 32 = some 31 := by decide
  have hV : vOpt ρ' (par N 1 32) = vOpt ρ (par N 1 32) := by
    rw [hp]; exact (hu 31 (by decide)).2
  have h' := h WfSrcC3Cex.σ consT 32 (by decide) (by decide) (hx_any ρ') (Or.inr (Or.inl xparnb)) s
    (hV ▸ s_mem) s_geT (hW ▸ s_lt)
  exact s_not_lhd (hW ▸ h')

theorem not_bumpAbsC : ¬ BumpAbsC N 36 ρ :=
  not_bumpAbsC_of ρ (fun _ _ => ⟨rfl, rfl⟩)

/-- **The `BumpAbsC` part of `HDropU` without `Inv3V2` (only `Cons`) is false.** -/
theorem bumpAbsC_core_false :
    ¬ (∀ M ρ, Std M → M ≠ SRO → M ≠ [] → Cons M ρ →
      (¬ Bad2 M ∨ entry M 1 (M.length - 1) = 0) → BumpAbsC M (M.length - 1) ρ) := by
  intro h
  exact not_bumpAbsC (h N ρ standard ne_sro (by decide) cons (Or.inl not_bad2))

/-- **`HDropU` is false as soon as N has an `Inv3V2` valuation** (`Cons` is unique given the ranking). -/
theorem not_HDropU_of_inv (hI : ∃ ρ' rk, Inv3V2 N ρ' rk) : ¬ HDropU := by
  intro hU
  obtain ⟨ρ', rk, I⟩ := hI
  have hb := (hU N ρ' rk standard ne_sro (by decide) I).2 (Or.inl not_bad2)
  exact not_bumpAbsC_of ρ' (cons_unique I.cons cons I.rank) hb

/-- **The hypotheses of `hInvV2_all` are inconsistent** (they include `HDropU`). -/
theorem not_HDropU_of (hU : HDropU) (hD : HDropV2) (hT : HTakeV2) (hTB : TakeBadV2) (hBO : BadOutV2)
    (h0 : ExpT0OutV2) (h1 : ExpT1OutV2) (h2 : ExpT2V2) (hCB : T2CBadOut) : False :=
  not_HDropU_of_inv (hInvV2_all hU hD hT hTB hBO h0 h1 h2 hCB N standard ne_sro (by decide)) hU


def ρ : Valn := ⟨fun i => ρO.getD i z, fun i => ρV.getD i z⟩
def τ : Valn := ⟨fun i => τO.getD i z, fun i => τV.getD i z⟩

private theorem std_fold : ∀ (ns : List Nat) (N : Mat), Std N → Std (ns.foldl expand N)
  | [], _, h => h
  | n :: ns, N, h => std_fold ns (expand N n) (Std.exp n h)

theorem standard : Std N := by
  have h : trace.foldl expand SRO = N := by decide
  rw [← h]
  exact std_fold trace SRO Std.sro

theorem cons : Cons N ρ := by unfold Cons; decide

theorem consT : Cons (N.take 45) τ := by unfold Cons; decide

theorem hX : spArg (τ.v 41) z (sumN ((CL (N.take 45) 41).map τ.o)) = app (t2B (ρ.v 41) ρ []) (psi t1 z z) := by
  decide

theorem path : PathLvAll N ρ 41 (ρ.v 30) :=
  PathLvAll.step (k := 34) (c := 41) (Lc := []) (R := []) (s := s41) (y := y41) (by decide) (by decide)
    ⟨by decide, by decide⟩
    (PathLvAll.top (k := 30) (c := 34) (Lc := [31]) (R := []) (s := s34) (y := y34) (by decide) (by decide)
      ⟨by decide, by decide⟩)

theorem hu : ¬ lt (ρ.v 41) (ρ.v 30) = true := by decide

theorem g_mem : g ∈ comps (ρ.v 30) t1 ++ comps (ρ.v 30) (qnS N ρ 41 4 42) := by decide

theorem g_not_lt : ¬ g < app (t2B (ρ.v 41) ρ []) (psi t1 z z) := by decide

theorem not_qnBase : ¬ WfScout.T2SeedQNBaseR N ρ 41 4 42 [] := by
  intro h
  exact g_not_lt ((h τ consT t1 hX).2 (ρ.v 30) path hu g g_mem)

/-- **The qn field of `T2SeedClV2R` with `StepCtxT2` replaced by `Std ∧ Cons` is false.** -/
theorem qnBase_core_false :
    ¬ (∀ M ρ, Std M → Cons M ρ → col M (M.length - 1) ≠ (0, 0, 0) → TRIO.srow M (M.length - 1) = 2 →
      ∀ r L, r + L + 1 = M.length → par M 2 (r + L) = some r →
      ∀ q Lc, par M 0 (r + L) = some q → q ≠ r → CL M r = Lc ++ [q] → WfScout.T2SeedQNBaseR M ρ r L q Lc) := by
  intro h
  exact not_qnBase (h N ρ standard cons (by decide) (by decide) 41 4 (by decide) (by decide) 42 [] (by decide)
    (by decide) (by decide))

/-- **`T2SeedClV2R` is false if N has the step context** (with the valuation of `Cons`). -/
theorem not_T2SeedClV2R_of_ctx (hC : ∃ rk, StepCtxT2 N ρ rk) : ¬ WfScout.T2SeedClV2R := by
  intro h
  obtain ⟨rk, C⟩ := hC
  exact not_qnBase ((h N ρ rk C (by decide) (by decide) 41 4 (by decide) (by decide)).1 42 [] (by decide)
    (by decide) (by decide))


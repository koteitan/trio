theorem exp2 : expand N 2 = N2 := by decide
theorem exp3 : expand N 3 = N3 := by decide

/-- `expand N n` is the engine's `gexp N 22 3 3 0 n` (ExpGexp.expand_eq_gexp). -/
theorem expand_gexp (n : Nat) : expand N n = TRIO.gexp N 22 3 3 0 n := by
  have h := expand_eq_gexp N n (by decide) (by decide) (r := 22) (by decide)
  have hs : TRIO.srow N (N.length - 1) = 1 := by decide
  rw [hs] at h
  simp only [Nat.lt_irrefl, Nat.zero_lt_one, if_true, if_false] at h
  rw [h]
  rfl

theorem gexp2 : TRIO.gexp N 22 3 3 0 2 = N2 := (expand_gexp 2).symm.trans exp2
theorem gexp3 : TRIO.gexp N 22 3 3 0 3 = N3 := (expand_gexp 3).symm.trans exp3


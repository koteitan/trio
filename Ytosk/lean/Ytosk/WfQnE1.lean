theorem ne3 : τ3.v 20 ≠ fsD (ρ.v 20) ζ1 := by decide

/-- The non-absorbed summand: `A[ζ] ≤ q0 < A` at `ζ = seed` and at `ζ = gamS 1`. -/
theorem q0_window : q0 < ρ.v 20 ∧ ¬ q0 < fsD (ρ.v 20) ζ0 ∧ ¬ q0 < fsD (ρ.v 20) ζ1 := by decide

/-- `AbsDS`'s conclusion also fails at the next chain index (so `hADζ` is false at `m = 1`, not only at `m = 0`). -/
theorem absDS_gam1_false : ¬ q0 < fsD Wl ζ1 := by decide

/-- **The engine's glued valuation is not a valuation of N[2]** (whatever the copy part `ρP`). -/
theorem not_cons_glue2 (ρP : Valn) : ¬ Cons (TRIO.gexp N 22 3 3 0 2) (glueZ N 25 ρ ρP (fun _ => ζ0)) := by
  rw [gexp2]
  intro h
  obtain ⟨rk, hrk⟩ := rk_std std2 (by decide)
  have e := (cons_unique h cons2 hrk 20 (by decide)).2
  rw [glueZ_v_dep _ _ _ (by decide) dep20] at e
  exact ne2 e.symm

/-- **The engine's glued valuation is not a valuation of N[3]** (index `gamS 1`). -/
theorem not_cons_glue3 (ρP : Valn) : ¬ Cons (TRIO.gexp N 22 3 3 0 3) (glueZ N 25 ρ ρP (fun _ => ζ1)) := by
  rw [gexp3]
  intro h
  obtain ⟨rk, hrk⟩ := rk_std std3 (by decide)
  have e := (cons_unique h cons3 hrk 20 (by decide)).2
  rw [glueZ_v_dep _ _ _ (by decide) dep20] at e
  exact ne3 e.symm

/-- The seed is the drop value under every ranking (WfInvX1.drop_o): the indices above are the engine's. -/
theorem seed_eq (rk : Bool → Nat → Nat) (hR : Rk N rk) : (drop1 N 25 rk).o 22 = ζ0 := drop_o rk hR


namespace Ytosk.V3Main.SeedPF
open T Classical WfExQ1 WfExQ2 G
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

theorem qr_frame_preV3 {M : Mat} {ρ : Valn} {rk : Bool → Nat → Nat}
    (hM : Std M) (hS : M ≠ SRO) (I : Inv3W M ρ rk)
    (hz : col M (M.length - 1) ≠ (0, 0, 0)) (h2 : TRIO.srow M (M.length - 1) = 2)
    {r L : Nat} (hlen : r + L + 1 = M.length) (hr : par M 2 (r + L) = some r)
    (hq : par M 0 (r + L) = some r) (hXu : ∀ i, upg M i ≠ some (r + L))
    {Lc : List Nat} (hCLM : CL M r = Lc ++ [r + L])
    {n : Nat} (hn : 2 ≤ n) {σ : Valn} {rkN : Bool → Nat → Nat}
    (hCN : Cons (TRIO.gexp M r L (entry M 0 (r + L) - entry M 0 r) (entry M 1 (r + L) - entry M 1 r) n) σ)
    (hRN : Rk (TRIO.gexp M r L (entry M 0 (r + L) - entry M 0 r) (entry M 1 (r + L) - entry M 1 r) n) rkN)
    :
    CL (TRIO.gexp M r L (entry M 0 (r + L) - entry M 0 r) (entry M 1 (r + L) - entry M 1 r) n) r = Lc ++ [r + L] ∧ σ.v r = ρ.v r ∧ (∀ d ∈ Lc, σ.o d = ρ.o d) := by
  obtain ⟨hX, hJ⟩ := sInvXJ_std hM hS
  set d0 := entry M 0 (r + L) - entry M 0 r with hd0def
  set d1 := entry M 1 (r + L) - entry M 1 r with hd1def
  set N := TRIO.gexp M r L d0 d1 n with hN
  set P := TRIO.gexp M r L d0 d1 (n - 1) with hP
  have hrx : r < r + L := par_lt M 0 _ _ hq
  have hL0 : 0 < L := by omega
  have hA : Anc0 M r (r + L) := anc0_of_par M 2 r (r + L) hr
  have he0lt := anc0_e0_lt hA (by omega)
  have hd0e : entry M 0 (r + L) = entry M 0 r + d0 := by omega
  have hd0 : 0 < d0 := by omega
  obtain ⟨he2r, h1lt⟩ := par2_facts hX.z2 (by omega) hr
  have hd1 : 0 < d1 := by omega
  have hd1e : entry M 1 (r + L) = entry M 1 r + d1 := by omega
  have hgx : TRIO.le1 M r (r + L) := by
    obtain ⟨_, _, _, _, hle, _⟩ := (par2_iff M (show r + L < M.length by omega)).mp hr
    exact hle
  have hlen2 : 2 ≤ M.length := by omega
  have hzT : ¬ (TRIO.entry M 0 (M.length - 1) = 0 ∧ TRIO.entry M 1 (M.length - 1) = 0 ∧
      TRIO.entry M 2 (M.length - 1) = 0) := fun h => hz ((col_zero_iff M _).mpr h)
  have hexp : ∀ m, expand M m = TRIO.gexp M r L d0 d1 m := by
    intro m
    have h := expand_eq_gexp M m hlen2 hzT (by rw [h2, show M.length - 1 = r + L by omega]; exact hr)
    rw [h2, show M.length - 1 = r + L by omega] at h
    simp only [show (0 < 2) from by omega, show (1 < 2) from by omega, if_true,
      Nat.add_sub_cancel_left] at h
    exact h
  have hlN : N.length = r + n * L := TRIO.gexp_length hlen
  have hlP : P.length = r + (n - 1) * L := TRIO.gexp_length hlen
  have hnL2 : 2 * L ≤ n * L := Nat.mul_le_mul_right L hn
  have hn1L : L ≤ (n - 1) * L := Nat.le_mul_of_pos_left L (by omega)
  have hxN : r + L < N.length := by omega
  have hrP : r < P.length := by omega
  have hrN : r < N.length := by omega
  have hUN : UAT N := by rw [hN, ← hexp n]; exact (sInvX_expand hX n).toSInv.uat
  have hxbr : col M (r + L) ≠ bump M r := fun h => by
    have := e1_of_col (show col M (r + L) = (entry M 0 r + 1, entry M 1 r, 1) from h); omega
  have hrb : ∀ p, par M 0 r = some p → col M r ≠ bump M p := fun p _ h => by
    have := e2_of_col (show col M r = (entry M 0 p + 1, entry M 1 p, 1) from h); omega
  have hT : N.take (r + L) = M.take (r + L) := gexp_take_x hlen (by omega)
  have hIU : ∀ c, c < r + L → topped M c = true → isUpg N c = isUpg M c := by
    intro c hc htM
    apply isUpg_topped_take (by omega) (by omega) hT I.uat hUN hc _ htM
    rw [topped_N2 (d1 := d1) hlen hL0 hq hd0e hn hXu hxbr he2r hc]
    exact htM
  have hxcN : Counted N r (r + L) := by
    have hx2 := (entry_xprime (d1 := d1) hlen hL0 hq hd0e (by omega) hn).1
    rw [← hN] at hx2
    refine ⟨fun h => ?_, fun ⟨hiu, _⟩ => ?_⟩
    · have := e2_of_col (show col _ (r + L) = (_, _, 1) from h); omega
    · unfold isUpg at hiu
      obtain ⟨k0, _, hk0⟩ := List.any_eq_true.mp hiu
      have := upg_target_e2 (of_decide_eq_true hk0); omega
  have hCLN : CL N r = Lc ++ [r + L] := by
    rw [CL_N2 hlen hL0 hq hd0e hn hXu hxbr he2r hIU hxcN hrx, hCLM]
  -- `D = DepS M {o(r)}` misses the counted children of `r` and `v(r)`
  have hoff := t2_off hlen hL0 hq hd0e hn hXu hxbr hrb he2r hIU I.cons hCN hRN
  have hnoD : ∀ b i, DepS M (fun b i => b = true ∧ i = r) b i → i < M.length → rk true r ≤ rk b i := by
    intro b i hD hi
    obtain ⟨b', i', ⟨rfl, rfl⟩, hle⟩ := depS_rk_ex I.rank hD hi
    exact hle
  have hrM : r < M.length := by omega
  have hvr : σ.v r = ρ.v r := (hoff r hrx).2 (fun hD => by
    have h1 := hnoD false r hD hrM
    have h2' := (I.rank r hrM).1
    omega)
  have hLc : ∀ d ∈ Lc, d < r + L ∧ σ.o d = ρ.o d := by
    intro d hd
    have hdCL : d ∈ CL M r := by rw [hCLM]; simp [hd]
    have hdc := cl_mem_children hdCL
    have hcnt : Counted M r d := by simpa using (List.mem_filter.mp hdCL).2
    have hdx : d < r + L := by
      have hsort := cl_sorted M r
      rw [hCLM] at hsort
      exact (List.pairwise_append.mp hsort).2.2 d hd (r + L) (by simp)
    refine ⟨hdx, (hoff d hdx).1 (fun hD => ?_)⟩
    have h1 := hnoD true d hD (by omega)
    have h2' := (I.rank r hrM).2.1 d hdc hcnt.1 hcnt.2
    omega
  exact ⟨hCLN, hvr, fun d hd => (hLc d hd).2⟩

theorem qn_frame_preV3 {M : Mat} {ρ : Valn} {rk : Bool → Nat → Nat}
    (hM : Std M) (hS : M ≠ SRO) (I : Inv3W M ρ rk)
    (hz : col M (M.length - 1) ≠ (0, 0, 0)) (h2 : TRIO.srow M (M.length - 1) = 2)
    {r L q : Nat} (hlen : r + L + 1 = M.length) (hr : par M 2 (r + L) = some r)
    (hq : par M 0 (r + L) = some q) (hqr : q ≠ r)
    {Lc : List Nat} (hCLM : CL M r = Lc ++ [q])
    {n : Nat} (hn : 2 ≤ n) {σ : Valn} {rkN : Bool → Nat → Nat}
    (hCN : Cons (TRIO.gexp M r L (entry M 0 (r + L) - entry M 0 r) (entry M 1 (r + L) - entry M 1 r) n) σ)
    (hRN : Rk (TRIO.gexp M r L (entry M 0 (r + L) - entry M 0 r) (entry M 1 (r + L) - entry M 1 r) n) rkN)
    :
    CL (TRIO.gexp M r L (entry M 0 (r + L) - entry M 0 r) (entry M 1 (r + L) - entry M 1 r) n) r = Lc ++ [q] ∧ (∀ d ∈ Lc, σ.o d = ρ.o d) ∧ σ.v r = ρ.v r := by
  obtain ⟨hX, hJ⟩ := sInvXJ_std hM hS
  have hqcl : q ∈ CL M r := by rw [hCLM]; simp
  have hqc := cl_mem_children hqcl
  have hpq : par M 0 q = some r := (mem_children_iff.mp hqc).2
  have hrq : r < q := par_lt M 0 _ _ hpq
  obtain ⟨qp, rfl⟩ : ∃ qp, q = r + qp := ⟨q - r, by omega⟩
  set d0 := entry M 0 (r + L) - entry M 0 r with hd0def
  set d1 := entry M 1 (r + L) - entry M 1 r with hd1def
  set N := TRIO.gexp M r L d0 d1 n with hN
  set P := TRIO.gexp M r L d0 d1 (n - 1) with hP
  have hqcnt : Counted M r (r + qp) := by simpa using (List.mem_filter.mp hqcl).2
  have hqx : r + qp < r + L := par_lt M 0 _ _ hq
  have hqp : qp < L := by omega
  have hL0 : 0 < L := by omega
  have hA : Anc0 M r (r + L) := anc0_of_par M 2 r (r + L) hr
  have he0lt := anc0_e0_lt hA (by omega)
  have hd0e : entry M 0 (r + L) = entry M 0 r + d0 := by omega
  have hd0 : 0 < d0 := by omega
  obtain ⟨he2r, h1lt⟩ := par2_facts hX.z2 (by omega) hr
  have hd1 : 0 < d1 := by omega
  have hd1e : entry M 1 (r + L) = entry M 1 r + d1 := by omega
  have hgx : TRIO.le1 M r (r + L) := by
    obtain ⟨_, _, _, _, hle, _⟩ := (par2_iff M (show r + L < M.length by omega)).mp hr
    exact hle
  have hr1 : par M 1 (r + L) = some r := par1_x_r (by omega) I.z2 I.z1 hr
  obtain ⟨Txb, Tqb, _, Tclq, _⟩ := t2_qn_struct hX hJ hlen hr hq (by omega) hpq
  have hqb : ∀ i, par M 0 (r + qp) = some i → col M (r + qp) ≠ bump M i := by
    intro i hi; rw [hpq] at hi; cases hi; exact Tqb
  have hlN : N.length = r + n * L := TRIO.gexp_length hlen
  have hlP : P.length = r + (n - 1) * L := TRIO.gexp_length hlen
  have hnL2 : 2 * L ≤ n * L := Nat.mul_le_mul_right L hn
  have hn1L : L ≤ (n - 1) * L := Nat.le_mul_of_pos_left L (by omega)
  have hm1 : 1 ≤ n := by omega
  have hxN : r + L < N.length := by omega
  have hrP : r < P.length := by omega
  have hrN : r < N.length := by omega
  have hqN : r + qp < N.length := by omega
  have hrM : r < M.length := by omega
  have hqM : r + qp < M.length := by omega
  have hlen2 : 2 ≤ M.length := by omega
  have hzT : ¬ (TRIO.entry M 0 (M.length - 1) = 0 ∧ TRIO.entry M 1 (M.length - 1) = 0 ∧
      TRIO.entry M 2 (M.length - 1) = 0) := fun h => hz ((col_zero_iff M _).mpr h)
  have hexp : ∀ m, expand M m = TRIO.gexp M r L d0 d1 m := by
    intro m
    have h := expand_eq_gexp M m hlen2 hzT (by rw [h2, show M.length - 1 = r + L by omega]; exact hr)
    rw [h2, show M.length - 1 = r + L by omega] at h
    simp only [show (0 < 2) from by omega, show (1 < 2) from by omega, if_true,
      Nat.add_sub_cancel_left] at h
    exact h
  have hUN : UAT N := by rw [hN, ← hexp n]; exact (sInvX_expand hX n).toSInv.uat
  have hT : N.take (r + L) = M.take (r + L) := gexp_take_x hlen (by omega)
  have hcolN : ∀ i, i < r + L → col N i = col M i := fun i hi => col_gexp_pre hlen hm1 hi
  have hbN : ∀ c, c < r + L → bump N c = bump M c := fun c hc => by
    unfold bump; rw [entry_gexp_pre hlen hm1 0 hc, entry_gexp_pre hlen hm1 1 hc]
  have hchN : ∀ i, i < r + L → children N i = children M i :=
    fun i hi => children_N2Q hlen hL0 hA hq hqp hd0e (by omega) hn hi
  have hIUt : ∀ c, c < r + L → c ≠ r + qp → topped M c = true → isUpg N c = isUpg M c := by
    intro c hc hcq htM
    apply isUpg_topped_take (by omega) (by omega) hT I.uat hUN hc _ htM
    rw [topped_eq_of (hchN c hc) (fun d hd => hcolN d (by
      have := (mem_children hd).2
      by_contra h'
      have hdx : d = r + L := by omega
      have := (mem_children_iff.mp hd).2; rw [hdx, hq] at this; exact hcq (Option.some.inj this).symm))
      (hbN c hc)]
    exact htM
  have hcntN : ∀ i c, i < r + L → c < r + L → c ≠ r + qp → (Counted N i c ↔ Counted M i c) :=
    fun i c hi hc hcq => counted_NQ hlen hL0 hA hq hqp hd0e hn Txb hIUt hi hc hcq
  -- `x′` counts at `q`, `q` counts at `r`
  have hx2N : entry N 2 (r + L) = 0 := by
    rw [(entry_xprimeQ hlen hL0 hA hq hqp hd0e (by omega) hn).1, he2r]
  have hxcnt : Counted N (r + qp) (r + L) := by
    refine ⟨fun h => ?_, fun ⟨hiu, _⟩ => ?_⟩
    · have := e2_of_col (show col N (r + L) = (entry N 0 (r + qp) + 1, entry N 1 (r + qp), 1) from h); omega
    · unfold isUpg at hiu
      obtain ⟨k0, _, hk0⟩ := List.any_eq_true.mp hiu
      have := upg_target_e2 (of_decide_eq_true hk0); omega
  have hxq : r + L ∈ children M (r + qp) := mem_children_iff.mpr ⟨by omega, hq⟩
  have hsplitq := children_split_x hlen hxq
  have hCLNq : CL N (r + qp) = [r + L] := by
    unfold CL
    rw [hchN _ hqx, hsplitq, List.filter_append]
    have h1 : List.filter (fun c => decide (Counted N (r + qp) c))
        (List.filter (fun d => decide (d < r + L)) (children M (r + qp))) = [] := by
      rw [List.filter_eq_nil_iff]
      intro c hc hcn
      have hc' := List.mem_filter.mp hc
      have hcx : c < r + L := by simpa using hc'.2
      have hcq : c ≠ r + qp := by have := (mem_children hc'.1).1; omega
      have hcntM : Counted M (r + qp) c := (hcntN _ c hqx hcx hcq).mp (by simpa using hcn)
      have hin : c ∈ CL M (r + qp) := by unfold CL; exact List.mem_filter.mpr ⟨hc'.1, by simpa using hcntM⟩
      rw [Tclq] at hin; simp at hin
    rw [h1]; simp [hxcnt]
  have hqcntN : Counted N r (r + qp) := by
    refine ⟨by rw [hcolN _ hqx, hbN r (by omega)]; exact hqcnt.1, fun ⟨_, ht⟩ => ?_⟩
    unfold topped at ht
    rw [hchN _ hqx, hsplitq] at ht
    simp at ht
    exact hxcnt.1 ht
  have hCLN : CL N r = Lc ++ [r + qp] := by
    rw [← hCLM]; unfold CL
    rw [hchN r (by omega)]
    apply List.filter_congr
    intro c hc
    by_cases hcq : c = r + qp
    · rw [hcq]; simp [hqcntN, hqcnt]
    · have hcx : c < r + L := by
        have hcl := (mem_children hc).2
        by_contra h'
        have hcx' : c = r + L := by omega
        rw [hcx'] at hc
        have := (mem_children_iff.mp hc).2; rw [hq] at this
        have := Option.some.inj this; omega
      simp only [decide_eq_decide]
      exact hcntN r c (by omega) hcx hcq
  -- `N` agrees with `M` outside `D = DepS M {v(q), o(r)}`
  have hnu : upg M (r + L - 1) ≠ some (r + L) := fun h =>
    upg_not_x hlen hA hq Txb I.be h (le_refl _) (by omega)
  have hupgN : ∀ i, i < r + L → upg N i = upg M i := fun i hi =>
    upg_NQ hlen hL0 hA hq hqp hd0e hn he2r hnu hi
  have hxc : ∀ i c, c ∈ children M i → r + L ≤ c → c = r + L ∧ i = r + qp := by
    intro i c hc hcx
    have := (mem_children hc).2
    have hcx' : c = r + L := by omega
    refine ⟨hcx', ?_⟩
    have h' := (mem_children_iff.mp hc).2; rw [hcx', hq] at h'; exact (Option.some.inj h').symm
  have hbjN : ∀ i j, i < r + L → j ∈ children N i → r + L ≤ j → col N j ≠ bump N i := by
    intro i j hi hj hjx hb
    have hjl := (mem_children hj).2
    rw [hlN] at hjl
    rcases par0_tail2Q hlen hL0 hA hq hqp hd0e (by omega) hjx hjl with ⟨hjx', _⟩ | ⟨p', hp', hp'1, _⟩
    · rw [hjx'] at hb
      have := e2_of_col (show col N (r + L) = (entry N 0 i + 1, entry N 1 i, 1) from hb)
      omega
    · rw [(mem_children_iff.mp hj).2] at hp'; cases hp'; omega
  have hoff := t2_off_gen (S := SQ (r + qp) r) (bnd := r + L) I.cons hCN hRN (by omega) (by rw [hlN]; omega)
    (fun i hi _ => hchN i hi) (DepS.ov (DepS.seed (Or.inl ⟨rfl, rfl⟩)))
    (Or.inr (DepS.seed (Or.inl ⟨rfl, rfl⟩)))
    (fun i hqi hb => by have h' := (mem_children_iff.mp hqi).2; rw [hpq] at h'; cases h'; exact Tqb hb)
    (fun y i hi => entry_gexp_pre hlen (by omega) y hi) (fun i hi => par_gexp_pre hlen (by omega) 1 hi)
    (fun i hi _ => hupgN i hi)
    (fun i c hi hd hc hcx => hcntN i c hi hcx (by
      intro hcq; apply hd; apply DepS.seed; right; refine ⟨rfl, ?_⟩
      have h' := (mem_children_iff.mp hc).2; rw [hcq, hpq] at h'; exact (Option.some.inj h').symm))
    (fun i c hi hc hcx => by
      obtain ⟨_, rfl⟩ := hxc i c hc hcx
      exact DepS.ov (DepS.seed (Or.inl ⟨rfl, rfl⟩)))
    (fun i k hi hk hkx => (upg_not_x hlen hA hq Txb I.be hk hkx hi).elim)
    hbjN
    (fun i j hi hj hjx _ => by
      obtain ⟨_, rfl⟩ := hxc i j hj hjx
      exact DepS.seed (Or.inl ⟨rfl, rfl⟩))
    (fun i j k hi hj hjx hjb hk hkx => by
      obtain ⟨_, rfl⟩ := hxc j k hk hkx
      have h' := (mem_children_iff.mp hj).2; rw [hpq] at h'; cases h'
      exact absurd hjb Tqb)
  have htq : topped M (r + qp) = true := by
    unfold topped; rw [hsplitq]; simp [Txb]
  have hinv : ∀ {b i}, DepS M (SQ (r + qp) r) b i → i < M.length → Anc0 M (r + qp) i ∨ rk true r ≤ rk b i :=
    fun h hi => depS_SQ_inv I.rank hpq Tqb hqcnt.2 htq he2r h hi
  have hvr : σ.v r = ρ.v r := (hoff r (by omega)).2 (fun hD => by
    rcases hinv hD hrM with hAq | hle
    · have := hAq.le; omega
    · have := (I.rank r hrM).1; omega)
  have hLc : ∀ d ∈ Lc, σ.o d = ρ.o d := by
    intro d hd
    have hdCL : d ∈ CL M r := by rw [hCLM]; simp [hd]
    have hdc := cl_mem_children hdCL
    have hcnt : Counted M r d := by simpa using (List.mem_filter.mp hdCL).2
    have hdq : d < r + qp := by
      have hsort := cl_sorted M r
      rw [hCLM] at hsort
      exact (List.pairwise_append.mp hsort).2.2 d hd (r + qp) (by simp)
    refine (hoff d (by omega)).1 (fun hD => ?_)
    rcases hinv hD (by omega) with hAq | hle
    · have := hAq.le; omega
    · have := (I.rank r hrM).2.1 d hdc hcnt.1 hcnt.2; omega
  exact ⟨hCLN, hLc, hvr⟩

theorem t2SeedPreShape_ofV3 {M : Mat} {ρ : Valn} {rk : Bool → Nat → Nat}
    (hM : Std M) (hS : M ≠ SRO) (I : Inv3W M ρ rk)
    (hz : col M (M.length - 1) ≠ (0, 0, 0)) (h2 : TRIO.srow M (M.length - 1) = 2)
    (hSVC : T2SeedPreShapeSVC M ρ) : T2SeedPreShape M ρ := by
  intro r L hlen hr n hn σ hCN hGN p hp Lc c Rl hCL hcx hcq s y hsy ht
  obtain ⟨hX, hJ⟩ := sInvXJ_std hM hS
  have hlen2 : 2 ≤ M.length := by have := par_lt M 2 _ _ hr; omega
  have hzT : ¬ (TRIO.entry M 0 (M.length - 1) = 0 ∧ TRIO.entry M 1 (M.length - 1) = 0 ∧
      TRIO.entry M 2 (M.length - 1) = 0) := fun h => hz ((col_zero_iff M _).mpr h)
  have hexp : expand M n = TRIO.gexp M r L (entry M 0 (r + L) - entry M 0 r) (entry M 1 (r + L) - entry M 1 r) n := by
    have h := expand_eq_gexp M n hlen2 hzT (by rw [h2, show M.length - 1 = r + L by omega]; exact hr)
    rw [h2, show M.length - 1 = r + L by omega] at h
    simp only [show (0 < 2) from by omega, show (1 < 2) from by omega, if_true,
      Nat.add_sub_cancel_left] at h
    exact h
  obtain ⟨rkN, hRN⟩ : ∃ rk', Rk (TRIO.gexp M r L (entry M 0 (r + L) - entry M 0 r) (entry M 1 (r + L) - entry M 1 r) n) rk' := by
    obtain ⟨rk', h'⟩ := rk_expand_t2 hX hJ hz h2 I.rank n (by omega)
    rw [hexp] at h'; exact ⟨rk', h'⟩
  have hpr : p = r := by
    rcases hp with ⟨_, h⟩ | ⟨q, hq, hqr, hpq⟩
    · exact h
    · rw [par0_q_t2 hM hS I hlen hr hq hqr] at hpq; cases hpq; rfl
  rcases t2_seed_cases hlen hr with hc | hc | hc | hc
  · obtain ⟨hq, hXu⟩ := hc
    obtain ⟨_, h1lt⟩ := par2_facts I.z2 (by omega) hr
    have hxb : col M (r + L) ≠ bump M r := fun h => by
      have := e1_of_col (show col M (r + L) = (entry M 0 r + 1, entry M 1 r, 1) from h); omega
    obtain ⟨Lc0, hCLM⟩ := cl_r_split hlen hq hXu hxb
    obtain ⟨hCLN, hvr, hLc⟩ := qr_frame_preV3 hM hS I hz h2 hlen hr hq hXu hCLM hn hCN hRN
    rw [hpr] at ht hCL ⊢
    exact frame_of_prefix hCLM hCLN hvr hLc hCL (by omega) hsy ht
  · obtain ⟨q, Lc0, hq, hqr, hCLM⟩ := hc
    obtain ⟨hCLN, hLc, hvr⟩ := qn_frame_preV3 hM hS I hz h2 hlen hr hq hqr hCLM hn hCN hRN
    rw [hpr] at ht hCL ⊢
    exact frame_of_prefix hCLM hCLN hvr hLc hCL (hcq q hq) hsy ht
  · exact hSVC r L hlen hr (Or.inl hc) n hn σ hCN hGN p hp Lc c Rl hCL hcx hcq s y hsy ht
  · exact hSVC r L hlen hr (Or.inr hc) n hn σ hCN hGN p hp Lc c Rl hCL hcx hcq s y hsy ht

/-- `t = 2` matrices have at least two columns. -/
theorem len2_of_t2 {M : Mat} {ρ : Valn} {rk : Bool → Nat → Nat} (Ctx : StepCtx3 M ρ rk)
    (hz : col M (M.length - 1) ≠ (0, 0, 0)) (h2 : TRIO.srow M (M.length - 1) = 2) : 2 ≤ M.length := by
  obtain ⟨r, hr⟩ := parLast_of Ctx.S.e00 Ctx.S.r01 Ctx.S.r12 hz
  rw [h2] at hr
  have := par_lt M 2 _ r hr
  omega

/-- `sv_children_ctx` (V3T2SeedRes) on the V3 context: `Good3` of `M.take x` from `DropV3`. -/
theorem sv_children_ctxV3 {M : Mat} {ρ : Valn} {rk : Bool → Nat → Nat} (hM : Std M) (hS : M ≠ SRO)
    (I : Inv3W M ρ rk) (Ctx : StepCtx3 M ρ rk)
    {r L : Nat} (hlen : r + L + 1 = M.length) (hr : par M 2 (r + L) = some r)
    (hq : par M 0 (r + L) = some r) (hux : upg M (r + L - 1) = some (r + L))
    {τ : Valn} (hτ : Cons (M.take (r + L)) τ) :
    Good3 (M.take (r + L)) τ ∧ τ.v r = ρ.v r ∧
      ∀ d ∈ children (M.take (r + L)) r, succ (ρ.v r) < τ.v d := by
  obtain ⟨hX, _⟩ := sInvXJ_std hM hS
  have hxM : r + L < M.length := by omega
  have hrx : r < r + L := par_lt M 0 _ _ hq
  obtain ⟨he2r, he1x⟩ := par2_facts I.z2 hxM hr
  have he2x : entry M 2 (r + L) = 1 := by
    obtain ⟨_, _, _, he2, _, _⟩ := (par2_iff M hxM).mp hr
    have h' : entry M 2 r < entry M 2 (r + L) := he2
    have := I.z2 (r + L); omega
  have hτ' : Cons (M.take (M.length - 1)) τ := by rw [show M.length - 1 = r + L by omega]; exact hτ
  have hG := good3_take_anyV3U I (Ctx.drop (by omega)) (by omega) hτ'
  rw [show M.length - 1 = r + L by omega] at hG
  have hvr : τ.v r = ρ.v r :=
    v_take_of_untopped I (by omega) hrx (topP_sv hlen I.z2 I.z1 hr hq hux) hτ
  refine ⟨hG, hvr, fun c0 hc0 => ?_⟩
  have hc0x : c0 < r + L := by have := (mem_children hc0).2; rw [List.length_take] at this; omega
  have hpc : par M 0 c0 = some r := by
    have := (mem_children_iff.mp hc0).2; rwa [par_take M 0 c0 hc0x] at this
  have hcM : c0 ∈ children M r := mem_children_iff.mpr ⟨by omega, hpc⟩
  have hcol := t_child_col hX hq hxM he2x he1x hcM (le_of_lt hc0x)
  have hcx := t_col_x hX hq hxM he2x he1x
  have h1 : entry M 1 c0 = entry M 1 r + 1 := by
    have : entry M 1 c0 = (col M c0).2.1 := rfl; rw [this, hcol, hcx]
  have h2 : entry M 2 c0 = 1 := by
    have : entry M 2 c0 = (col M c0).2.2 := rfl; rw [this, hcol, hcx]
  have hp1 : par (M.take (r + L)) 1 c0 = some r := by
    rw [par_take M 1 c0 hc0x]; exact par1_of_child hpc (by omega)
  have hlt := v_child_gt hτ hG (by rw [List.length_take]; omega) (by rw [List.length_take]; omega) hp1
    (by rw [entry_take M 1 hc0x]; omega) (by rw [entry_take M 2 hc0x]; exact h2)
  rwa [hvr] at hlt

/-- `t2SVc0'_of_drop` (V3T2VRASV) on the V3 context: the PO of `DropV3`. -/
theorem t2SVc0'_of_dropV3 {M : Mat} {ρ : Valn} {rk : Bool → Nat → Nat}
    (I : Inv3W M ρ rk) (Ctx : StepCtx3 M ρ rk)
    {r L : Nat} (hlen : r + L + 1 = M.length) (hr : par M 2 (r + L) = some r) :
    T2SVc0' M ρ r L := by
  intro τ hτ Lc0 c0 hT s y hsy hy
  have IW := I
  have hrx : r < r + L := par_lt M 2 _ _ hr
  have hD := (Ctx.drop (by omega)).1
  have hx : M.length - 1 = r + L := by omega
  rw [hx] at hD
  have hcnt := counted_take_last (M := M) (by omega) IW.r0p IW.z2 IW.sd IW.z1 IW.uat
  rw [hx] at hcnt
  have hRk1 : Rk (M.take (r + L)) rk := rk_take (by omega) IW.rank hcnt
  have hC1 : Cons (M.take (r + L)) (drop1 M (r + L) rk) := cons_of_rk hRk1
  have hc0m : c0 ∈ CL (M.take (r + L)) r := by rw [hT]; simp
  have hc0 := List.mem_filter.mp hc0m
  have hc0T : c0 < (M.take (r + L)).length := (mem_children hc0.1).2
  have hc0x : c0 < r + L := by rw [List.length_take] at hc0T; omega
  have hag := agree_of_cons hτ hC1 hRk1 c0 hc0T
  have hPO := (hD c0 hc0x).1.1
  -- `τ` on `M.take x` is good
  have hτ' : Cons (M.take (M.length - 1)) τ := by rw [hx]; exact hτ
  have hG := good3_take_anyV3U IW (Ctx.drop (by omega)) (by omega) hτ'
  rw [hx] at hG
  -- `v(c₀)` does not change
  have hnch : ¬ ChgX M (r + L) false c0 := by
    intro hch
    have hTop := (chg_struct hlen IW.r0p IW.z2 IW.sd IW.z1 IW.uat IW.uab hch).1 rfl hc0x
    have hCLe : CL (M.take (r + L)) c0 = [] := by
      unfold CL; rw [List.filter_eq_nil_iff]
      intro d hd hdc; exact hTop.2.1 d hd (by simpa using hdc)
    have ho := o_spArg hτ hG hc0T
    rw [cvals_eq_map hτ hG, hCLe, hsy] at ho
    simp only [psi.injEq] at ho
    exact hy (by rw [ho.2.1]; rfl)
  have hv := (chg_off hlen IW.cons IW.good hC1 hRk1 c0 hc0x).2 hnch
  -- the subscript of `o_{M.take x}(c₀)` is `v(c₀)`
  have hoT := o_spArg hτ hG hc0T
  rw [hsy] at hoT
  simp only [psi.injEq] at hoT
  have hs : s = ρ.v c0 := by rw [hoT.1, hag.2, hv]
  obtain ⟨Xm, hXm⟩ := o_arg_form IW (show c0 < M.length by omega)
  refine ⟨Xm, by rw [hXm, hs], ?_⟩
  have hle := LhdE.le (show LhdE ((drop1 M (r + L) rk).o c0) (ρ.o c0) from ?_)
  · rw [← hag.1, hsy, hXm, ← hs] at hle
    rcases (le_iff _ _).mp hle with h | h
    · rcases psi_lt_psi_z_iff.mp h with h' | ⟨_, h'⟩
      · exact absurd h' (lt_irrefl' _)
      · exact le_of_lt h'
    · simp only [psi.injEq] at h; rw [h.2.1]
  · rcases hPO with h | ⟨⟨w', w, X, h1, _, _⟩, _⟩
    · exact h
    · rw [← hag.1, hsy] at h1; simp only [psi.injEq] at h1; exact absurd h1.2.1 hy

/-- **The sv residual `T2SVc0`** on the V3 context: no residual. -/
theorem t2SVc0_ofV3 {M : Mat} {ρ : Valn} {rk : Bool → Nat → Nat}
    (I : Inv3W M ρ rk) (Ctx : StepCtx3 M ρ rk)
    {r L : Nat} (hlen : r + L + 1 = M.length) (hr : par M 2 (r + L) = some r) : T2SVc0 M ρ r L :=
  t2SVc0_of I hlen (t2SVc0'_of_dropV3 I Ctx hlen hr)

theorem t2SeedPreShapeSVC_ofV3U {M : Mat} {ρ : Valn} {rk : Bool → Nat → Nat} (hB : T2BelowAtV3U M ρ)
    (hM : Std M) (hS : M ≠ SRO) (I : Inv3W M ρ rk) (Ctx : StepCtx3 M ρ rk)
    (hz : col M (M.length - 1) ≠ (0, 0, 0)) (h2 : TRIO.srow M (M.length - 1) = 2)
    (hc0 : ∀ r L, r + L + 1 = M.length → par M 2 (r + L) = some r → T2SVCase M r L → T2SVc0 M ρ r L)
    (hC : T2SeedPreShapeC M ρ) : T2SeedPreShapeSVC M ρ := by
  obtain ⟨hX, hJ⟩ := sInvXJ_std hM hS
  have hGall := good3_expand_t2V3 hM hS I (Ctx.drop (len2_of_t2 Ctx hz h2)) hz h2
    (t2BelowXE_V3U hB hM hS I (Ctx.drop (len2_of_t2 Ctx hz h2)) hz h2) (t2CopyResV3 hM hS I hz h2)
  intro r L hlen hr hcase n hn σ hCN hGN p hp Lc c R' hCL hcx hcq s y hsy ht
  rcases hcase with ⟨hq, hux⟩ | hCc
  swap
  · exact hC r L hlen hr hCc n hn σ hCN hGN p hp Lc c R' hCL hcx hcq s y hsy ht
  have hpr : p = r := by
    rcases hp with ⟨_, h⟩ | ⟨q, hq', hqr, _⟩
    · exact h
    · rw [hq] at hq'; cases hq'; exact absurd rfl hqr
  subst hpr
  have hx : M.length - 1 = p + L := by omega
  have hlen2 : 2 ≤ M.length := by omega
  have hzT : ¬ (TRIO.entry M 0 (M.length - 1) = 0 ∧ TRIO.entry M 1 (M.length - 1) = 0 ∧
      TRIO.entry M 2 (M.length - 1) = 0) := fun h => hz ((col_zero_iff M _).mpr h)
  have hexp : ∀ m, expand M m = G2 M p L m := by
    intro m
    have h := expand_eq_gexp M m hlen2 hzT (by rw [h2, hx]; exact hr)
    rw [h2, hx] at h
    simp only [show (0 < 2) from by omega, show (1 < 2) from by omega, if_true,
      Nat.add_sub_cancel_left] at h
    exact h
  have hGlow : ∀ m, 1 ≤ m → m < n → ∀ τ, Cons (G2 M p L m) τ → Good3 (G2 M p L m) τ :=
    fun m hm _ τ hτ => by rw [← hexp m] at hτ ⊢; exact hGall m hm τ hτ
  have hRk : ∀ m, 1 ≤ m → ∃ rk', Rk (G2 M p L m) rk' := fun m hm => by
    obtain ⟨rk', h'⟩ := rk_expand_t2 hX hJ hz h2 I.rank m hm
    rw [hexp m] at h'; exact ⟨rk', h'⟩
  have hcnt := counted_take_last (M := M) (by omega) I.r0p I.z2 I.sd I.z1 I.uat
  rw [hx] at hcnt
  have hRk1 : Rk (M.take (p + L)) rk := rk_take (by omega) I.rank hcnt
  have hC0 := cons_of_rk hRk1
  obtain ⟨hG0, hv0, _⟩ := sv_children_ctxV3 hM hS I Ctx hlen hr hq hux hC0
  obtain ⟨rkN, hRN⟩ := hRk n (by omega)
  obtain ⟨rkP, hRP⟩ := hRk (n - 1) (by omega)
  have hCP := cons_of_rk hRP
  have hGP := hGlow (n - 1) (by omega) (by omega) _ hCP
  obtain ⟨hCLN, hσT, hσv, _, _⟩ := sv_frameV3 hM hS I Ctx hz h2 hlen hr hq hux (topP_sv hlen I.z2 I.z1 hr hq hux)
    hn hCN hRN hCP hGP hRP hC0 hG0 hRk1
  have hvr : σ.v p = ρ.v p := by rw [hσv, hv0]
  have hCLM := cl_sv I hlen hq hux
  rw [hCLN] at hCL
  have hR : R' ≠ [] := by
    rintro rfl
    obtain ⟨_, h2'⟩ := List.append_inj' hCL rfl
    simp only [List.cons.injEq, and_true] at h2'
    omega
  have h1 : CL (M.take (p + L)) p = Lc ++ c :: R'.dropLast := by
    have := congrArg List.dropLast hCL
    rw [List.dropLast_concat, List.dropLast_append_of_ne_nil (by simp), List.dropLast_cons_of_ne_nil hR] at this
    exact this
  rcases List.eq_nil_or_concat (CL (M.take (p + L)) p) with hT | ⟨Lc0, c0, hT0⟩
  · rw [hT] at h1; simp at h1
  have hT : CL (M.take (p + L)) p = Lc0 ++ [c0] := by rw [hT0, List.concat_eq_append]
  obtain ⟨hLc0, hc0'⟩ := hc0 p L hlen hr ⟨hq, hux⟩ _ hC0 Lc0 c0 hT
  have hσρ : ∀ d ∈ Lc0, σ.o d = ρ.o d := fun d hd => by
    rw [hσT d (by rw [hT]; exact List.mem_append_left _ hd)]; exact hLc0 d hd
  rw [hT] at h1
  by_cases hR2 : R'.dropLast = []
  · rw [hR2] at h1
    obtain ⟨h3, h4⟩ := List.append_inj' h1 rfl
    simp only [List.cons.injEq, and_true] at h4
    subst h3; subst h4
    have hLm : Lc0.map ρ.o = Lc0.map σ.o := List.map_congr_left (fun d hd => (hσρ d hd).symm)
    have hy : y ≠ z := fun h0 => by rw [h0] at ht; exact T.not_lt_z _ ht.1
    obtain ⟨yM, hyM, hyy⟩ := hc0' s y (by rw [← hσT c0 (by rw [hT]; simp)]; exact hsy) hy
    have hpp : psi s y z ≤ psi s yM z := by
      rcases (le_iff _ _).mp hyy with h5 | h5
      · exact psi_le_psi_of (Or.inr ⟨rfl, Or.inl h5⟩)
      · exact psi_le_psi_of (Or.inr ⟨rfl, Or.inr ⟨h5, le_refl _⟩⟩)
    refine ⟨Lc0, [], yM, by rw [hCLM, hT], hvr, hLm, hyM, hyy, ?_⟩
    rw [hLm, ← hvr]
    exact ⟨lt_of_lt_of_le ht.1 hyy, lt_of_lt_of_le ht.2 hpp⟩
  · have hdl : (Lc ++ c :: R'.dropLast).dropLast = Lc0 := by rw [← h1]; simp
    rw [List.dropLast_append_of_ne_nil (by simp), List.dropLast_cons_of_ne_nil hR2] at hdl
    have hLs : ∀ d ∈ Lc, d ∈ Lc0 := fun d hd => by rw [← hdl]; exact List.mem_append_left _ hd
    have hcs : c ∈ Lc0 := by rw [← hdl]; simp
    have hclM : CL M p = Lc ++ c :: (R'.dropLast.dropLast ++ [c0]) := by rw [hCLM, hT, ← hdl]; simp
    have hLm : Lc.map ρ.o = Lc.map σ.o := List.map_congr_left (fun d hd => (hσρ d (hLs d hd)).symm)
    refine ⟨Lc, _, y, hclM, hvr, hLm, by rw [← hσρ c hcs]; exact hsy, le_refl _, ?_⟩
    rw [hLm, ← hvr]; exact ht

theorem t2VRAPre_ofV3U {M : Mat} {ρ : Valn} {rk : Bool → Nat → Nat} (hB : T2BelowAtV3U M ρ)
    (hM : Std M) (hS : M ≠ SRO) (I : Inv3W M ρ rk) (Ctx : StepCtx3 M ρ rk)
    (hz : col M (M.length - 1) ≠ (0, 0, 0)) (h2 : TRIO.srow M (M.length - 1) = 2)
    (hSP : T2SeedPreShape M ρ) : T2VRAPre M ρ := by
  intro r L hlen hr n hn σ hCN hGN k hk hsc u hu
  have hGall := good3_expand_t2V3 hM hS I (Ctx.drop (len2_of_t2 Ctx hz h2)) hz h2
    (t2BelowXE_V3U hB hM hS I (Ctx.drop (len2_of_t2 Ctx hz h2)) hz h2) (t2CopyResV3 hM hS I hz h2)
  obtain ⟨hX, hJ⟩ := sInvXJ_std hM hS
  have hzT : ¬ (TRIO.entry M 0 (M.length - 1) = 0 ∧ TRIO.entry M 1 (M.length - 1) = 0 ∧
      TRIO.entry M 2 (M.length - 1) = 0) := fun h => hz ((col_zero_iff M _).mpr h)
  have hlen2 : 2 ≤ M.length := by have := par_lt M 2 _ r hr; omega
  have hL : M.length - 1 = r + L := by omega
  have hexp : ∀ m, expand M m = G2 M r L m := by
    intro m
    have h := expand_eq_gexp M m hlen2 hzT (by rw [h2]; rw [hL]; exact hr)
    rw [h2, hL] at h
    simp only [show (0 < 2) from by omega, show (1 < 2) from by omega, if_true,
      Nat.add_sub_cancel_left] at h
    exact h
  have hG : ∀ m, 1 ≤ m → ∀ τ, Cons (G2 M r L m) τ → Good3 (G2 M r L m) τ :=
    fun m hm τ hτ => by rw [← hexp m] at hτ ⊢; exact hGall m hm τ hτ
  have hBS := t2BelowXS_V3U hB hM hS I (Ctx.drop (len2_of_t2 Ctx hz h2)) hz h2 hlen hr
  have hshape : ∀ j, j < r + L → ¬ T2SeedCol M r L j → WfAbsW.FrameShapeXU M (G2 M r L n) ρ σ j :=
    fun j hj hsj => (hBS n hn (fun m hm1 _ τ hτ => hG m hm1 τ hτ) σ hCN
      (fun i _ hi => ⟨hGN.ot_o i hi, hGN.ot_v i hi⟩) j hj).2.2.2.1 hsj
  refine pathLvAll_pre_t2XRU I.cons I.good hCN hGN hshape (hSP r L hlen hr n hn σ hCN hGN)
    (fun q hq hqr => q_nocnt_t2 hX hJ hlen hr (by omega) hq hqr) k u hu hk ?_
  intro q hq hqr hkq
  exact hsc (Or.inr ⟨q, hq, hqr, hkq⟩)

/-- **`T2VRAPre` from the C part `T2SeedPreShapeC`** of the seed frame shape (the sv part `T2SVc0` is proved). -/
theorem t2VRAPre_ofC {M : Mat} {ρ : Valn} {rk : Bool → Nat → Nat} (hB : T2BelowAtV3U M ρ)
    (hM : Std M) (hS : M ≠ SRO) (I : Inv3W M ρ rk) (Ctx : StepCtx3 M ρ rk)
    (hz : col M (M.length - 1) ≠ (0, 0, 0)) (h2 : TRIO.srow M (M.length - 1) = 2)
    (hC : T2SeedPreShapeC M ρ) : T2VRAPre M ρ :=
  t2VRAPre_ofV3U hB hM hS I Ctx hz h2 (t2SeedPreShape_ofV3 hM hS I hz h2
    (t2SeedPreShapeSVC_ofV3U hB hM hS I Ctx hz h2 (fun r L hlen hr _ => t2SVc0_ofV3 I Ctx hlen hr) hC))

#print axioms t2VRAPre_ofC


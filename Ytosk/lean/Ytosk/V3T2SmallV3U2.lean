/-
**hN with the weaker copy-level residual `T2VRACopyEsc2` (2026-11-06, generated by tmp/claude/make_small2.py).**

`T2VRACopyEsc` (a residual of `hN_of2`) is false on the graft sets (tmp/claude/measure_hn86.py): at a copy frame of
`M[n]` a component `g` of `s` above `Ω_s` and the state can sit at a level `u > V` that is not a level of `M[n − 1]`.
There `g` is below a component of `v_N(i + L)` (the third alternative of `QVRAt`, as for `KAG`).  `T2VRACopyEsc2` asks the
level provenance only when `g` is above `Ω_s`, the state and every component of `v_N(i + L)`;
`vsmallRAll_expand_t2V3U2` takes the third alternative first.
-/
import Ytosk.V3SeedVFAll2

namespace Ytosk.V3Main
open T Classical WfExQ1 WfT2X WfAbsW G
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

/-- **R-copy (VSmallRAll), weaker**: as `T2VRACopyEsc`, for components not below a component of `v_N(i + L)`. -/
def T2VRACopyEsc2 (M : Mat) : Prop :=
  ∀ r L, r + L + 1 = M.length → par M 2 (r + L) = some r → ∀ n, 2 ≤ n →
    ∀ σ ρP, Cons (G2 M r L n) σ → Good3 (G2 M r L n) σ →
    Cons (G2 M r L (n - 1)) ρP → Good3 (G2 M r L (n - 1)) ρP →
    ∀ i, r ≤ i → i < (G2 M r L (n - 1)).length →
    ∀ (Lc : List Nat) (c : Nat) (R : List Nat), CL (G2 M r L n) (i + L) = Lc ++ c :: R →
    ∀ s y, σ.o c = psi s y z →
    (lt (spArg (σ.v (i + L)) z (sumN (Lc.map σ.o))) y = true ∧ lt (psi (σ.v (i + L)) z z) (psi s y z) = true) →
    (split y (psi (succ s) z z)).1 ≠ z →
    ∀ u, LevAt (G2 M r L n) σ (i + L) u → ¬ lt (σ.v (i + L)) u = true →
    ∀ g ∈ comps u s, psi s z z < g →
      spArg (σ.v (i + L)) z (sumN (Lc.map σ.o)) < g →
      (¬ ∃ d ∈ comps u (σ.v (i + L)), g ≤ d) →
      LevAt (G2 M r L (n - 1)) ρP i u ∧ u ≤ ρP.v r

theorem t2VRACopyEsc2_of {M : Mat} (h : T2VRACopyEsc M) : T2VRACopyEsc2 M :=
  fun r L hlen hr n hn σ ρP hCN hGN hCP hGP i hri hi Lc c R hCL s y hsy ht hhi u hu hku g hg h1 h2 _ =>
    h r L hlen hr n hn σ ρP hCN hGN hCP hGP i hri hi Lc c R hCL s y hsy ht hhi u hu hku g hg h1 h2

theorem vsmallRAll_expand_t2V3U2 {K : T → T → T → List T → T → T → Prop} (hsh : QVRAshK K) {M : Mat} {ρ : Valn} {rk : Bool → Nat → Nat} (hB : T2BelowAtV3U M ρ)
    (hM : Std M) (hS : M ≠ SRO)
    (I : Inv3W M ρ rk) (D : DropV3 M ρ rk) (hz : col M (M.length - 1) ≠ (0, 0, 0))
    (h2 : TRIO.srow M (M.length - 1) = 2) (hVM : VSmallRAll M ρ)
    (hVT : ∀ τ, Cons (M.take (M.length - 1)) τ → VSmallRAll (M.take (M.length - 1)) τ)
    (hSeed : T2VRASeed M) (hPre : T2VRAPre M ρ) (hCopy : T2VRACopyEsc2 M) (hKM : T2VRAK K M) :
    ∀ n, 1 ≤ n → ∀ σ, Cons (expand M n) σ → VSmallRAll (expand M n) σ := by
  have hGall := good3_expand_t2V3 hM hS I D hz h2 (t2BelowXE_V3U hB hM hS I D hz h2)
    (t2CopyResV3 hM hS I hz h2)
  obtain ⟨hX, hJ⟩ := sInvXJ_std hM hS
  obtain ⟨r, hr⟩ := parLast_of hX.e00 hX.r01 hX.r12 hz
  have hzT : ¬ (TRIO.entry M 0 (M.length - 1) = 0 ∧ TRIO.entry M 1 (M.length - 1) = 0 ∧
      TRIO.entry M 2 (M.length - 1) = 0) := fun h => hz ((col_zero_iff M _).mpr h)
  rw [h2] at hr
  have hrx : r < M.length - 1 := par_lt M 2 _ r hr
  have hlen2 : 2 ≤ M.length := by omega
  obtain ⟨L, hL⟩ : ∃ L, M.length - 1 = r + L := ⟨M.length - 1 - r, by omega⟩
  have hlen : r + L + 1 = M.length := by omega
  have hL0 : 0 < L := by omega
  rw [hL] at hr hVT
  have hA : Anc0 M r (r + L) := anc0_of_par M 2 r (r + L) hr
  have he0lt := anc0_e0_lt hA (by omega)
  obtain ⟨he2r, h1lt⟩ := par2_facts hX.z2 (by omega) hr
  have hgx : TRIO.le1 M r (r + L) := by
    obtain ⟨_, _, _, _, hle, _⟩ := (par2_iff M (show r + L < M.length by omega)).mp hr
    exact hle
  have hd0e : entry M 0 (r + L) = entry M 0 r + (entry M 0 (r + L) - entry M 0 r) := by omega
  have hd0 : 0 < entry M 0 (r + L) - entry M 0 r := by omega
  have hd1 : 0 < entry M 1 (r + L) - entry M 1 r := by omega
  have hexp : ∀ n, expand M n = G2 M r L n := by
    intro n
    have h := expand_eq_gexp M n hlen2 hzT (by rw [h2]; rw [hL]; exact hr)
    rw [h2, hL] at h
    simp only [show (0 < 2) from by omega, show (1 < 2) from by omega, if_true,
      Nat.add_sub_cancel_left] at h
    exact h
  have hG : ∀ m, 1 ≤ m → ∀ σ, Cons (G2 M r L m) σ → Good3 (G2 M r L m) σ :=
    fun m hm σ hσ => by rw [← hexp m] at hσ ⊢; exact hGall m hm σ hσ
  have hRk : ∀ m, 1 ≤ m → ∃ rk, Rk (G2 M r L m) rk := fun m hm => by
    obtain ⟨rk', h'⟩ := rk_expand_t2 hX hJ hz h2 I.rank m hm
    rw [hexp m] at h'; exact ⟨rk', h'⟩
  have hBE : ∀ m, 1 ≤ m → BumpE2 (G2 M r L m) := fun m _ => by
    rw [← hexp m]; exact (sInvX_expand hX m).loc.2.2.1
  have hCR := t2CopyResV3 hM hS I hz h2 r L hlen hr
  have hBS := t2BelowXS_V3U hB hM hS I D hz h2 hlen hr
  have hSD := hX.loc.1
  have key : ∀ n, 1 ≤ n → ∀ σ, Cons (G2 M r L n) σ → VSmallRAll (G2 M r L n) σ := by
    intro n hn
    induction n with
    | zero => omega
    | succ m ih =>
      rcases Nat.eq_zero_or_pos m with hm0 | hm0
      · subst hm0
        intro σ hσ
        unfold G2 at hσ ⊢
        rw [gexp_one_gen hlen] at hσ ⊢
        exact hVT σ hσ
      · intro σ hCN
        have hn2 : 2 ≤ m + 1 := by omega
        obtain ⟨rkP, hRP⟩ := hRk m hm0
        set ρP := rhsIt (G2 M r L m) (rkBound (G2 M r L m) rkP) with hρP
        have hCP : Cons (G2 M r L m) ρP := cons_of_rk hRP
        have hGP := hG m hm0 _ hCP
        have hQP := ih hm0 _ hCP
        have hm : m + 1 - 1 = m := by omega
        obtain ⟨hKV, hB', hV', hVV⟩ := hCR (m + 1) hn2 σ _ hCN (by rw [hm]; exact hCP) (by rw [hm]; exact hGP)
        have hK := t2GuardKids_gexp hlen hL0 hA hd0e hn2 hd0 hd1 hgx he2r (by rw [hm]; exact hBE m hm0)
        have hRK := t2RootKids_gexp hlen hL0 hA hd0e hn2 hd0 hd1 hgx he2r hX.r0p hSD
        have hF := copy_facts_gexp hlen hL0 hA hd0e hn2 hd0 hd1 hgx he2r (by rw [hm]; exact hBE m hm0)
          hCN (by rw [hm]; exact hCP) (by rw [hm]; exact hGP) (by rw [hm]; exact hRP) hK hKV hRK hB' hV' hVV
        rw [hm] at hF
        have hlN : (G2 M r L (m + 1)).length = r + (m + 1) * L := TRIO.gexp_length hlen
        have hlP : (G2 M r L m).length = r + m * L := TRIO.gexp_length hlen
        have hmL : (m + 1) * L = m * L + L := Nat.succ_mul m L
        have hrP : r < (G2 M r L m).length := by
          have : L ≤ m * L := Nat.le_mul_of_pos_left L hm0
          omega
        have hGN := hG (m + 1) (by omega) σ hCN
        apply vsmallRAll_iff.mpr
        intro k Lc c Rr hCL u hu
        rcases Nat.lt_or_ge k (r + L) with hix | hix
        · by_cases hsc : T2SeedCol M r L k
          · exact hSeed r L hlen hr (m + 1) hn2 σ hCN hGN k hsc Lc c Rr hCL u hu
          · have hshp := (hBS (m + 1) hn2 (fun k hk1 _ τ hτ => hG k hk1 τ hτ) σ hCN
              (fun j _ hj => ⟨hGN.ot_o j hj, hGN.ot_v j hj⟩) k hix).2.2.2.1 hsc
            have hlevM : LevAt M ρ k u := by
              rcases hu with hu | hu
              · left
                rw [hu]
                rcases hshp with ((⟨hv, _, _⟩ | ⟨hv, _⟩ | ⟨hN, _⟩) | ⟨hv, _⟩) | ⟨hv, _⟩
                · exact hv
                · exact hv
                · rw [hN] at hCL; simp at hCL
                · exact hv
                · exact hv
              · exact Or.inr (hPre r L hlen hr (m + 1) hn2 σ hCN hGN k hix hsc u hu)
            exact WfT2X.clField_of_shapeSXU (Q := fun a Lv cv => QVRAt a Lv cv u)
              (fun a Lv cv cv' h1 h2 h3 h4 h5 => qVRAt_low a Lv cv cv' u h1 h2 h3 h4 h5)
              (WfT2X.qVRAt_lowV u) (WfT2X.qVRAt_lowVG u) I.cons I.good hCN hGN hshp
              (fun Lc0 c0 R0 h => (vsmallRAll_iff.mp hVM) k Lc0 c0 R0 h u hlevM) Lc c Rr hCL
        · obtain ⟨a, rfl⟩ : ∃ a, k = r + a + L := ⟨k - L - r, by omega⟩
          have hia : r + a < (G2 M r L m).length := by
            have hkN : r + a + L < (G2 M r L (m + 1)).length :=
              (mem_children (cl_mem_children (show c ∈ CL _ (r + a + L) by rw [hCL]; simp))).1.trans
                (mem_children (cl_mem_children (show c ∈ CL _ (r + a + L) by rw [hCL]; simp))).2
            omega
          intro s y hsy ht hhi hku g hg
          by_cases hOmega : g ≤ psi s z z
          · exact Or.inl hOmega
          by_cases hState : g ≤ spArg (σ.v (r + a + L)) z (sumN (Lc.map σ.o))
          · exact Or.inr (Or.inl hState)
          by_cases hOwn : ∃ d ∈ comps u (σ.v (r + a + L)), g ≤ d
          · exact Or.inr (Or.inr hOwn)
          obtain ⟨hu1, huV⟩ := hCopy r L hlen hr (m + 1) hn2 σ _ hCN hGN hCP hGP (r + a) (by omega) hia
            Lc c Rr hCL s y hsy ht hhi u hu hku g hg (lt_of_not_ge hOmega) (lt_of_not_ge hState) hOwn
          exact copyFrame_VRA hsh hF hCP hGP hrP hV' hVV (i := r + a) (by omega) hia (fun _ => huV)
            (fun hg Lc0 c0 R0 h => hKM r L hlen hr (m + 1) hn2 σ _ hCN hCP hGP (r + a) (by omega) hia hg
              Lc0 c0 R0 h u hu1 huV)
            (fun Lc0 c0 R0 h => (vsmallRAll_iff.mp hQP) (r + a) Lc0 c0 R0 h u hu1) Lc c Rr hCL
            s y hsy ht hhi hku g hg
  intro n hn σ hσ
  rw [hexp n] at hσ ⊢
  exact key n hn σ hσ

/-- `t2_small_of_framesV3U2` with `T2VRACopyEsc2`. -/
theorem t2_small_of_framesV3U3 {M : Mat} {ρ : Valn} {rk : Bool → Nat → Nat}
    (C : StepCtx3 M ρ rk) (hz : col M (M.length - 1) ≠ (0, 0, 0))
    (h2 : TRIO.srow M (M.length - 1) = 2) (hB : T2BelowAtV3U M ρ)
    (hVS : T2SeedFrames QVSF M) (hFC : T2SeedFrames QFC M)
    (hFD : T2CopyK FDshAt M)
    (hSeed : T2VRASeed M) (hPre : T2VRAPre M ρ) (hCopy : T2VRACopyEsc2 M)
    (hVD : T2CopyK CopyVDomK M) (hAG : T2VRAK KAG2 M) :
    ∀ n, 2 ≤ n → ∀ σ rkN, Cons (expand M n) σ → Rk (expand M n) rkN →
    Good3 (expand M n) σ → PH3cG (expand M n) σ →
      VSmallF (expand M n) σ ∧ FrameClosed (expand M n) σ ∧ VSmallRAll (expand M n) σ := by
  have hl : 2 ≤ M.length := by
    obtain ⟨r, hr⟩ := parLast_of C.S.e00 C.S.r01 C.S.r12 hz
    rw [h2] at hr
    have := par_lt M 2 _ r hr
    omega
  have I := coreW C.S C.I
  have D := C.drop hl
  have I1 := C.pre (M.length - 1) (by omega) (by omega)
  have hag : ∀ τ, Cons (M.take (M.length - 1)) τ →
      Agree (M.take (M.length - 1)) (drop1 M (M.length - 1) rk) τ :=
    fun τ hτ => agree_of_cons I1.cons hτ I1.rank
  have hVSN := vsmallF_expand_t2VV3U hB C.std C.ne I D hz h2
    (fun τ hτ => ⟨good3_congr I1.good (hag τ hτ), vsmallF_of_clField hτ (good3_congr I1.good (hag τ hτ))
      (clField_congr (Q := QVSF) (clField_of_vsmallF I1.cons I1.good I1.vs) (hag τ hτ))⟩) hVS
  have hFCN := frameClosed_expand_t2KV3U hB C.std C.ne I D hz h2
    (fun τ hτ => clField_congr (Q := QFC) I1.fc (hag τ hτ)) hFC hFD
  have hVRA := vsmallRAll_expand_t2V3U2 qVRAshK_KVRA2 hB C.std C.ne I D hz h2 C.I.vra
    (fun τ hτ => vsmallRAll_congr (hag τ hτ) I1.vra) hSeed hPre hCopy
    (t2VRAK_KVRA2_of hVD hAG)
  intro n hn σ _ hCN _ hGN _
  exact ⟨hVSN n (by omega) σ hCN hGN, hFCN n (by omega) σ hCN, hVRA n (by omega) σ hCN⟩

namespace SeedPF
open Classical G

/-- **The input hN** with `KAG2` and `T2VRACopyEsc2`. -/
theorem hN_of3 (hBXU : T2AtV3 T2BelowAtV3U) (hVF : T2AtV3 (fun M ρ => SeedVFResV3 M ρ))
    (hFD : T2AtV3 (fun M _ => T2CopyK FDshAt M)) (hSeed : T2AtV3 (fun M _ => T2VRASeed M))
    (hPre : T2AtV3 (fun M ρ => T2VRAPre M ρ)) (hCopy : T2AtV3 (fun M _ => T2VRACopyEsc2 M))
    (hVD : T2AtV3 (fun M _ => T2CopyK CopyVDomK M)) (hAG : T2AtV3 (fun M _ => T2VRAK KAG2 M)) :
    T2SmallV3 := by
  intro M ρ rk C hz h2
  have hS := seed_frames_VFV3 C hz h2 (hVF M ρ rk C hz h2)
  have hVS : T2SeedFrames QVSF M :=
    fun r L hlen hr n hn hlow σ hσ hG i hi Lc c R hcl => (hS r L hlen hr n hn hlow σ hσ hG i hi Lc c R hcl).1
  have hFC : T2SeedFrames QFC M :=
    fun r L hlen hr n hn hlow σ hσ hG i hi Lc c R hcl => (hS r L hlen hr n hn hlow σ hσ hG i hi Lc c R hcl).2.2
  exact t2_small_of_framesV3U3 C hz h2 (hBXU M ρ rk C hz h2) hVS hFC (hFD M ρ rk C hz h2)
    (hSeed M ρ rk C hz h2) (hPre M ρ rk C hz h2) (hCopy M ρ rk C hz h2) (hVD M ρ rk C hz h2) (hAG M ρ rk C hz h2)


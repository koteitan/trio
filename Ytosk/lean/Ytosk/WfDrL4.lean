/-- **`t = 1`, `q ≠ r`, all `n ≥ 2`**, without the hypotheses `hcb`, `hbr`, `hF1`. -/
theorem t1_main_valG2 {M : Mat} {r L d0 : Nat} (hlen : r + L + 1 = M.length) (hL : 0 < L)
    (hd0e : entry M 0 (r + L) = entry M 0 r + d0)
    (hR0 : R0P M) (hZ2 : Z2 M) (hSD : SibDec M) (hZ1 : Z1C M) (hUAT : UAT M) (hUAB : UAB M)
    (hR12 : R12 M) (hBE : BumpE2 M) (hR01 : R01 M) (h00 : entry M 0 0 = 0)
    (h1 : par M 1 (r + L) = some r) (hx2 : entry M 2 (r + L) = 0) (hqr : par M 0 (r + L) ≠ some r)
    {ρ : Valn} {rkM : Bool → Nat → Nat}
    (hC : Cons M ρ) (hG : Good3 M ρ) (hRM : Rk M rkM)
    (hVS : VSmallF M ρ) (hF : FrameClosed M ρ) (hFO : FrameOT M ρ)
    (hKD : BumpKidsDec M ρ) (hTD : BumpTermDec M ρ) (hdrop : ∀ i, i < r + L → PO ρ (drop1 M (r + L) rkM) i ∧ PV2 M ρ (drop1 M (r + L) rkM) i)
    (hne : (drop1 M (r + L) rkM).o r ≠ ρ.o r)
    {μ br vr : T} (hμr : μ = vr) (hro : ρ.o r = psi vr br z)
    (hV : ∀ m i, i < r + L → DepX M (r + L) false i →
      VLocal M (r + L) ρ (gamS μ br ((drop1 M (r + L) rkM).o r) m) μ i)
    (hW : ∀ m i L' c R, i < r + L → DepX M (r + L) true i → children M i = L' ++ c :: R → Counted M i c →
      DepX M (r + L) true c → ∀ s y, ρ.o c = psi s y z → lt (preState M ρ i L') y = true →
      lt (psi (ρ.v i) z z) (psi s y z) = true →
      lt (preState M ρ i L') (fsD y (gamS μ br ((drop1 M (r + L) rkM).o r) m)) = true)
    (hLo : ∀ m i L' c R, i < r + L → DepX M (r + L) true i → children M i = L' ++ c :: R →
      DepX M (r + L) true c → ∀ s y, ρ.o c = psi s y z → lt (preState M ρ i L') y = true →
      lt (psi (ρ.v i) z z) (psi s y z) = true →
      ((split y (psi (succ s) z z)).2 ≠ z →
        fsD (split y (psi (succ s) z z)).2 (gamS μ br ((drop1 M (r + L) rkM).o r) m) ≠ z) ∧
      ((split y (psi (succ s) z z)).2 = z →
        (split (fsD y (gamS μ br ((drop1 M (r + L) rkM).o r) m)) (psi (succ s) z z)).2 = z))
    (hsM : ∀ i ∈ roots M, Single (ρ.o i)) (hpM : ((roots M).map ρ.o).Pairwise (fun a b => b ≤ a))
    (hG1 : Good3 (M.take (r + L)) (drop1 M (r + L) rkM))
    (Pn : Mat → Valn → Prop) (hP1 : Pn (M.take (r + L)) (drop1 M (r + L) rkM)) (hPs : ExpStepT1 Pn M r L d0 ρ) :
    ∀ n, 2 ≤ n → ∃ ρN rkN, Cons (TRIO.gexp M r L d0 0 n) ρN ∧ Rk (TRIO.gexp M r L d0 0 n) rkN ∧
      Good3 (TRIO.gexp M r L d0 0 n) ρN ∧ Pn (TRIO.gexp M r L d0 0 n) ρN ∧
      isOT (root (TRIO.gexp M r L d0 0 n) ρN) = true ∧ root (TRIO.gexp M r L d0 0 n) ρN < root M ρ := by
  have hA : Anc0 M r (r + L) := anc0_of_par M 1 r (r + L) h1
  have hrM : r < M.length := by omega
  have hvr : ρ.v r = vr := by
    obtain ⟨y0, hy0⟩ := o_psi_sub hC hrM
    rw [hro] at hy0; simp only [psi.injEq] at hy0
    rw [hy0.1, sf_ot (hG.ot_v r hrM)]
  have hF1 : ∀ i, r < i → i < r + L → DepX M (r + L) true i → ¬ DepX M (r + L) false i →
      lt μ (ρ.v i) = true := by
    intro i h2 h3 h4 h5
    rw [hμr, ← hvr]
    exact hF1_t1 hlen hR0 hZ2 hSD hZ1 hUAT hUAB h1 hC hG hRM i h2 h3 h4 h5
  have hox : ρ.o (r + L) = psi (succ μ) z z := by
    rw [o_last_t1 hlen hC hG h1 (by have := par1_entry_lt h1; omega) hx2, hvr, hμr]
  obtain ⟨q, hq⟩ := par0_of_anc hA (by omega)
  have hOS := hOS_t1 hlen hR0 hZ2 hSD hZ1 hUAT hUAB hx2 hq
  obtain ⟨hcb, hbr⟩ := hcb_t1 hlen hR0 hZ2 hSD hZ1 hUAT hUAB hC hG hox hF1 hOS (hV 0) h1 hx2 hqr
    hR12 hBE hro
  exact t1_main_dropG2 hlen hL hd0e hR0 hZ2 hSD hZ1 hUAT hUAB hR12 hBE hR01 h00 h1 hx2 hqr hC hG hRM
    hVS hF hFO hKD hTD hdrop hne hcb hμr hbr hro hF1 hV hW hLo hsM hpM hG1 Pn hP1 hPs
end

-- copied from V3StrictR.new_rewrite_same_v
section
variable {M : Mat} {x : Nat} (hx : x + 1 = M.length)
  (hR0 : R0P M) (hZ2 : Z2 M) (hSD : SibDec M) (hZ1 : Z1C M) (hUAT : UAT M) (hUAB : UAB M)
  {ρ ρ' : Valn} {rk : Bool → Nat → Nat}
  (hC : Cons M ρ) (hG : Good3 M ρ) (hC' : Cons (M.take x) ρ') (hRk' : Rk (M.take x) rk)
  (hdrop : ∀ i, i < x → PO ρ ρ' i ∧ PV2 M ρ ρ' i)
include hx hR0 hZ2 hSD hZ1 hUAT hUAB hC hG hC' hRk' hdrop
/-- A child of `M.take x` with a nonzero argument keeps its `v`. -/
theorem new_rewrite_same_v2 {d : Nat} (hd : d < x) {s y : T} (h : ρ'.o d = psi s y z) (hy : y ≠ z) :
    ρ'.v d = ρ.v d := by
  by_contra hvs
  have hdT : d < (M.take x).length := by rw [List.length_take]; omega
  have hCv : ChgX M x false d := by
    by_contra hn; exact hvs ((chg_off hx hC hG hC' hRk' d hd).2 hn)
  have hT := (chg_struct hx hR0 hZ2 hSD hZ1 hUAT hUAB hCv).1 rfl hd
  have := o_of_no_counted hC' hdT (hdrop d hd).2.2 hT.2.1
  rw [h] at this; simp only [psi.injEq] at this; exact hy this.2.1
end

-- copied from V3StrictR.arg0_take
section
variable {M : Mat} {x : Nat} (hx : x + 1 = M.length)
  (hR0 : R0P M) (hZ2 : Z2 M) (hSD : SibDec M) (hZ1 : Z1C M) (hUAT : UAT M) (hUAB : UAB M)
  {ρ ρ' : Valn} {rk : Bool → Nat → Nat}
  (hC : Cons M ρ) (hG : Good3 M ρ) (hC' : Cons (M.take x) ρ') (hRk' : Rk (M.take x) rk)
  (hdrop : ∀ i, i < x → PO ρ ρ' i ∧ PV2 M ρ ρ' i)
include hx hR0 hZ2 hSD hZ1 hUAT hUAB hC hG hC' hRk' hdrop
omit hRk' hUAB in
/-- **An argument `0` stays `0`** in `M.take x`. -/
theorem arg0_take2 {d : Nat} (hd : d < x) {s : T} (h : ρ.o d = psi s z z) : ∃ s', ρ'.o d = psi s' z z := by
  have hdM : d < M.length := by omega
  have hdT : d < (M.take x).length := by rw [List.length_take]; omega
  have hnil : CL M d = [] := by
    by_contra hne
    have hlt := arg_lt_of_cl (σ := ρ) hC hG hdM hne
    rw [o_cl_eq hC hG hdM] at h
    simp only [psi.injEq] at h
    rw [h.2.1] at hlt; exact lt_irrefl' _ hlt
  obtain ⟨Tl, hTl⟩ := cl_prefix hx hR0 hZ2 hSD hZ1 hUAT hd
  have hT : CL (M.take x) d = [] := by
    rw [hnil] at hTl; exact (List.append_eq_nil_iff.mp hTl.symm).1
  exact ⟨ρ'.v d, o_of_no_counted hC' hdT (hdrop d hd).2.2 (no_cnt_of_cl_nil hT)⟩
end

-- copied from V3StrictR.o_strict_frame
section
variable {M : Mat} {x : Nat} (hx : x + 1 = M.length)
  (hR0 : R0P M) (hZ2 : Z2 M) (hSD : SibDec M) (hZ1 : Z1C M) (hUAT : UAT M) (hUAB : UAB M)
  {ρ ρ' : Valn} {rk : Bool → Nat → Nat}
  (hC : Cons M ρ) (hG : Good3 M ρ) (hC' : Cons (M.take x) ρ') (hRk' : Rk (M.take x) rk)
  (hdrop : ∀ i, i < x → PO ρ ρ' i ∧ PV2 M ρ ρ' i)
include hx hR0 hZ2 hSD hZ1 hUAT hUAB hC hG hC' hRk' hdrop
/-- **The `o` frame is strict**: `c` is the last counted child of `i` in `M`, and it drops strictly
when it stays in `M.take x`. -/
theorem o_strict_frame2 {i c : Nat} (hi : i < x) (hcCL : c ∈ CL M i) (hlast : ∀ d ∈ CL M i, d ≤ c)
    (hIH : c < x → ρ'.o c < ρ.o c) : ρ'.o i < ρ.o i := by
  have hlenT : (M.take x).length = x := by rw [List.length_take]; omega
  have hiT : i < (M.take x).length := by omega
  have hiM : i < M.length := by omega
  have hoff := chg_off hx hC hG hC' hRk'
  obtain ⟨Tl, hTl⟩ := cl_prefix hx hR0 hZ2 hSD hZ1 hUAT hi
  have hvot : isOT (ρ.v i) = true := hG.ot_v i hiM
  rcases List.eq_nil_or_concat (CL (M.take x) i) with hnil | ⟨Lc, cs, hcl⟩
  · rw [o_of_no_counted hC' hiT (hdrop i hi).2.2 (no_cnt_of_cl_nil hnil), o_cl_eq hC hG hiM]
    exact psi_z_lt_of_le (hdrop i hi).2.le (arg_lt_of_cl hC hG hiM (List.ne_nil_of_mem hcCL))
  rw [List.concat_eq_append] at hcl
  have hcsT : cs ∈ children (M.take x) i ∧ Counted (M.take x) i cs := by
    have : cs ∈ CL (M.take x) i := by rw [hcl]; simp
    unfold CL at this; rw [List.mem_filter] at this; exact ⟨this.1, by simpa using this.2⟩
  have hcsx : cs < x := by have := (mem_children hcsT.1).2; omega
  have hcsM : cs < M.length := by omega
  have hCv : ¬ ChgX M x false i := fun h =>
    ((chg_struct hx hR0 hZ2 hSD hZ1 hUAT hUAB h).1 rfl hi).2.1 cs hcsT.1 hcsT.2
  have hv' : ρ'.v i = ρ.v i := (hoff i hi).2 hCv
  set a := ρ.v i with ha
  -- the earlier counted children do not change
  have hsame : ∀ d ∈ Lc, ρ'.o d = ρ.o d := by
    intro d hd
    have hdT : d ∈ CL (M.take x) i := by rw [hcl]; simp [hd]
    have hdc : d ∈ children (M.take x) i := by unfold CL at hdT; exact (List.mem_filter.mp hdT).1
    have hdcs : d < cs := by
      have hs := cl_sorted (M.take x) i
      rw [hcl] at hs
      exact (List.pairwise_append.mp hs).2.2 d hd cs (by simp)
    have hdx : d < x := by
      rw [children_take, List.mem_filter] at hdc; simpa using hdc.2
    by_contra hne
    have hCd : ChgX M x true d := by
      by_contra hn; exact hne ((hoff d hdx).1 hn)
    exact chg_last hx hR0 hZ2 hSD hZ1 hUAT hUAB hdc hCd cs hcsT.1 hdcs hcsT.2
  have hclM : CL M i = Lc ++ [cs] ++ Tl := by rw [hTl, hcl]
  obtain ⟨hsM, hpM⟩ := cl_vals hC hG hiM
  rw [hclM] at hsM hpM
  simp only [List.map_append, List.map_cons, List.map_nil] at hsM hpM
  set Lv := Lc.map ρ.o with hLv
  set Tv := Tl.map ρ.o with hTv
  have hsL : ∀ t ∈ Lv, Single t := fun t ht => hsM t (by simp [ht])
  have hcsS : Single (ρ.o cs) := hsM _ (by simp)
  have hsTv : ∀ t ∈ Tv, Single t := fun t ht => hsM t (by simp [ht])
  have hp1 := List.pairwise_append.mp hpM
  have hpL : Lv.Pairwise (fun a b => b ≤ a) := (List.pairwise_append.mp hp1.1).1
  have hLc : ∀ t ∈ Lv, ρ.o cs ≤ t := fun t ht =>
    (List.pairwise_append.mp hp1.1).2.2 t ht _ (by simp)
  have hsLc : ∀ t ∈ Lv ++ [ρ.o cs], Single t := fun t ht => by
    rcases List.mem_append.mp ht with h | h
    · exact hsL t h
    · simp at h; rw [h]; exact hcsS
  have hpLc : (Lv ++ [ρ.o cs]).Pairwise (fun a b => b ≤ a) :=
    List.pairwise_append.mpr ⟨hpL, by simp, fun t ht b hb => by simp at hb; rw [hb]; exact hLc t ht⟩
  -- `M.take x` side
  have hPOc := (hdrop cs hcsx).1
  have hPVc := (hdrop cs hcsx).2
  have hle' : ρ'.o cs ≤ ρ.o cs := hPOc.le
  have hmapT : (CL (M.take x) i).map ρ'.o = Lv ++ [ρ'.o cs] := by
    rw [hcl, List.map_append, List.map_singleton, hLv]
    congr 1; exact List.map_congr_left hsame
  have hsT : ∀ c ∈ CL (M.take x) i, Single (ρ'.o c) := by
    intro d hd
    have : ρ'.o d ∈ (CL (M.take x) i).map ρ'.o := List.mem_map_of_mem hd
    rw [hmapT] at this
    rcases List.mem_append.mp this with h | h
    · exact hsL _ h
    · simp at h; rw [h]; exact hPOc.2
  have hpT : ((CL (M.take x) i).map ρ'.o).Pairwise (fun a b => b ≤ a) := by
    rw [hmapT]
    exact List.pairwise_append.mpr ⟨hpL, by simp,
      fun t ht b hb => by simp at hb; rw [hb]; exact le_trans hle' (hLc t ht)⟩
  obtain ⟨s', y', hs'y'⟩ := hPOc.2.2
  obtain ⟨s, y, hsy⟩ := hcsS.2
  have hform := o_last_form hC' hiT (by rw [hv']; exact hvot) hcl hsT hpT hs'y'
  have hLm : Lc.map ρ'.o = Lv := List.map_congr_left hsame
  rw [hLm, hv'] at hform
  set B := spArg a z (sumN Lv) with hB
  have hLs := sumN_dec Lv hsL hpL
  -- the old side
  have hstate : spArg a z (sumN (Lv ++ [ρ.o cs])) = step a B s y z := by
    rw [sumN_append_dec hsLc hpLc, sumN_singleton hcsS, spArg_app, hsy, spArg_single]
  have hold : ρ.o i = psi a (spArg a (step a B s y z) (sumN Tv)) z := by
    rw [o_cl_eq hC hG hiM, hclM, ← ha]
    simp only [List.map_append, List.map_singleton]
    rw [← hLv, ← hTv, ← hstate, ← spArg_app,
      ← sumN_append_dec (fun t ht => hsM t (by simpa using ht)) (by simpa using hpM)]
  -- the step on the child
  have hstep : ρ'.o cs < ρ.o cs → step a B s' y' z < step a B s y z := by
    intro hlt
    have hc : isOT (psi s y z) = true := by rw [← hsy]; exact hcsS.1
    have hc' : isOT (psi s' y' z) = true := by rw [← hs'y']; exact hPOc.2.1
    apply step_lt hc hc'
    · rcases hPOc.1 with h | ⟨⟨w', w, X, hw', _, _⟩, _⟩
      · rcases h with h | h
        · exact absurd (h ▸ hlt) (lt_irrefl' _)
        · left; rw [← hsy, ← hs'y']; exact h
      · right
        rw [hs'y'] at hw'; simp only [psi.injEq] at hw'
        refine ⟨hw'.2.1, ?_⟩
        rw [← hsy, ← hs'y']; exact hlt
    · intro q hq
      apply spArg_summands_ge ⟨s, y, rfl⟩ (sumN Lv) z hLs.1
      · rw [hLs.2]; intro q hq; rw [← hsy]; exact hLc q hq
      · simp [summands]
      · exact hq
    · intro ht' hss
      exfalso
      have hvs := new_rewrite_same_v2 hx hR0 hZ2 hSD hZ1 hUAT hUAB hC hG hC' hRk' hdrop hcsx hs'y'
        (ne_z_of_lt ht'.1)
      obtain ⟨y0, hy0⟩ := o_psi_sub hC' (show cs < (M.take x).length by omega)
      rw [hs'y'] at hy0; simp only [psi.injEq] at hy0
      obtain ⟨y1, hy1⟩ := o_psi_sub hC (show cs < M.length by omega)
      rw [hsy] at hy1; simp only [psi.injEq] at hy1
      rw [hy0.1, hy1.1, hvs] at hss
      exact lt_irrefl' _ hss
    · intro hy
      rw [hy] at hsy
      obtain ⟨s'', h''⟩ := arg0_take2 hx hR0 hZ2 hSD hZ1 hUAT hC hG hC' hdrop hcsx hsy
      rw [hs'y'] at h''; simp only [psi.injEq] at h''; exact h''.2.1
  have hle : step a B s' y' z ≤ step a B s y z := by
    rcases (le_iff _ _).mp hle' with h | h
    · exact le_of_lt (hstep h)
    · rw [hs'y', hsy] at h; simp only [psi.injEq] at h; rw [h.1, h.2.1]
  rw [hform, hold]
  apply psi_lt_psi_z_iff.mpr; right; refine ⟨rfl, ?_⟩
  by_cases hTl0 : Tl = []
  · -- `c = cs`
    have hTv0 : Tv = [] := by rw [hTv, hTl0]; rfl
    rw [hTv0, show sumN ([] : List T) = z from rfl, show spArg a (step a B s y z) z = step a B s y z from rfl]
    have hccs : c = cs := by
      have hc2 : c ∈ Lc ++ [cs] := by rw [hclM, hTl0, List.append_nil] at hcCL; exact hcCL
      rcases List.mem_append.mp hc2 with h | h
      · exfalso
        have hs := cl_sorted M i
        rw [hclM, hTl0, List.append_nil] at hs
        have h1 := (List.pairwise_append.mp hs).2.2 c h cs (by simp)
        have h2 := hlast cs (by rw [hclM]; simp)
        omega
      · simpa using h
    subst hccs
    exact hstep (hIH hcsx)
  · have hTvne : Tv ≠ [] := by rw [hTv]; simpa using hTl0
    apply lt_of_le_of_lt hle
    apply lt_spArg
    · exact isOT_sumN _ (fun t ht => (hsTv t ht).1)
    · exact sumN_ne_z hsTv hp1.2.1 hTvne
end

-- copied from V3StrictR.v_strict_bump
section
variable {M : Mat} {x : Nat} (hx : x + 1 = M.length)
  (hR0 : R0P M) (hZ2 : Z2 M) (hSD : SibDec M) (hZ1 : Z1C M) (hUAT : UAT M) (hUAB : UAB M)
  {ρ ρ' : Valn} {rk : Bool → Nat → Nat}
  (hC : Cons M ρ) (hG : Good3 M ρ) (hC' : Cons (M.take x) ρ') (hRk' : Rk (M.take x) rk)
  (hdrop : ∀ i, i < x → PO ρ ρ' i ∧ PV2 M ρ ρ' i)
include hx hR0 hZ2 hSD hZ1 hUAT hUAB hC hG hC' hRk' hdrop
/-- **The `v` frame of a bump column is strict**: the last child `k` of the bump child `j` (the last
child of `i`) drops strictly or is `x`. -/
theorem v_strict_bump2 {i j k : Nat} (hi : i < x) (h1 : entry M 1 i ≠ 0) (h2 : entry M 2 i ≠ 0)
    {L K : List Nat} (hch : children M i = L ++ [j]) (hjb : col M j = bump M i)
    (hchj : children M j = K ++ [k]) (hLx : ∀ d ∈ L, ∀ e ∈ children M d, e < x)
    (hIH : k < x → ρ'.o k < ρ.o k) : ρ'.v i < ρ.v i := by
  have hlenT : (M.take x).length = x := by rw [List.length_take]; omega
  have hiT : i < (M.take x).length := by omega
  have hiM : i < M.length := by omega
  have hoff := chg_off hx hC hG hC' hRk'
  have hjM : j ∈ children M i := by rw [hch]; simp
  have hkM : k ∈ children M j := by rw [hchj]; simp
  have hij := (mem_children hjM).1
  have hjk := (mem_children hkM).1
  have hkl := (mem_children hkM).2
  have hjx : j < x := by omega
  -- the row-1 parent does not change
  have hV : vOpt ρ' (par (M.take x) 1 i) = vOpt ρ (par M 1 i) := by
    rw [par_take M 1 i hi]
    cases hp : par M 1 i with
    | none => rfl
    | some m =>
      show ρ'.v m = ρ.v m
      have hm := par_lt M 1 i m hp
      apply (hoff m (by omega)).2
      intro hCm
      exact (chg_struct hx hR0 hZ2 hSD hZ1 hUAT hUAB hCm).1 rfl (by omega) |>.2.2 i hi hp
  have hVot : isOT (vOpt ρ (par M 1 i)) = true := by
    cases hp : par M 1 i with
    | none => rfl
    | some m => exact hG.ot_v m (by have := par_lt M 1 i m hp; omega)
  -- the children of `i` in `M.take x`
  have hLj : ∀ d ∈ L, d < j := (sib_order (children_sorted M i) (R := []) (by rw [hch])).1
  have hchT : children (M.take x) i = L ++ [j] := by
    rw [children_take, hch, List.filter_eq_self]
    intro d hd
    rcases List.mem_append.mp hd with h | h
    · have := hLj d h; simp only [decide_eq_true_eq]; omega
    · simp at h; subst h; simp only [decide_eq_true_eq]; omega
  have hjT : j ∈ children (M.take x) i := by rw [hchT]; simp
  -- the earlier bump terms do not change
  have hbtL : ∀ d ∈ L, bumpTerm (M.take x) ρ' i d = bumpTerm M ρ i d := by
    intro d hd
    have hdx : d < x := by have := hLj d hd; omega
    have hdM : d ∈ children M i := by rw [hch]; simp [hd]
    unfold bumpTerm
    rw [col_take M hdx, bump_take M hi]
    split
    · have hchd : children (M.take x) d = children M d := by
        rw [children_take, List.filter_eq_self]
        intro e he; simp only [decide_eq_true_eq]; exact hLx d hd e he
      rw [hchd]
      congr 2
      apply List.map_congr_left
      intro e he
      have hex := hLx d hd e he
      apply (hoff e hex).1
      intro hCe
      exact chg_only_last hx hR0 hZ2 hSD hZ1 hUAT hUAB h2 hdM hjT (hLj d hd) hCe
        (Anc0.step (mem_children_iff.mp he).2 (Anc0.refl d))
    · rfl
  -- the values
  set G := sumN (K.map ρ.o ++ [ρ.o k]) with hGdef
  have hKk : ∀ d ∈ K, d < k := (sib_order (children_sorted M j) (R := []) (by rw [hchj])).1
  have hKx : ∀ d ∈ K, d < x := fun d hd => by have := hKk d hd; omega
  have hKot : ∀ t ∈ K.map ρ.o, isOT t = true := by
    intro t ht; obtain ⟨d, hd, rfl⟩ := List.mem_map.mp ht; exact hG.ot_o d (by have := hKx d hd; omega)
  have hKot' : ∀ t ∈ K.map ρ'.o, isOT t = true := by
    intro t ht; obtain ⟨d, hd, rfl⟩ := List.mem_map.mp ht; exact (hdrop d (hKx d hd)).1.2.1
  have hKle : sumN (K.map ρ'.o) ≤ sumN (K.map ρ.o) := by
    exact sumN_le2 (forall2_map_le (fun d hd => (hdrop d (hKx d hd)).1.le)) hKot' hKot
  have hkot : isOT (ρ.o k) = true := hG.ot_o k hkl
  have hGot : isOT G = true := isOT_sumN _ (fun t ht => by
    rcases List.mem_append.mp ht with h | h
    · exact hKot t h
    · simp at h; rw [h]; exact hkot)
  -- `G′ < G`
  obtain ⟨G', hG'ot, hG'lt, hbtj⟩ : ∃ G', isOT G' = true ∧ G' < G ∧
      bumpTerm (M.take x) ρ' i j = omega G' := by
    have hbt : bumpTerm (M.take x) ρ' i j = omega (sumN ((children (M.take x) j).map ρ'.o)) := by
      unfold bumpTerm; rw [col_take M hjx, bump_take M hi, if_pos hjb]
    rw [hbt]
    by_cases hkx : k < x
    · have hchjT : children (M.take x) j = K ++ [k] := by
        rw [children_take, hchj, List.filter_eq_self]
        intro d hd
        rcases List.mem_append.mp hd with h | h
        · simp only [decide_eq_true_eq]; exact hKx d h
        · simp at h; subst h; simp only [decide_eq_true_eq]; exact hkx
      have hk' : isOT (ρ'.o k) = true := (hdrop k hkx).1.2.1
      refine ⟨_, ?_, ?_, rfl⟩
      · rw [hchjT, List.map_append, List.map_singleton]
        exact isOT_sumN _ (fun t ht => by
          rcases List.mem_append.mp ht with h | h
          · exact hKot' t h
          · simp at h; rw [h]; exact hk')
      · rw [hchjT, List.map_append, List.map_singleton]
        exact sumN_snoc_lt hKot' hKot hk' hkot hKle (hIH hkx)
    · have hkx' : k = x := by omega
      have hchjT : children (M.take x) j = K := by
        rw [children_take, hchj, List.filter_append, List.filter_eq_self.mpr
          (fun d hd => by simp only [decide_eq_true_eq]; exact hKx d hd)]
        simp [hkx']
      refine ⟨_, ?_, ?_, rfl⟩
      · rw [hchjT]; exact isOT_sumN _ hKot'
      · rw [hchjT]
        exact sumN_lt_snoc hKot hkot hKle (by
          obtain ⟨s0, y0, h0⟩ := o_psi_form hC hkl; rw [h0]; exact T.z_lt_psi _ _ _)
  -- assemble
  set Pl := one :: L.map (bumpTerm M ρ i) with hPl
  have hPlot : ∀ t ∈ Pl, isOT t = true := by
    intro t ht
    rcases List.mem_cons.mp ht with rfl | ht
    · rfl
    · obtain ⟨d, _, rfl⟩ := List.mem_map.mp ht; exact isOT_bumpTerm hG i d
  have hbtjM : bumpTerm M ρ i j = omega G := by
    unfold bumpTerm; rw [if_pos hjb, hchj, List.map_append, List.map_singleton]
  have hvM : ρ.v i = sf (add (vOpt ρ (par M 1 i)) (omega (sumN (Pl ++ [omega G])))) := by
    rw [(hC i hiM).2]; unfold vRhs
    rw [if_neg h1, if_neg h2, hch, List.map_append, List.map_singleton, hbtjM, ← List.cons_append]
  have hvT : ρ'.v i = sf (add (vOpt ρ (par M 1 i)) (omega (sumN (Pl ++ [omega G'])))) := by
    rw [(hC' i hiT).2]; unfold vRhs
    rw [entry_take M 1 hi, entry_take M 2 hi, if_neg h1, if_neg h2, hV, hchT, List.map_append,
      List.map_singleton, hbtj, List.map_congr_left hbtL, ← List.cons_append]
  have hP'ot : isOT (sumN (Pl ++ [omega G'])) = true := isOT_sumN _ (fun t ht => by
    rcases List.mem_append.mp ht with h | h
    · exact hPlot t h
    · simp at h; rw [h]; exact isOT_omega hG'ot)
  have hPot : isOT (sumN (Pl ++ [omega G])) = true := isOT_sumN _ (fun t ht => by
    rcases List.mem_append.mp ht with h | h
    · exact hPlot t h
    · simp at h; rw [h]; exact isOT_omega hGot)
  have hP : sumN (Pl ++ [omega G']) < sumN (Pl ++ [omega G]) :=
    sumN_snoc_lt hPlot hPlot (isOT_omega hG'ot) (isOT_omega hGot) (le_refl _)
      (omega_lt_omega hG'ot hGot hG'lt)
  rw [hvM, hvT, sf_ot (isOT_add hVot (isOT_omega hP'ot)), sf_ot (isOT_add hVot (isOT_omega hPot))]
  exact add_lt_add_left _ (omega_lt_omega hP'ot hPot hP)
end

-- copied from V3DropPres.cl_take_vals
section
variable {M : Mat} {x : Nat} (hx : x + 1 = M.length)
  (hR0 : R0P M) (hZ2 : Z2 M) (hSD : SibDec M) (hZ1 : Z1C M) (hUAT : UAT M) (hUAB : UAB M)
  {ρ ρ' : Valn} {rk : Bool → Nat → Nat}
  (hC : Cons M ρ) (hG : Good3 M ρ) (hC' : Cons (M.take x) ρ') (hRk' : Rk (M.take x) rk)
  (hdrop : ∀ i, i < x → PO ρ ρ' i ∧ PV2 M ρ ρ' i)
include hx hR0 hZ2 hSD hZ1 hUAT hUAB hC hG hC' hRk' hdrop
theorem cl_take_vals2 {i : Nat} (hi : i < x) :
    (∀ c ∈ CL (M.take x) i, Single (ρ'.o c)) ∧
    ((CL (M.take x) i).map ρ'.o).Pairwise (fun a b => b ≤ a) := by
  have hiM : i < M.length := by omega
  refine ⟨fun c hc => (hdrop c (by
    have := (mem_children (cl_mem_children hc)).2; rw [lenT hx] at this; exact this)).1.2, ?_⟩
  obtain ⟨Tl, hTl⟩ := cl_prefix hx hR0 hZ2 hSD hZ1 hUAT hi
  rcases List.eq_nil_or_concat (CL (M.take x) i) with hnil | ⟨Lc, cs, hcl⟩
  · rw [hnil]; exact List.Pairwise.nil
  rw [List.concat_eq_append] at hcl
  have hcsT : cs ∈ children (M.take x) i ∧ Counted (M.take x) i cs := by
    have : cs ∈ CL (M.take x) i := by rw [hcl]; simp
    unfold CL at this; rw [List.mem_filter] at this; exact ⟨this.1, by simpa using this.2⟩
  have hcsx : cs < x := by have := (mem_children hcsT.1).2; rw [lenT hx] at this; exact this
  have hsame : ∀ d ∈ Lc, ρ'.o d = ρ.o d := by
    intro d hd
    have hdT : d ∈ CL (M.take x) i := by rw [hcl]; simp [hd]
    have hdcs : d < cs := by
      have hs := cl_sorted (M.take x) i
      rw [hcl] at hs
      exact (List.pairwise_append.mp hs).2.2 d hd cs (by simp)
    exact o_same_before_cnt hx hR0 hZ2 hSD hZ1 hUAT hUAB hC hG hC' hRk' (cl_mem_children hdT)
      hcsT.1 hdcs hcsT.2
  obtain ⟨_, hpM⟩ := cl_vals hC hG hiM
  rw [hTl, hcl] at hpM
  simp only [List.map_append, List.map_cons, List.map_nil] at hpM
  have hp1 := List.pairwise_append.mp hpM
  have hpL := (List.pairwise_append.mp hp1.1)
  rw [hcl, List.map_append, List.map_singleton, List.map_congr_left hsame]
  exact List.pairwise_append.mpr ⟨hpL.1, by simp, fun t ht b hb => by
    simp at hb; rw [hb]; exact le_trans (hdrop cs hcsx).1.le (hpL.2.2 t ht _ (by simp))⟩
end

-- copied from V3DropPres.good3_take
section
variable {M : Mat} {x : Nat} (hx : x + 1 = M.length)
  (hR0 : R0P M) (hZ2 : Z2 M) (hSD : SibDec M) (hZ1 : Z1C M) (hUAT : UAT M) (hUAB : UAB M)
  {ρ ρ' : Valn} {rk : Bool → Nat → Nat}
  (hC : Cons M ρ) (hG : Good3 M ρ) (hC' : Cons (M.take x) ρ') (hRk' : Rk (M.take x) rk)
  (hdrop : ∀ i, i < x → PO ρ ρ' i ∧ PV2 M ρ ρ' i)
include hx hR0 hZ2 hSD hZ1 hUAT hUAB hC hG hC' hRk' hdrop
/-- **Good3 passes to `M.take x`.** -/
theorem good3_take2 : Good3 (M.take x) ρ' where
  ot_o := fun i hi => (hdrop i (by rw [lenT hx] at hi; exact hi)).1.2.1
  ot_v := fun i hi => (hdrop i (by rw [lenT hx] at hi; exact hi)).2.2
  dec := by
    intro i hi
    rw [lenT hx] at hi
    rw [cvals_eq_map' i (fun c hc => single_ne_z (hdrop c (by
      have := (mem_children hc).2; rw [lenT hx] at this; exact this)).1.2)]
    exact (cl_take_vals2 hx hR0 hZ2 hSD hZ1 hUAT hUAB hC hG hC' hRk' hdrop hi).2
end

-- copied from V3DropPres.rewrite_take
section
variable {M : Mat} {x : Nat} (hx : x + 1 = M.length)
  (hR0 : R0P M) (hZ2 : Z2 M) (hSD : SibDec M) (hZ1 : Z1C M) (hUAT : UAT M) (hUAB : UAB M)
  {ρ ρ' : Valn} {rk : Bool → Nat → Nat}
  (hC : Cons M ρ) (hG : Good3 M ρ) (hC' : Cons (M.take x) ρ') (hRk' : Rk (M.take x) rk)
  (hdrop : ∀ i, i < x → PO ρ ρ' i ∧ PV2 M ρ ρ' i)
include hx hR0 hZ2 hSD hZ1 hUAT hUAB hC hG hC' hRk' hdrop
/-- **A rewrite in `M.take x` is a rewrite in `M`** (the child drops by `◁`, or has argument `0` and
cannot rewrite; a rewriting new child keeps its `v`). -/
theorem rewrite_take2 {i : Nat} (hi : i < x) {L : List Nat} {c : Nat} {R : List Nat}
    (h : CL (M.take x) i = L ++ c :: R) {s' y' : T} (hc' : ρ'.o c = psi s' y' z)
    (ht' : lt (spArg (ρ.v i) z (sumN (L.map ρ.o))) y' = true ∧ lt (psi (ρ.v i) z z) (psi s' y' z) = true)
    {s y : T} (hsy : ρ.o c = psi s y z) :
    lt (spArg (ρ.v i) z (sumN (L.map ρ.o))) y = true ∧ lt (psi (ρ.v i) z z) (psi s y z) = true := by
  have hiM : i < M.length := by omega
  obtain ⟨_, _, Tl, hM⟩ := frame_take hx hR0 hZ2 hSD hZ1 hUAT hUAB hC hG hC' hRk' hi h
  have hcT : c ∈ CL (M.take x) i := by rw [h]; simp
  have hcx : c < x := by have := (mem_children (cl_mem_children hcT)).2; rw [lenT hx] at this; exact this
  set a := ρ.v i
  set B := spArg a z (sumN (L.map ρ.o)) with hB
  obtain ⟨hsM, hpM⟩ := cl_vals hC hG hiM
  rw [hM] at hsM hpM
  -- the rewrite in `M`
  by_cases heq : ρ'.o c = ρ.o c
  · rw [heq, hsy] at hc'; simp only [psi.injEq] at hc'; obtain ⟨rfl, rfl, -⟩ := hc'; exact ht'
  have hPO := (hdrop c hcx).1
  have hlt : psi s' y' z < psi s y z := by
    rw [← hc', ← hsy]; exact lt_of_le_of_ne hPO.le heq
  have hsL : ∀ t ∈ L.map ρ.o, Single t := fun t ht => hsM t (by
    rw [List.map_append]; exact List.mem_append_left _ ht)
  have hpL : (L.map ρ.o).Pairwise (fun a b => b ≤ a) := by
    simp only [List.map_append, List.map_cons] at hpM
    exact (List.pairwise_append.mp hpM).1
  have hLc : ∀ t ∈ L.map ρ.o, ρ.o c ≤ t := by
    simp only [List.map_append, List.map_cons] at hpM
    intro t ht; exact (List.pairwise_append.mp hpM).2.2 t ht _ List.mem_cons_self
  have hLs := sumN_dec _ hsL hpL
  have hBc : ∀ q ∈ summands B, psi s y z ≤ q := by
    intro q hq
    apply spArg_summands_ge ⟨s, y, rfl⟩ (sumN (L.map ρ.o)) z hLs.1
    · rw [hLs.2]; intro q hq; rw [← hsy]; exact hLc q hq
    · simp [summands]
    · exact hq
  rcases hPO.1 with hl | ⟨⟨w', w, X, hw', _, _⟩, _⟩
  · rcases hl with he | hl
    · exact absurd he heq
    rw [hc', hsy] at hl
    refine ⟨?_, lt_trans ht'.2 hlt⟩
    rcases psi_lt_psi_z_iff.mp hlt with hss | ⟨rfl, hyy⟩
    · -- a rewriting new child keeps its `v`, so the subscripts are equal
      exfalso
      have hvs := new_rewrite_same_v2 hx hR0 hZ2 hSD hZ1 hUAT hUAB hC hG hC' hRk' hdrop hcx hc'
        (ne_z_of_lt ht'.1)
      obtain ⟨y0, hy0⟩ := o_psi_sub hC' (show c < (M.take x).length by rw [lenT hx]; exact hcx)
      rw [hc'] at hy0; simp only [psi.injEq] at hy0
      obtain ⟨y1, hy1⟩ := o_psi_sub hC (show c < M.length by omega)
      rw [hsy] at hy1; simp only [psi.injEq] at hy1
      rw [hy0.1, hy1.1, hvs] at hss
      exact lt_irrefl' _ hss
    · exact lt_trans ht'.1 hyy
  · exfalso
    rw [hc'] at hw'; simp only [psi.injEq] at hw'
    have := ht'.1; rw [hw'.2.1] at this; exact T.not_lt_z _ this
end

-- copied from V3DropPres.frameClosed_take
section
variable {M : Mat} {x : Nat} (hx : x + 1 = M.length)
  (hR0 : R0P M) (hZ2 : Z2 M) (hSD : SibDec M) (hZ1 : Z1C M) (hUAT : UAT M) (hUAB : UAB M)
  {ρ ρ' : Valn} {rk : Bool → Nat → Nat}
  (hC : Cons M ρ) (hG : Good3 M ρ) (hC' : Cons (M.take x) ρ') (hRk' : Rk (M.take x) rk)
  (hdrop : ∀ i, i < x → PO ρ ρ' i ∧ PV2 M ρ ρ' i)
include hx hR0 hZ2 hSD hZ1 hUAT hUAB hC hG hC' hRk' hdrop
/-- **FrameClosed passes to `M.take x`**: a rewriting new child has the same subscript and a smaller
argument, so its frame is that of `M` with a smaller `H`. -/
theorem frameClosed_take2 (hF : FrameClosed M ρ) : FrameClosed (M.take x) ρ' := by
  intro i hi L c R h s' y' hc' ht'
  rw [lenT hx] at hi
  have hiM : i < M.length := by omega
  obtain ⟨hv, hL, Tl, hM⟩ := frame_take hx hR0 hZ2 hSD hZ1 hUAT hUAB hC hG hC' hRk' hi h
  rw [hv, hL] at ht' ⊢
  obtain ⟨hsM, _⟩ := cl_vals hC hG hiM
  rw [hM] at hsM
  obtain ⟨s, y, hsy⟩ := (hsM (ρ.o c) (by simp)).2
  have hcT : c ∈ CL (M.take x) i := by rw [h]; simp
  have hcx : c < x := by have := (mem_children (cl_mem_children hcT)).2; rw [lenT hx] at this; exact this
  have hD := hF i hiM L c (R ++ Tl) hM s y hsy
    (rewrite_take2 hx hR0 hZ2 hSD hZ1 hUAT hUAB hC hG hC' hRk' hdrop hi h hc' ht' hsy)
  -- the same subscript
  have hvs := new_rewrite_same_v2 hx hR0 hZ2 hSD hZ1 hUAT hUAB hC hG hC' hRk' hdrop hcx hc'
    (ne_z_of_lt ht'.1)
  obtain ⟨y0, hy0⟩ := o_psi_sub hC' (show c < (M.take x).length by rw [lenT hx]; exact hcx)
  rw [hc'] at hy0; simp only [psi.injEq] at hy0
  obtain ⟨y1, hy1⟩ := o_psi_sub hC (show c < M.length by omega)
  rw [hsy] at hy1; simp only [psi.injEq] at hy1
  have hss : s' = s := by rw [hy0.1, hy1.1, hvs]
  subst hss
  have hle : psi s' y' z ≤ psi s' y z := by
    rw [← hc', ← hsy]
    exact DRelOA.le ((hdrop c hcx).1.1.elim (fun h => Or.inl h) (fun h => Or.inr h.1))
  have hyy : y' ≤ y := by
    rcases (le_iff _ _).mp hle with h | h
    · rcases psi_lt_psi_z_iff.mp h with h | ⟨_, h⟩
      · exact absurd h (lt_irrefl' _)
      · exact le_of_lt h
    · simp only [psi.injEq] at h; rw [h.2.1]
  have hc1 : isOT (psi s' y' z) = true := by rw [← hc']; exact (hdrop c hcx).1.2.1
  have hc2 : isOT (psi s' y z) = true := by rw [← hsy]; exact hG.ot_o c (by omega)
  exact FrameDom.mono hD (H_mono hc1 hc2 hyy)
end

-- copied from V3DropPres.vsmallF_take
section
variable {M : Mat} {x : Nat} (hx : x + 1 = M.length)
  (hR0 : R0P M) (hZ2 : Z2 M) (hSD : SibDec M) (hZ1 : Z1C M) (hUAT : UAT M) (hUAB : UAB M)
  {ρ ρ' : Valn} {rk : Bool → Nat → Nat}
  (hC : Cons M ρ) (hG : Good3 M ρ) (hC' : Cons (M.take x) ρ') (hRk' : Rk (M.take x) rk)
  (hdrop : ∀ i, i < x → PO ρ ρ' i ∧ PV2 M ρ ρ' i)
include hx hR0 hZ2 hSD hZ1 hUAT hUAB hC hG hC' hRk' hdrop
/-- **VSmallF passes to `M.take x`**, given the new subscripts of the drop (`VSmallNew`). -/
theorem vsmallF_take2 (hVF : VSmallF M ρ) (hVN : VSmallNew M x ρ ρ') : VSmallF (M.take x) ρ' := by
  intro i hi L c R h
  rw [lenT hx] at hi
  have hiM : i < M.length := by omega
  obtain ⟨hv, hL, Tl, hM⟩ := frame_take hx hR0 hZ2 hSD hZ1 hUAT hUAB hC hG hC' hRk' hi h
  have hfr := hVF i hiM L c (R ++ Tl) hM
  have hcT : c ∈ CL (M.take x) i := by rw [h]; simp
  have hcc := cl_mem_children hcT
  have hcx : c < x := by have := (mem_children hcc).2; rw [lenT hx] at this; exact this
  rw [hv, hL]
  by_cases hvc : ρ'.v c = ρ.v c
  · rw [hvc]; exact hfr
  · -- `c` changes, so it is the last counted child
    have hR : R = [] := by
      rcases R with _ | ⟨d, R'⟩
      · rfl
      · exfalso
        have hdT : d ∈ CL (M.take x) i := by rw [h]; simp
        have hcd : c < d := by
          have hs := cl_sorted (M.take x) i
          rw [h] at hs
          exact (List.pairwise_cons.mp (List.pairwise_append.mp hs).2.1).1 d (by simp)
        have hCc : ChgX M x true c := by
          apply ChgX.ov; by_contra hn; exact hvc ((chg_off hx hC hG hC' hRk' c hcx).2 hn)
        exact chg_last hx hR0 hZ2 hSD hZ1 hUAT hUAB hcc hCc d (cl_mem_children hdT) hcd
          (by unfold CL at hdT; simpa using (List.mem_filter.mp hdT).2)
    subst hR
    exact hVN i hi L c h hvc
end

-- copied from V3DropPres.sum_children_take_le
section
variable {M : Mat} {x : Nat} (hx : x + 1 = M.length)
  (hR0 : R0P M) (hZ2 : Z2 M) (hSD : SibDec M) (hZ1 : Z1C M) (hUAT : UAT M) (hUAB : UAB M)
  {ρ ρ' : Valn} {rk : Bool → Nat → Nat}
  (hC : Cons M ρ) (hG : Good3 M ρ) (hC' : Cons (M.take x) ρ') (hRk' : Rk (M.take x) rk)
  (hdrop : ∀ i, i < x → PO ρ ρ' i ∧ PV2 M ρ ρ' i)
include hx hR0 hZ2 hSD hZ1 hUAT hUAB hC hG hC' hRk' hdrop
/-- The sum of the children's values drops weakly. -/
theorem sum_children_take_le2 (j : Nat) :
    sumN ((children (M.take x) j).map ρ'.o) ≤ sumN ((children M j).map ρ.o) := by
  have hfx : ∀ d ∈ (children M j).filter (fun d => decide (d < x)), d < x := by
    intro d hd; rw [List.mem_filter] at hd; simpa using hd.2
  have hot' : ∀ t ∈ ((children M j).filter (fun d => decide (d < x))).map ρ'.o, isOT t = true := by
    intro t ht; obtain ⟨d, hd, rfl⟩ := List.mem_map.mp ht; exact (hdrop d (hfx d hd)).1.2.1
  have hot : ∀ t ∈ (children M j).map ρ.o, isOT t = true := by
    intro t ht; obtain ⟨d, hd, rfl⟩ := List.mem_map.mp ht; exact hG.ot_o d (mem_children hd).2
  have hle : sumN (((children M j).filter (fun d => decide (d < x))).map ρ'.o) ≤
      sumN (((children M j).filter (fun d => decide (d < x))).map ρ.o) :=
    sumN_le2 (forall2_map_le (fun d hd => (hdrop d (hfx d hd)).1.le)) hot'
      (fun t ht => hot t (by
        obtain ⟨d, hd, rfl⟩ := List.mem_map.mp ht
        exact List.mem_map_of_mem (List.mem_filter.mp hd).1))
  rw [children_take]
  by_cases hxj : x ∈ children M j
  · apply le_trans hle
    conv_rhs => rw [children_split_x hx hxj, List.map_append]
    apply le_sumN_append
    · intro t ht; obtain ⟨d, hd, rfl⟩ := List.mem_map.mp ht
      exact hG.ot_o d (mem_children (List.mem_filter.mp hd).1).2
    · intro t ht; simp at ht; rw [ht]; exact hG.ot_o x (by omega)
  · rw [children_filter_x hx hxj] at hle ⊢; exact hle
end

-- copied from V3DropPres.bumpTerm_take_le
section
variable {M : Mat} {x : Nat} (hx : x + 1 = M.length)
  (hR0 : R0P M) (hZ2 : Z2 M) (hSD : SibDec M) (hZ1 : Z1C M) (hUAT : UAT M) (hUAB : UAB M)
  {ρ ρ' : Valn} {rk : Bool → Nat → Nat}
  (hC : Cons M ρ) (hG : Good3 M ρ) (hC' : Cons (M.take x) ρ') (hRk' : Rk (M.take x) rk)
  (hdrop : ∀ i, i < x → PO ρ ρ' i ∧ PV2 M ρ ρ' i)
include hx hR0 hZ2 hSD hZ1 hUAT hUAB hC hG hC' hRk' hdrop
/-- **A bump term drops weakly.** -/
theorem bumpTerm_take_le2 {i j : Nat} (hi : i < x) (hj : j ∈ children (M.take x) i) :
    bumpTerm (M.take x) ρ' i j ≤ bumpTerm M ρ i j := by
  have hjx : j < x := by have := (mem_children hj).2; rw [lenT hx] at this; exact this
  unfold bumpTerm
  rw [col_take M hjx, bump_take M hi]
  split
  · apply omega_le_omega _ _ (sum_children_take_le2 hx hR0 hZ2 hSD hZ1 hUAT hUAB hC hG hC' hRk' hdrop j)
    · exact isOT_sumN _ (fun t ht => by
        obtain ⟨d, hd, rfl⟩ := List.mem_map.mp ht
        exact (hdrop d (by have := (mem_children hd).2; rw [lenT hx] at this; exact this)).1.2.1)
    · exact isOT_sumN _ (fun t ht => by
        obtain ⟨d, hd, rfl⟩ := List.mem_map.mp ht; exact hG.ot_o d (mem_children hd).2)
  · exact le_refl _
end

-- copied from V3DropPres.bumpKidsDec_take
section
variable {M : Mat} {x : Nat} (hx : x + 1 = M.length)
  (hR0 : R0P M) (hZ2 : Z2 M) (hSD : SibDec M) (hZ1 : Z1C M) (hUAT : UAT M) (hUAB : UAB M)
  {ρ ρ' : Valn} {rk : Bool → Nat → Nat}
  (hC : Cons M ρ) (hG : Good3 M ρ) (hC' : Cons (M.take x) ρ') (hRk' : Rk (M.take x) rk)
  (hdrop : ∀ i, i < x → PO ρ ρ' i ∧ PV2 M ρ ρ' i)
include hx hR0 hZ2 hSD hZ1 hUAT hUAB hC hG hC' hRk' hdrop
/-- **BumpKidsDec passes to `M.take x`.** -/
theorem bumpKidsDec_take2 (hKD : BumpKidsDec M ρ) : BumpKidsDec (M.take x) ρ' := by
  intro i h1 h2 j hj hjb
  have hi := lt_of_e1_take hx hR0 hZ2 hSD hZ1 hUAT hUAB hC hG hC' hRk' h1
  rw [entry_take M 1 hi] at h1
  rw [entry_take M 2 hi] at h2
  have hjM : j ∈ children M i := by rw [children_take, List.mem_filter] at hj; exact hj.1
  have hjx : j < x := by have := (mem_children hj).2; rw [lenT hx] at this; exact this
  rw [col_take M hjx, bump_take M hi] at hjb
  have hj2 : entry M 2 j ≠ 0 := by
    have : entry M 2 j = (col M j).2.2 := rfl
    rw [this, hjb]; simp [bump]
  have hP : (children (M.take x) j).Pairwise (fun d1 d2 => ρ.o d2 ≤ ρ.o d1) := by
    have := List.pairwise_map.mp (hKD i h1 h2 j hjM hjb)
    rw [children_take]; exact this.sublist (List.filter_sublist)
  apply List.pairwise_map.mpr
  refine ((hP.and (children_sorted (M.take x) j))).imp_of_mem ?_
  intro d1 d2 hd1 hd2 ⟨hle, hlt⟩
  have hd2x : d2 < x := by have := (mem_children hd2).2; rw [lenT hx] at this; exact this
  rw [o_same_before_e2 hx hR0 hZ2 hSD hZ1 hUAT hUAB hC hG hC' hRk' hj2 hd1 hd2 hlt]
  exact le_trans (hdrop d2 hd2x).1.le hle
end

-- copied from V3DropPres.bumpTermDec_take
section
variable {M : Mat} {x : Nat} (hx : x + 1 = M.length)
  (hR0 : R0P M) (hZ2 : Z2 M) (hSD : SibDec M) (hZ1 : Z1C M) (hUAT : UAT M) (hUAB : UAB M)
  {ρ ρ' : Valn} {rk : Bool → Nat → Nat}
  (hC : Cons M ρ) (hG : Good3 M ρ) (hC' : Cons (M.take x) ρ') (hRk' : Rk (M.take x) rk)
  (hdrop : ∀ i, i < x → PO ρ ρ' i ∧ PV2 M ρ ρ' i)
include hx hR0 hZ2 hSD hZ1 hUAT hUAB hC hG hC' hRk' hdrop
/-- **BumpTermDec passes to `M.take x`.** -/
theorem bumpTermDec_take2 (hTD : BumpTermDec M ρ) : BumpTermDec (M.take x) ρ' := by
  intro i h1 h2
  have hi := lt_of_e1_take hx hR0 hZ2 hSD hZ1 hUAT hUAB hC hG hC' hRk' h1
  rw [entry_take M 1 hi] at h1
  rw [entry_take M 2 hi] at h2
  have hP : (children (M.take x) i).Pairwise (fun j1 j2 => bumpTerm M ρ i j1 ≠ z →
      bumpTerm M ρ i j2 ≠ z → bumpTerm M ρ i j2 ≤ bumpTerm M ρ i j1) := by
    have := hTD i h1 h2
    unfold nzs at this
    rw [List.pairwise_filter, List.pairwise_map] at this
    rw [children_take]
    exact (this.sublist (List.filter_sublist)).imp (fun h a b => h (by simpa using a) (by simpa using b))
  unfold nzs
  rw [List.pairwise_filter, List.pairwise_map]
  refine ((hP.and (children_sorted (M.take x) i))).imp_of_mem ?_
  intro j1 j2 hj1 hj2 ⟨hle, hlt⟩ hz1 hz2
  have hz1' : bumpTerm (M.take x) ρ' i j1 ≠ z := by simpa using hz1
  have hz2' : bumpTerm (M.take x) ρ' i j2 ≠ z := by simpa using hz2
  have hj1x : j1 < x := by have := (mem_children hj1).2; rw [lenT hx] at this; exact this
  -- the earlier bump term does not change
  have he1 : bumpTerm (M.take x) ρ' i j1 = bumpTerm M ρ i j1 := by
    have hj2x : j2 < x := by have := (mem_children hj2).2; rw [lenT hx] at this; exact this
    have hpj2 : par M 0 j2 = some i := by
      rw [children_take, List.mem_filter] at hj2; exact (mem_children_iff.mp hj2.1).2
    have hpj1 : par M 0 j1 = some i := by
      rw [children_take, List.mem_filter] at hj1; exact (mem_children_iff.mp hj1.1).2
    have hkx : ∀ k ∈ children M j1, k < j2 := by
      intro k hk
      by_contra hkj
      have hA : Anc0 M j1 k := Anc0.step (mem_children_iff.mp hk).2 (Anc0.refl j1)
      have h1' := anc_between hA j2 (by omega) (by omega)
      have := (anc0_par h1' (by omega) hpj2).le
      have := par_lt M 0 j1 i hpj1; omega
    unfold bumpTerm
    rw [col_take M hj1x, bump_take M hi]
    split
    · have hch : children (M.take x) j1 = children M j1 := by
        rw [children_take, List.filter_eq_self]
        intro k hk; simp only [decide_eq_true_eq]; have := hkx k hk; omega
      rw [hch]
      congr 2
      apply List.map_congr_left
      intro k hk
      exact below_same_e2 hx hR0 hZ2 hSD hZ1 hUAT hUAB hC hG hC' hRk' h2 hj1 hj2 hlt
        (Anc0.step (mem_children_iff.mp hk).2 (Anc0.refl j1)) (by have := hkx k hk; omega)
    · rfl
  have hle2 := bumpTerm_take_le2 hx hR0 hZ2 hSD hZ1 hUAT hUAB hC hG hC' hRk' hdrop hi hj2
  have hz2M : bumpTerm M ρ i j2 ≠ z := by
    intro h; rw [h] at hle2; exact hz2' (le_antisymm hle2 (z_le _))
  rw [he1] at hz1' ⊢
  exact le_trans hle2 (hle hz1' hz2M)
end

-- copied from V3DropPres.drop_presD
section

/-- **`drop_pres` from the conclusion of the drop lemma** (2026-10-25): the value invariants of `N.take x` need only
`PO ∧ PV` at every column and `VSmallNew` (used for the grafted bad shape `Bad2`, where the hypotheses of the drop
lemma fail but its conclusion holds). -/
theorem drop_presD2 {N : Mat} {x : Nat} (hx : x + 1 = N.length)
    (hR0 : R0P N) (hZ2 : Z2 N) (hSD : SibDec N) (hZ1 : Z1C N) (hUAT : UAT N) (hUAB : UAB N)
    {σ σ' : Valn} {rk : Bool → Nat → Nat} (hC : Cons N σ) (hI : ValInv N σ)
    (hdrop : ∀ i, i < x → PO σ σ' i ∧ PV2 N σ σ' i) (hvst : VSmallNew N x σ σ')
    (hC' : Cons (N.take x) σ') (hRk' : Rk (N.take x) rk) : ValInv (N.take x) σ' :=
  ⟨good3_take2 hx hR0 hZ2 hSD hZ1 hUAT hUAB hC hI.g hC' hRk' hdrop,
    vsmallF_take2 hx hR0 hZ2 hSD hZ1 hUAT hUAB hC hI.g hC' hRk' hdrop hI.vs hvst,
    frameClosed_take2 hx hR0 hZ2 hSD hZ1 hUAT hUAB hC hI.g hC' hRk' hdrop hI.fc,
    frameOT_take hx hR0 hZ2 hSD hZ1 hUAT hUAB hC hI.g hC' hRk' hI.fo,
    bumpKidsDec_take2 hx hR0 hZ2 hSD hZ1 hUAT hUAB hC hI.g hC' hRk' hdrop hI.kd,
    bumpTermDec_take2 hx hR0 hZ2 hSD hZ1 hUAT hUAB hC hI.g hC' hRk' hdrop hI.td⟩
end

-- copied from V3FrameT1.t1_main_tp1G
section

/-- **`t = 1`, `q ≠ r`, all `n ≥ 2`**: `t1_main_val` with (W) replaced by the value invariant TP1. -/
theorem t1_main_tp1G2 {M : Mat} {r L d0 : Nat} (hlen : r + L + 1 = M.length) (hL : 0 < L)
    (hd0e : entry M 0 (r + L) = entry M 0 r + d0)
    (hR0 : R0P M) (hZ2 : Z2 M) (hSD : SibDec M) (hZ1 : Z1C M) (hUAT : UAT M) (hUAB : UAB M)
    (hR12 : R12 M) (hBE : BumpE2 M) (hR01 : R01 M) (h00 : entry M 0 0 = 0)
    (h1 : par M 1 (r + L) = some r) (hx2 : entry M 2 (r + L) = 0) (hqr : par M 0 (r + L) ≠ some r)
    {ρ : Valn} {rkM : Bool → Nat → Nat}
    (hC : Cons M ρ) (hG : Good3 M ρ) (hRM : Rk M rkM)
    (hVS : VSmallF M ρ) (hF : FrameClosed M ρ) (hFO : FrameOT M ρ) (hTP : TP1C M ρ)
    (hKD : BumpKidsDec M ρ) (hTD : BumpTermDec M ρ) (hdrop : ∀ i, i < r + L → PO ρ (drop1 M (r + L) rkM) i ∧ PV2 M ρ (drop1 M (r + L) rkM) i)
    (hne : (drop1 M (r + L) rkM).o r ≠ ρ.o r)
    {μ br vr : T} (hμr : μ = vr) (hro : ρ.o r = psi vr br z)
    (hV : ∀ m i, i < r + L → DepX M (r + L) false i →
      VLocal M (r + L) ρ (gamS μ br ((drop1 M (r + L) rkM).o r) m) μ i)
    (hLo : ∀ m i L' c R, i < r + L → DepX M (r + L) true i → children M i = L' ++ c :: R →
      DepX M (r + L) true c → ∀ s y, ρ.o c = psi s y z → lt (preState M ρ i L') y = true →
      lt (psi (ρ.v i) z z) (psi s y z) = true →
      ((split y (psi (succ s) z z)).2 ≠ z →
        fsD (split y (psi (succ s) z z)).2 (gamS μ br ((drop1 M (r + L) rkM).o r) m) ≠ z) ∧
      ((split y (psi (succ s) z z)).2 = z →
        (split (fsD y (gamS μ br ((drop1 M (r + L) rkM).o r) m)) (psi (succ s) z z)).2 = z))
    (hsM : ∀ i ∈ roots M, Single (ρ.o i)) (hpM : ((roots M).map ρ.o).Pairwise (fun a b => b ≤ a))
    (hG1 : Good3 (M.take (r + L)) (drop1 M (r + L) rkM))
    (Pn : Mat → Valn → Prop) (hP1 : Pn (M.take (r + L)) (drop1 M (r + L) rkM)) (hPs : ExpStepT1 Pn M r L d0 ρ) :
    ∀ n, 2 ≤ n → ∃ ρN rkN, Cons (TRIO.gexp M r L d0 0 n) ρN ∧ Rk (TRIO.gexp M r L d0 0 n) rkN ∧
      Good3 (TRIO.gexp M r L d0 0 n) ρN ∧ Pn (TRIO.gexp M r L d0 0 n) ρN ∧
      isOT (root (TRIO.gexp M r L d0 0 n) ρN) = true ∧ root (TRIO.gexp M r L d0 0 n) ρN < root M ρ := by
  have hA : Anc0 M r (r + L) := anc0_of_par M 1 r (r + L) h1
  have hrx : r < r + L := by omega
  have hrM : r < M.length := by omega
  have hvr : ρ.v r = vr := by
    obtain ⟨y0, hy0⟩ := o_psi_sub hC hrM
    rw [hro] at hy0; simp only [psi.injEq] at hy0
    rw [hy0.1, sf_ot (hG.ot_v r hrM)]
  have hF1 : ∀ i, r < i → i < r + L → DepX M (r + L) true i → ¬ DepX M (r + L) false i →
      lt μ (ρ.v i) = true := by
    intro i h2 h3 h4 h5
    rw [hμr, ← hvr]
    exact hF1_t1 hlen hR0 hZ2 hSD hZ1 hUAT hUAB h1 hC hG hRM i h2 h3 h4 h5
  have hox : ρ.o (r + L) = psi (succ μ) z z := by
    rw [o_last_t1 hlen hC hG h1 (by have := par1_entry_lt h1; omega) hx2, hvr, hμr]
  obtain ⟨q, hq⟩ := par0_of_anc hA (by omega)
  have hOS := hOS_t1 hlen hR0 hZ2 hSD hZ1 hUAT hUAB hx2 hq
  obtain ⟨hcb, hbr⟩ := hcb_t1 hlen hR0 hZ2 hSD hZ1 hUAT hUAB hC hG hox hF1 hOS (hV 0) h1 hx2 hqr
    hR12 hBE hro
  -- the seed
  have hcnt := hcnt_t1 hlen hR0 hZ2 hSD hZ1 hUAT
  have hRk1 : Rk (M.take (r + L)) rkM := rk_take (by omega) hRM hcnt
  have hC1 : Cons (M.take (r + L)) (drop1 M (r + L) rkM) := cons_of_rk hRk1
  have hpath := hpath_of_par1 h1 hA (by omega)
  have hv1 : (drop1 M (r + L) rkM).v r = μ := by
    rw [base_v_r hlen hR0 hZ2 hSD hZ1 hUAT hUAB hC hG hC1 hRk1 hA (by omega) hqr hpath, hvr, hμr]
  have hseed := seed_ge_one hlen hR0 hZ2 hSD hZ1 hUAB h1 hqr hC1 hv1
    (by rw [hμr, ← hvr]; exact hG.ot_v r hrM)
  have hW := hW_of_TP1 hlen hC hG hrx hA hro hcb hμr hbr hox hF1 hOS (hV 0)
    (hS2_t1 hR0 hA (by omega)) (hS3_t1 h1 hA (by omega) hlen hR0 hZ2 hSD hZ1) hTP hseed
  exact t1_main_valG2 hlen hL hd0e hR0 hZ2 hSD hZ1 hUAT hUAB hR12 hBE hR01 h00 h1 hx2 hqr hC hG hRM
    hVS hF hFO hKD hTD hdrop hne hμr hro hV hW hLo hsM hpM hG1 Pn hP1 hPs

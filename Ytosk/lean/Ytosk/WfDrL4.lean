      · rw [heq] at hu
        exact False.elim (child_upgrade_ne_next hx hZ1 hp hr2 hd hu)
      · by_cases hCk : ChgX M x false k
        · exact (no_anc_upg hx hR0 hZ2 hSD hZ1 hUAT hUAB

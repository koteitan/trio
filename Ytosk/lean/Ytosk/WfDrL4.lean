/-- **The base**: `M.take x` with the drop valuation (`frameMapT1_takeG2`). -/
theorem frameMapT1_take2 {M : Mat} {ρ ρ' : Valn} {rk : Bool → Nat → Nat} {r L : Nat} (S : SInv M)
    (hC : Cons M ρ) (hG : Good3 M ρ) (hC' : Cons (M.take (r + L)) ρ') (hRk' : Rk (M.take (r + L)) rk)
    (hlen : r + L + 1 = M.length) (hx2 : entry M 2 (r + L) = 0)
    (hdrop : ∀ i, i < r + L → PO ρ ρ' i ∧ PV2 M ρ ρ' i) (hUA : UpgAbsXW M (r + L) ρ) (h3 : NoBad3 M ρ) :
    FrameMapT1 M ρ r L (M.take (r + L)) ρ' ∧ VrDomQ M ρ r L (M.take (r + L)) ρ' :=
  frameMapT1_takeG2 S hC hG hC' hRk' hlen hx2 hdrop
    (fun k W hi hu hvk hWz => (hUA r k W hi hu hvk hWz).imp id (fun h => h.2.1)) (fun _ => Or.inl h3)
end


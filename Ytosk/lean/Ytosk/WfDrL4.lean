/-- **`t0_otdS` from the drop's conclusion and the seed facts** (no DropRes field). -/
theorem t0_otdG2 {M : Mat} {r L : Nat} (hlen : r + L + 1 = M.length) (hL : 0 < L)
    (hR0 : R0P M) (hZ2 : Z2 M) (hSD : SibDec M) (hZ1 : Z1C M) (hUAT : UAT M) (hUAB : UAB M)
    (hJ : RowJ M) (hBL : BumpLeaf M)
    (hR12 : R12 M) (hBE : BumpE2 M) (hR01 : R01 M) (h00 : entry M 0 0 = 0)
    (hp : par M 0 (r + L) = some r) (he1 : entry M 1 (r + L) = 0)
    {ρ : Valn} {rkM : Bool → Nat → Nat}
    (hC : Cons M ρ) (hG : Good3 M ρ) (hRM : Rk M rkM)
    (hVS : VSmallF M ρ) (hF : FrameClosed M ρ) (hFO : FrameOT M ρ)
    (hdrop0 : ∀ k, k < r + L → PO ρ (drop1 M (r + L) rkM) k ∧ PV2 M ρ (drop1 M (r + L) rkM) k)
    (hVT0 : ValInv (M.take (r + L)) (drop1 M (r + L) rkM))
    (hKD : BumpKidsDec M ρ) (hTD : BumpTermDec M ρ) (hAbsS : T0AbsW M r L ρ)
    (hSd : ∀ n, 2 ≤ n → ∀ σ, Cons (TRIO.gexp M r L 0 0 n) σ → T0SeedsN M ρ r L n σ)
    (hsM : ∀ i ∈ roots M, Single (ρ.o i)) (hpM : ((roots M).map ρ.o).Pairwise (fun a b => b ≤ a))
    (hLast : ∀ n, 2 ≤ n → ∀ g, par M 0 r = some g → Counted M g r →
      Counted (TRIO.gexp M r L 0 0 n) g (r + (n - 1) * L))
    (hVR : VSmallRP M (r + L) r ρ)
    (hPH : PH3cG M ρ)
    (hVchgRN : ∀ g, par M 0 r = some g → ∀ s' y', (drop1 M (r + L) rkM).o r = psi s' y' z → s' ≠ ρ.v r →
      ¬ psi (ρ.v r) z z < psi (succ (ρ.v g)) z z → ¬ psi s' z z < psi (succ (ρ.v g)) z z)
    (hG0N : ∀ n, 2 ≤ n → ∀ g, par M 0 r = some g →
      Counted M g r → (∀ k, k + 1 < n → ¬ Counted (TRIO.gexp M r L 0 0 n) g (r + k * L)) →
      ∀ Lc0 : List Nat, CL M g = Lc0 ++ [r] → ∀ s y, ρ.o r = psi s y z →
        ¬ (lt (spArg (ρ.v g) z (sumN (Lc0.map ρ.o))) y = true ∧ lt (psi (ρ.v g) z z) (psi s y z) = true)) :
    ∀ n, 2 ≤ n → ∀ σ, Cons (TRIO.gexp M r L 0 0 n) σ →
      ∀ i, i < r → (DepX M (r + L) true i → isOT (σ.o i) = true ∧ Lhd z (σ.o i) (ρ.o i) ∧ (∀ U : T → Prop, (∀ u, U u → PathLv M (r + L) r ρ i u) → RClaimU U ρ σ i) ∧
        (σ.v i ≠ ρ.v i → σ.o i = psi (σ.v i) z z) ∧
        (σ.v i = ρ.v i → ∀ X X', ρ.o i = psi (ρ.v i) X z → σ.o i = psi (ρ.v i) X' z → X' ≠ X → REr X X')) ∧
        (DepX M (r + L) false i → isOT (σ.v i) = true ∧ Lhd z (σ.v i) (ρ.v i)) := by
  intro n hn2 σ hCN
  have hn : 1 ≤ n := by omega
  have hx : r + L + 1 = M.length := hlen
  have hx2 : entry M 2 (r + L) = 0 := hR12 _ he1
  -- the drop `M.take x`
  have hcnt := hcnt_t1 hlen hR0 hZ2 hSD hZ1 hUAT
  have hRk1 : Rk (M.take (r + L)) rkM := rk_take (by omega) hRM hcnt
  set ρ' := drop1 M (r + L) rkM with hρ'
  have hC1 : Cons (M.take (r + L)) ρ' := cons_of_rk hRk1
  have hdrop := hdrop0
  have hoff := chg_off (show r + L + 1 = M.length from hlen) hC hG hC1 hRk1
  have hVT : ValInv (M.take (r + L)) ρ' := hVT0
  have hnx : ¬ DepX M (r + L) false (r + L) := not_depX_v_x he1
  have hD := dep_strict02 (by omega) hR0 hZ2 hSD hZ1 hUAT hUAB hC hG hC1 hRk1 hdrop hx2 hp hnx
  -- the expansion `N`
  set N := TRIO.gexp M r L 0 0 n with hNdef
  have hlN : N.length = r + n * L := lenN0 hlen hn
  have hnL : L ≤ n * L := Nat.le_mul_of_pos_left L hn
  have hnl : (n - 1) * L + L = n * L := by rw [← Nat.succ_mul]; congr 1; omega
  have hRN := rk_N0 hlen hL hp hn hR0 hZ2 hx2 hn2 hRM
  -- the values of `N`
  have hvC := t0_vals hlen hL hp hn hR0 hZ2 hSD hZ1 hUAT hUAB hx2 hn2 (depLike_chgX M (r + L))
    (read_not_chg hlen hL hp hR0 hZ2 hSD hZ1 hUAT hUAB) hC hG hC1
    (fun i hi h => (hoff i hi).2 h) hCN hRN
  have hvD := t0_vals hlen hL hp hn hR0 hZ2 hSD hZ1 hUAT hUAB hx2 hn2 (depLike_depX M (r + L))
    (read_not_dep hlen hL hp hR0 hZ2 hSD hZ1 hUAT hUAB) hC hG hC1
    (fun i hi h => (hoff i hi).2 h) hCN hRN
  have hoffD : ∀ i, i < r → (¬ DepX M (r + L) true i → σ.o i = ρ.o i) ∧
      (¬ DepX M (r + L) false i → σ.v i = ρ.v i) := by
    intro i hi
    have h := hvD i (by rw [hlN]; omega)
    exact ⟨fun hd => by rw [h.1 (fun h' => hd h'.2), tau_o_lt hi],
      fun hd => by rw [h.2 (fun h' => hd h'.2), tau_v_lt hi]⟩
  have hσB : ∀ i, r ≤ i → i < N.length → σ.o i = (tauN r L n ρ ρ' (omid M r L ρ)).o i :=
    fun i hri hiN => (hvC i hiN).1 (fun h => by omega)
  have hσmid : ∀ k, k + 1 < n → σ.o (r + k * L) = omid M r L ρ := by
    intro k hk
    have : k * L + L ≤ n * L := by
      have := Nat.mul_le_mul_right L (show k + 1 ≤ n by omega); rw [Nat.succ_mul] at this; exact this
    rw [hσB _ (by omega) (by rw [hlN]; omega)]
    exact tau_o_root hk hL
  have hσlast : σ.o (r + (n - 1) * L) = ρ'.o r := by
    rw [hσB _ (by omega) (by rw [hlN]; omega)]
    have := tau_o_last (r := r) (L := L) (n := n) (ρ := ρ) (ρ' := ρ') (oMid := omid M r L ρ) hL
    rwa [Nat.add_zero, Nat.add_zero] at this
  have hGT := good3_take2 (show r + L + 1 = M.length from hlen) hR0 hZ2 hSD hZ1 hUAT hUAB hC hG hC1 hRk1 hdrop
  obtain ⟨hor, hom⟩ := o_r_omid hlen hL hp hn hR0 hZ2 hSD hZ1 hUAT hUAB he1 hx2 hn2 hC hG
  -- roots, frames
  have hOXle : omid M r L ρ ≤ ρ.o r := by
    rw [hor, hom]; exact le_of_lt (psi_lt_psi_z_iff.mpr (Or.inr ⟨rfl, lt_app_one _⟩))
  have hlt0 : ρ'.o r < ρ.o r :=
    hD true r (depLike_r hlen hL hp hx2 (depLike_depX M (r + L))) (by omega)
  have hO'le : ρ'.o r ≤ omid M r L ρ := by
    obtain ⟨_, s', y', hs'⟩ := (hdrop r (by omega)).1.2
    have h := hlt0
    rw [hs', hor] at h
    rw [hs', hom]
    rcases psi_lt_psi_z_iff.mp h with h1 | ⟨rfl, h2⟩
    · exact le_of_lt (psi_lt_psi_z_iff.mpr (Or.inl h1))
    · exact psi_le_psi_arg ((lt_succ_iff (x := _)).mp h2)
  have hσBv : ∀ i, r ≤ i → i < N.length → σ.v i = (tauN r L n ρ ρ' (omid M r L ρ)).v i :=
    fun i hri hiN => (hvC i hiN).2 (fun h => by omega)
  have hFOT : FrameOT (M.take (r + L)) ρ' :=
    frameOT_take (show r + L + 1 = M.length from hlen) hR0 hZ2 hSD hZ1 hUAT hUAB hC hG hC1 hRk1 hFO
  by_cases hrg : ∃ g, par M 0 r = some g
  · obtain ⟨g, hg⟩ := hrg
    have hgr : g < r := par_lt M 0 r g hg
    have hrc : r ∈ children M g := mem_children_iff.mpr ⟨by omega, hg⟩
    have hxr : r + L ∈ children M r := mem_children_iff.mpr ⟨by omega, hp⟩
    -- the drop at `r`
    have hDr : DepX M (r + L) true r := depLike_r hlen hL hp hx2 (depLike_depX M (r + L))
    have hlt : ρ'.o r < ρ.o r := hD true r hDr (by omega)
    obtain ⟨hS1N, hS2, hS3⟩ := hSd n hn2 σ hCN g hg
    have hrT : r < (M.take (r + L)).length := by rw [List.length_take]; omega
    have hy' : ∀ s' y', ρ'.o r = psi s' y' z → s' ≠ ρ.v r → y' = z := by
      intro s' y' hs hne
      obtain ⟨y0, hy0⟩ := o_psi_sub hC1 hrT
      rw [hs] at hy0; simp only [psi.injEq] at hy0
      have hv'ot := (hdrop r (by omega)).2.2
      rw [sf_ot hv'ot] at hy0
      have hCv : ChgX M (r + L) false r := by
        by_contra hn'; apply hne; rw [hy0.1]; exact (hoff r (by omega)).2 hn'
      have hT := (chg_struct hx hR0 hZ2 hSD hZ1 hUAT hUAB hCv).1 rfl (by omega)
      have ho := o_of_no_counted hC1 hrT hv'ot hT.2.1
      rw [hs] at ho; simp only [psi.injEq] at ho; exact ho.2.1
    intro i hi
    have hdep := t0_dep_otS hlen hL hp hn hR0 hZ2 hSD hZ1 hUAT hUAB he1 hx2 hn2 hC hG hCN hg hRM hC1 hGT hσB hσBv
      hoffD hσmid hσlast hF hVS hVR hFO hTD hKD (hAbsS n hn2 σ hCN) hlt
      hS1N hy' (hLast n hn2 g hg) hS3 hS2
      hPH (hVchgRN g hg) (hG0N n hn2 g hg)
    refine ⟨fun hd => ?_, fun hd => ⟨(hdep false i hi).1, (hdep false i hi).2.1 hd⟩⟩
    obtain ⟨hot, hlt, hR, hRE⟩ := hdep true i hi
    refine ⟨hot, hlt hd, hR rfl hd, fun hne => ?_, hRE rfl hd⟩
    have hdv : DepX M (r + L) false i := by
      by_contra hn'; exact hne ((hoffD i hi).2 hn')
    exact o_N_noc' hlen hL hp hn hR0 hZ2 hSD hZ1 hUAT hUAB he1 hx2 hn2 hC hG hCN hi
      (cl_nil_of_depv' hlen hL hp hn hR0 hZ2 hSD hZ1 hUAT hUAB he1 hx2 hn2 hC hG hi hdv) (hdep false i hi).1
  · have hrn : par M 0 r = none := by
      cases h : par M 0 r with
      | none => rfl
      | some g => exact absurd ⟨g, h⟩ hrg
    intro i hi
    refine ⟨fun hd => ?_, fun hd => ?_⟩
    · have := nodep_G_root hlen hL hp hn hR0 hZ2 hSD hZ1 hUAT hUAB he1 hrn true i hd
      omega
    · have := nodep_G_root hlen hL hp hn hR0 hZ2 hSD hZ1 hUAT hUAB he1 hrn false i hd
      omega
end

-- copied from V3RootPath.o_lt_of_v_lt
section
variable {M : Mat} {x : Nat} (hx : x + 1 = M.length)
  (hR0 : R0P M) (hZ2 : Z2 M) (hSD : SibDec M) (hZ1 : Z1C M) (hUAT : UAT M) (hUAB : UAB M)
  {ρ ρ' : Valn} {rk : Bool → Nat → Nat}
  (hC : Cons M ρ) (hG : Good3 M ρ) (hC' : Cons (M.take x) ρ') (hRk' : Rk (M.take x) rk)
  (hdrop : ∀ i, i < x → PO ρ ρ' i ∧ PV2 M ρ ρ' i)
include hx hR0 hZ2 hSD hZ1 hUAT hUAB hC hG hC' hRk' hdrop
/-- **A strict `v` gives a strict `o`.** -/
theorem o_lt_of_v_lt2 {i : Nat} (hi : i < x) (h : ρ'.v i < ρ.v i) : ρ'.o i < ρ.o i := by
  have hiT : i < (M.take x).length := by rw [List.length_take]; omega
  have hiM : i < M.length := by omega
  obtain ⟨y', hy'⟩ := o_psi_sub hC' hiT
  obtain ⟨y, hy⟩ := o_psi_sub hC hiM
  rw [hy', hy, sf_ot (hdrop i hi).2.2, sf_ot (hG.ot_v i hiM)]
  exact psi_lt_psi_z_iff.mpr (Or.inl h)
end

-- copied from V3RootPath.v_strict_bumpT
section
variable {M : Mat} {x : Nat} (hx : x + 1 = M.length)
  (hR0 : R0P M) (hZ2 : Z2 M) (hSD : SibDec M) (hZ1 : Z1C M) (hUAT : UAT M) (hUAB : UAB M)
  {ρ ρ' : Valn} {rk : Bool → Nat → Nat}
  (hC : Cons M ρ) (hG : Good3 M ρ) (hC' : Cons (M.take x) ρ') (hRk' : Rk (M.take x) rk)
  (hdrop : ∀ i, i < x → PO ρ ρ' i ∧ PV2 M ρ ρ' i)
include hx hR0 hZ2 hSD hZ1 hUAT hUAB hC hG hC' hRk' hdrop
/-- **`v_strict_bump2` with trailing non-bump children** after `j`. -/
theorem v_strict_bumpT2 {i j k : Nat} (hi : i < x) (h1 : entry M 1 i ≠ 0) (h2 : entry M 2 i ≠ 0)
    {L K R : List Nat} (hch : children M i = L ++ [j] ++ R) (hjb : col M j = bump M i)
    (hR : ∀ e ∈ R, col M e ≠ bump M i)
    (hchj : children M j = K ++ [k]) (hLx : ∀ d ∈ L, ∀ e ∈ children M d, e < x)
    (hIH : k < x → ρ'.o k < ρ.o k) : ρ'.v i < ρ.v i := by
  have hlenT : (M.take x).length = x := by rw [List.length_take]; omega
  have hiT : i < (M.take x).length := by omega
  have hiM : i < M.length := by omega
  have hoff := chg_off hx hC hG hC' hRk'
  have hjM : j ∈ children M i := by rw [hch]; simp
  have hkM : k ∈ children M j := by rw [hchj]; simp
  have hij := (mem_children hjM).1
  have hjk := (mem_children hkM).1
  have hkl := (mem_children hkM).2
  have hjx : j < x := by omega
  have hV : vOpt ρ' (par (M.take x) 1 i) = vOpt ρ (par M 1 i) := by
    rw [par_take M 1 i hi]
    cases hp : par M 1 i with
    | none => rfl
    | some m =>
      show ρ'.v m = ρ.v m
      have hm := par_lt M 1 i m hp
      apply (hoff m (by omega)).2
      intro hCm
      exact (chg_struct hx hR0 hZ2 hSD hZ1 hUAT hUAB hCm).1 rfl (by omega) |>.2.2 i hi hp
  have hVot : isOT (vOpt ρ (par M 1 i)) = true := by
    cases hp : par M 1 i with
    | none => rfl
    | some m => exact hG.ot_v m (by have := par_lt M 1 i m hp; omega)
  have hLj : ∀ d ∈ L, d < j := (sib_order (children_sorted M i) (R := R) (by rw [hch]; simp)).1
  have hchT : children (M.take x) i = L ++ [j] ++ R.filter (fun d => decide (d < x)) := by
    rw [children_take, hch, List.filter_append, List.filter_append]
    congr 2
    · rw [List.filter_eq_self]
      intro d hd; have := hLj d hd; simp only [decide_eq_true_eq]; omega
    · simp [hjx]
  have hbtL : ∀ d ∈ L, bumpTerm (M.take x) ρ' i d = bumpTerm M ρ i d := by
    intro d hd
    have hdx : d < x := by have := hLj d hd; omega
    have hdM : d ∈ children M i := by rw [hch]; simp [hd]
    have hjT : j ∈ children (M.take x) i := by rw [hchT]; simp
    unfold bumpTerm
    rw [col_take M hdx, bump_take M hi]
    split
    · have hchd : children (M.take x) d = children M d := by
        rw [children_take, List.filter_eq_self]
        intro e he; simp only [decide_eq_true_eq]; exact hLx d hd e he
      rw [hchd]
      congr 2
      apply List.map_congr_left
      intro e he
      have hex := hLx d hd e he
      apply (hoff e hex).1
      intro hCe
      exact chg_only_last hx hR0 hZ2 hSD hZ1 hUAT hUAB h2 hdM hjT (hLj d hd) hCe
        (Anc0.step (mem_children_iff.mp he).2 (Anc0.refl d))
    · rfl
  have hbtR : ∀ t ∈ R.map (bumpTerm M ρ i), t = z := by
    intro t ht
    obtain ⟨e, he, rfl⟩ := List.mem_map.mp ht
    unfold bumpTerm; rw [if_neg (hR e he)]
  have hbtR' : ∀ t ∈ (R.filter (fun d => decide (d < x))).map (bumpTerm (M.take x) ρ' i), t = z := by
    intro t ht
    obtain ⟨e, he, rfl⟩ := List.mem_map.mp ht
    rw [List.mem_filter] at he
    have hex : e < x := by simpa using he.2
    unfold bumpTerm; rw [col_take M hex, bump_take M hi, if_neg (hR e he.1)]
  -- the bump term of `j` drops strictly (as in `v_strict_bump2`)
  set G := sumN (K.map ρ.o ++ [ρ.o k]) with hGdef
  have hKk : ∀ d ∈ K, d < k := (sib_order (children_sorted M j) (R := []) (by rw [hchj])).1
  have hKx : ∀ d ∈ K, d < x := fun d hd => by have := hKk d hd; omega
  have hKot : ∀ t ∈ K.map ρ.o, isOT t = true := by
    intro t ht; obtain ⟨d, hd, rfl⟩ := List.mem_map.mp ht; exact hG.ot_o d (by have := hKx d hd; omega)
  have hKot' : ∀ t ∈ K.map ρ'.o, isOT t = true := by
    intro t ht; obtain ⟨d, hd, rfl⟩ := List.mem_map.mp ht; exact (hdrop d (hKx d hd)).1.2.1
  have hKle : sumN (K.map ρ'.o) ≤ sumN (K.map ρ.o) :=
    sumN_le2 (forall2_map_le (fun d hd => (hdrop d (hKx d hd)).1.le)) hKot' hKot
  have hkot : isOT (ρ.o k) = true := hG.ot_o k hkl
  have hGot : isOT G = true := isOT_sumN _ (fun t ht => by
    rcases List.mem_append.mp ht with h | h
    · exact hKot t h
    · simp at h; rw [h]; exact hkot)
  obtain ⟨G', hG'ot, hG'lt, hbtj⟩ : ∃ G', isOT G' = true ∧ G' < G ∧
      bumpTerm (M.take x) ρ' i j = omega G' := by
    have hbt : bumpTerm (M.take x) ρ' i j = omega (sumN ((children (M.take x) j).map ρ'.o)) := by
      unfold bumpTerm; rw [col_take M hjx, bump_take M hi, if_pos hjb]
    rw [hbt]
    by_cases hkx : k < x
    · have hchjT : children (M.take x) j = K ++ [k] := by
        rw [children_take, hchj, List.filter_eq_self]
        intro d hd
        rcases List.mem_append.mp hd with h | h
        · simp only [decide_eq_true_eq]; exact hKx d h
        · simp at h; subst h; simp only [decide_eq_true_eq]; exact hkx
      have hk' : isOT (ρ'.o k) = true := (hdrop k hkx).1.2.1
      refine ⟨_, ?_, ?_, rfl⟩
      · rw [hchjT, List.map_append, List.map_singleton]
        exact isOT_sumN _ (fun t ht => by
          rcases List.mem_append.mp ht with h | h
          · exact hKot' t h
          · simp at h; rw [h]; exact hk')
      · rw [hchjT, List.map_append, List.map_singleton]
        exact sumN_snoc_lt hKot' hKot hk' hkot hKle (hIH hkx)
    · have hkx' : k = x := by omega
      have hchjT : children (M.take x) j = K := by
        rw [children_take, hchj, List.filter_append, List.filter_eq_self.mpr
          (fun d hd => by simp only [decide_eq_true_eq]; exact hKx d hd)]
        simp [hkx']
      refine ⟨_, ?_, ?_, rfl⟩
      · rw [hchjT]; exact isOT_sumN _ hKot'
      · rw [hchjT]
        exact sumN_lt_snoc hKot hkot hKle (by
          obtain ⟨s0, y0, h0⟩ := o_psi_form hC hkl; rw [h0]; exact T.z_lt_psi _ _ _)
  -- assemble
  set Pl := one :: L.map (bumpTerm M ρ i) with hPl
  have hPlot : ∀ t ∈ Pl, isOT t = true := by
    intro t ht
    rcases List.mem_cons.mp ht with rfl | ht
    · rfl
    · obtain ⟨d, _, rfl⟩ := List.mem_map.mp ht; exact isOT_bumpTerm hG i d
  have hbtjM : bumpTerm M ρ i j = omega G := by
    unfold bumpTerm; rw [if_pos hjb, hchj, List.map_append, List.map_singleton]
  have hPGot : ∀ t ∈ Pl ++ [omega G], isOT t = true := fun t ht => by
    rcases List.mem_append.mp ht with h | h
    · exact hPlot t h
    · simp at h; rw [h]; exact isOT_omega hGot
  have hPG'ot : ∀ t ∈ Pl ++ [omega G'], isOT t = true := fun t ht => by
    rcases List.mem_append.mp ht with h | h
    · exact hPlot t h
    · simp at h; rw [h]; exact isOT_omega hG'ot
  have hvM : ρ.v i = sf (add (vOpt ρ (par M 1 i)) (omega (sumN (Pl ++ [omega G])))) := by
    rw [(hC i hiM).2]; unfold vRhs
    rw [if_neg h1, if_neg h2, hch, List.map_append, List.map_append, List.map_singleton, hbtjM,
      ← List.cons_append, ← List.cons_append, sumN_append_zs hPGot _ hbtR]
  have hvT : ρ'.v i = sf (add (vOpt ρ (par M 1 i)) (omega (sumN (Pl ++ [omega G'])))) := by
    rw [(hC' i hiT).2]; unfold vRhs
    rw [entry_take M 1 hi, entry_take M 2 hi, if_neg h1, if_neg h2, hV, hchT, List.map_append, List.map_append,
      List.map_singleton, hbtj, List.map_congr_left hbtL, ← List.cons_append, ← List.cons_append,
      sumN_append_zs hPG'ot _ hbtR']
  have hP'ot : isOT (sumN (Pl ++ [omega G'])) = true := isOT_sumN _ hPG'ot
  have hPot : isOT (sumN (Pl ++ [omega G])) = true := isOT_sumN _ hPGot
  have hP : sumN (Pl ++ [omega G']) < sumN (Pl ++ [omega G]) :=
    sumN_snoc_lt hPlot hPlot (isOT_omega hG'ot) (isOT_omega hGot) (le_refl _)
      (omega_lt_omega hG'ot hGot hG'lt)
  rw [hvM, hvT, sf_ot (isOT_add hVot (isOT_omega hP'ot)), sf_ot (isOT_add hVot (isOT_omega hPot))]
  exact add_lt_add_left _ (omega_lt_omega hP'ot hPot hP)
end

-- copied from V3RootPath.v_strict_supx
section
variable {M : Mat} {x : Nat} (hx : x + 1 = M.length)
  (hR0 : R0P M) (hZ2 : Z2 M) (hSD : SibDec M) (hZ1 : Z1C M) (hUAT : UAT M) (hUAB : UAB M)
  {ρ ρ' : Valn} {rk : Bool → Nat → Nat}
  (hC : Cons M ρ) (hG : Good3 M ρ) (hC' : Cons (M.take x) ρ') (hRk' : Rk (M.take x) rk)
  (hdrop : ∀ i, i < x → PO ρ ρ' i ∧ PV2 M ρ ρ' i)
include hx hR0 hZ2 hSD hZ1 hUAT hUAB hC hG hC' hRk' hdrop
/-- **`x − 1` loses its upgrade to `x`**: `v(x − 1) = v(x) = V + ω` and `v′(x − 1) = V + 1`. -/
theorem v_strict_supx2 (hu : upg M (x - 1) = some x) : ρ'.v (x - 1) < ρ.v (x - 1) := by
  have hx1 : 0 < x := by have := upg_succ_lt hu; omega
  have hiM : x - 1 < M.length := by omega
  have hxM : x < M.length := by omega
  obtain ⟨he1, he2'⟩ := upg_e12 hu
  have he2 : entry M 2 (x - 1) = 0 := by have := hZ2 (x - 1); omega
  obtain ⟨m, hm1, hm2, hcol, _⟩ := upg_spec hu
  have hVot : isOT (vOpt ρ (par M 1 (x - 1))) = true := by
    rw [hm1]; exact hG.ot_v m (by have := par_lt M 1 (x - 1) m hm1; omega)
  have hxc : children M x = [] := by
    rw [List.eq_nil_iff_forall_not_mem]
    intro c hc; have := mem_children hc; omega
  have ev : ρ.v (x - 1) = ρ.v x :=
    v_upg_eq hC hiM he1 he2 hu hVot (fun _ hj _ _ _ => by rw [hxc] at hj; simp at hj)
  have hx1e : entry M 1 x ≠ 0 := by
    have : entry M 1 x = (col M x).2.1 := rfl
    rw [this, hcol]; exact he1
  have hx2e : entry M 2 x ≠ 0 := by have := upg_target_e2 hu; omega
  have evx : ρ.v x = add (vOpt ρ (par M 1 (x - 1))) (psi z one z) := by
    rw [(hC x hxM).2]; unfold vRhs
    rw [if_neg hx1e, if_neg hx2e, hxc, hm2, ← hm1]
    simp only [List.map_nil]
    rw [sumN_singleton (t := one) ⟨rfl, z, z, rfl⟩, omega_small one_lt_E0]
    exact sf_ot (isOT_add hVot rfl)
  have ev' := v_last_take (x := x) hx hR0 hZ2 hSD hZ1 hUAT hUAB hC hG hC' hRk' (r := x - 1) (by omega) he1 he2
  rw [sf_ot (isOT_add hVot isOT_one)] at ev'
  rw [ev', ev, evx]
  exact add_lt_add_left _ (psi_lt_psi_z_iff.mpr (Or.inr ⟨rfl, T.z_lt_psi _ _ _⟩))
end


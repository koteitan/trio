/-- The seed trigger of Inv3V2, without the false global TrigOmC. -/
theorem qr_final4SG2 {M : Mat} {r L d0 : Nat} (hlen : r + L + 1 = M.length) (hL : 0 < L)
    (hd0e : entry M 0 (r + L) = entry M 0 r + d0)

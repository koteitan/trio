      have hkx : k < x := by have := upg_lt hiT huT; rw [hlenT] at this; exact this
      have ek' : ρ'.v d = ρ'.v k := v_upg_eq hC' hiT
        (by rw [entry_take M 1 hdx]; exact h1) (by rw [entry_take M 2 hdx]; exact hd2)

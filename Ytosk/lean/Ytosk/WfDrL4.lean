  (hC : Cons M ρ) (hG : Good3 M ρ) (hC' : Cons (M.take x) ρ') (hRk' : Rk (M.take x) rk)
  (hdrop : ∀ i, i < x → PO ρ ρ' i ∧ PV2 M ρ ρ' i)
include hx hR0 hZ2 hSD hZ1 hUAT hUAB hXu hXb hC hG hC' hRk' hdrop
/-- **`D` drops strictly** when no column upgrades to `x` and `x` is not a bump child (`dep_strict02` with the shape
lemmas `hOS_t1X`・`dv_shapeX`). -/
theorem dep_strict0X2 {q : Nat} (hq : par M 0 x = some q) :
    ∀ b i, DepX M x b i → i < x → valB ρ' b i < valB ρ b i := by
  have hlenT : (M.take x).length = x := by rw [List.length_take]; omega
  intro b i hD
  induction hD with
  | leaf => intro h; exact absurd h (lt_irrefl _)
  | @ochild i c hc hcb hcu hdc ih =>
    intro hi
    show ρ'.o i < ρ.o i
    rcases hOS_t1X hx hR0 hZ2 hSD hZ1 hUAT hUAB hXu hXb hq i hi (DepX.ochild hc hcb hcu hdc) with
      ⟨_, hnc⟩ | ⟨_, L, c0, R, hch, _, _, hR, hLnd⟩
    · exfalso
      rcases hnc c hc with h | h
      · exact hcb h
      · exact hcu h
    · have hcnt : Counted M i c := ⟨hcb, hcu⟩
      have hcR : ∀ d ∈ R, ¬ Counted M i d := fun d h hd => by
        rcases hR d h with h' | h'
        · exact hd.1 h'
        · exact hd.2 h'
      have hcCL : c ∈ CL M i := by
        unfold CL; exact List.mem_filter.mpr ⟨hc, by simpa using hcnt⟩
      obtain ⟨hL, hRo⟩ := sib_order (children_sorted M i) hch
      have hcc0 : c = c0 := by
        rw [hch] at hc
        rcases List.mem_append.mp hc with h | h
        · exact absurd hdc (hLnd c h hcnt)
        · rcases List.mem_cons.mp h with h | h
          · exact h
          · exact absurd hcnt (hcR c h)
      subst hcc0
      apply o_strict_frame2 hx hR0 hZ2 hSD hZ1 hUAT hUAB hC hG hC' hRk' hdrop hi hcCL
      · intro d hd
        have hdc : d ∈ children M i := (List.mem_filter.mp hd).1
        have hdcnt : Counted M i d := by simpa using (List.mem_filter.mp hd).2
        rw [hch] at hdc
        rcases List.mem_append.mp hdc with h | h
        · exact le_of_lt (hL d h)
        · rcases List.mem_cons.mp h with h | h
          · rw [h]
          · exact absurd hdcnt (hcR d h)
      · exact ih
  | @ov i hv ih =>
    intro hi
    show ρ'.o i < ρ.o i
    have hiT : i < (M.take x).length := by omega
    have hiM : i < M.length := by omega
    have hT := (chg_struct hx hR0 hZ2 hSD hZ1 hUAT hUAB (depX_chgX hv)).1 rfl hi
    have hvlt : ρ'.v i < ρ.v i := ih hi
    rw [o_of_no_counted hC' hiT (hdrop i hi).2.2 hT.2.1, o_cl_eq hC hG hiM]
    exact psi_lt_psi_z_iff.mpr (Or.inl hvlt)
  | @vpar i m h1 hp hdm _ =>
    intro hi
    exfalso
    have hm := par_lt M 1 i m hp
    exact (chg_struct hx hR0 hZ2 hSD hZ1 hUAT hUAB (depX_chgX hdm)).1 rfl (by omega) |>.2.2 i hi hp
  | @vupg i k h1 h2 hu hdk ih =>
    intro hi
    show ρ'.v i < ρ.v i
    have hiM : i < M.length := by omega
    have hiT : i < (M.take x).length := by omega
    have hkl := upg_lt hiM hu
    have hkx : k < x := by
      rcases Nat.lt_or_ge k x with h | h
      · exact h
      · exfalso
        have : k = x := by omega
        subst this; exact hXu i hu
    have hT := (chg_struct hx hR0 hZ2 hSD hZ1 hUAT hUAB (depX_chgX hdk)).1 rfl hkx
    obtain ⟨m, hm1, _, _, hcase⟩ := upg_spec hu
    have hik : k = i + 1 := by
      rcases hcase with h | ⟨hA, hki⟩
      · exact h
      · exact (no_anc_upg hx hR0 hZ2 hSD hZ1 hUAT hUAB hT hkx hu hA hki).elim
    have hi1 : i + 1 < x := by omega
    have hmi := par_lt M 1 i m hm1
    have huT : upg (M.take x) i = some k := by rw [upg_take M hi1]; exact hu
    have hVot : isOT (vOpt ρ (par M 1 i)) = true := by
      rw [hm1]; exact hG.ot_v m (by omega)
    have ek : ρ.v i = ρ.v k :=
      v_upg_eq hC hiM h1 h2 hu hVot (fun _ _ _ k' hk' => hG.ot_o k' (mem_children hk').2)
    have ek' : ρ'.v i = ρ'.v k := v_upg_eq hC' hiT (by rw [entry_take M 1 hi]; exact h1)
      (by rw [entry_take M 2 hi]; exact h2) huT
      (by rw [par_take M 1 i hi, hm1]; exact (hdrop m (by omega)).2.2)
      (fun _ _ _ k' hk' => (hdrop k' (by have := (mem_children hk').2; omega)).1.2.1)
    rw [ek, ek']
    exact ih hkx
  | @vbump i j k h1 h2 hj hjb hk hdk ih =>
    intro hi
    show ρ'.v i < ρ.v i
    obtain ⟨_, _, hcase⟩ := dv_shapeX hx hR0 hZ2 hSD hZ1 hUAT hUAB hXu hXb hq hi (DepX.vbump h1 h2 hj hjb hk hdk)
    rcases hcase with ⟨h2', _⟩ | ⟨_, L, K, j', k', hch, _, hchj, _, hKnd, hLnd⟩
    · exact absurd h2' h2
    · have hjj : j = j' := by
        rw [hch] at hj
        rcases List.mem_append.mp hj with h | h
        · exact absurd hdk (hLnd j h k hk).2
        · exact List.mem_singleton.mp h
      subst hjj
      have hkk : k = k' := by
        rw [hchj] at hk
        rcases List.mem_append.mp hk with h | h
        · exact absurd hdk (hKnd k h)
        · exact List.mem_singleton.mp h
      subst hkk
      exact v_strict_bump2 hx hR0 hZ2 hSD hZ1 hUAT hUAB hC hG hC' hRk' hdrop hi h1 h2 hch hjb hchj
        (fun d hd e he => (hLnd d hd e he).1) ih
end

-- copied from V3T2QUBad.t2_qu_take_bad
section
variable {M : Mat} {r L : Nat} (hlen : r + L + 1 = M.length) (hL : 0 < L)
  (hp : par M 0 (r + L) = some r) (hXb : col M (r + L) ≠ bump M r)
include hlen hL hp hXb
/-- **`t = 2`, `q = r`, `x − 1` upgrades to `k < x`, `n ≤ 1`, the strong absorption may fail**
(`M[n] = M.take x`): the weak calls are `o(x − 1)` and `v(x − 1)`, the seeds `o(r)` (when `r ≠ x − 1`) and
`o(pr)`, `pr` the parent of `x − 1`. -/
theorem t2_qu_take_bad2 (hBE : BumpE2 M) (hZ2 : Z2 M) (hUAT : UAT M) (hR12 : R12 M) (hR01 : R01 M)
    (h00 : entry M 0 0 = 0) (he2r : entry M 2 r = 0)
    (hrb : ∀ p, par M 0 r = some p → col M r ≠ bump M p) (hrCL : CL M r ≠ [])
    (hrU : isUpg M r = false) {k : Nat} (hu : upg M (r + L - 1) = some k) (hkx : k < r + L)
    (hkT : topped M k = false)
    -- the shape of `D` in `M`
    (hP1 : ∀ m, par M 1 (r + L - 1) = some m → ¬ DepS M (SV r (r + L - 1)) false m)
    (hDvNil : ∀ c, c < r + L → c ≠ r → DepS M (SV r (r + L - 1)) false c → CL M c = [])
    (hvr : r ≠ r + L - 1 → ¬ DepS M (SV r (r + L - 1)) false r)
    (hOS : ∀ i, i < r + L → ¬ SV r (r + L - 1) true i →
      DepS M (SV r (r + L - 1)) true i → ¬ DepS M (SV r (r + L - 1)) false i →
      ∃ Lp c R, children M i = Lp ++ c :: R ∧ Counted M i c ∧ DepS M (SV r (r + L - 1)) true c ∧
        (∀ d ∈ R, ¬ Counted M i d) ∧ (∀ d ∈ Lp, Counted M i d → ¬ DepS M (SV r (r + L - 1)) true d))
    (hVSh : ∀ i, i < r + L → ¬ SV r (r + L - 1) false i → DepS M (SV r (r + L - 1)) false i →
      (∀ m, par M 1 i = some m → ¬ DepS M (SV r (r + L - 1)) false m) ∧
      (entry M 2 i ≠ 0 → ∃ Lb Kb j k, children M i = Lb ++ [j] ∧ col M j = bump M i ∧
        children M j = Kb ++ [k] ∧ (∀ d ∈ Kb, ¬ DepS M (SV r (r + L - 1)) true d) ∧
        (∀ d ∈ Lb, ∀ e ∈ children M d, ¬ DepS M (SV r (r + L - 1)) true e)))
    -- values
    {ρ σ : Valn} {rkM rkN : Bool → Nat → Nat}
    (hC : Cons M ρ) (hG : Good3 M ρ) (hRM : Rk M rkM)
    (hCN : Cons (M.take (r + L)) σ) (hGN : Good3 (M.take (r + L)) σ) (hRN : Rk (M.take (r + L)) rkN)
    (hF : FrameClosed M ρ) (hVS : VSmallF M ρ) (hTD : BumpTermDec M ρ) (hKD : BumpKidsDec M ρ)
    (hAbs : AbsWN M (M.take (r + L)) (r + L) ρ σ)
    (hseed : r ≠ r + L - 1 → Lhd z (σ.o r) (ρ.o r))
    -- the bad case: the parent `pr` of `x − 1` is not a bump child, and the drop lemma
    {pr : Nat} (hpr : par M 0 (r + L - 1) = some pr)
    (hpb : ∀ g, par M 0 pr = some g → col M pr ≠ bump M g) (hxCL : r = r + L - 1 → r + L ∈ CL M r)
    (hR0 : R0P M) (hSD : SibDec M) (hZ1 : Z1C M) (hUAB : UAB M)
    (hdrop : ∀ i, i < r + L → PO ρ σ i ∧ PV2 M ρ σ i) (h3 : NoBad3 M ρ) :
    isOT (root (M.take (r + L)) σ) = true ∧ root (M.take (r + L)) σ < root M ρ := by
  have hlT : (M.take (r + L)).length = r + L := by rw [List.length_take]; omega
  have hA : Anc0 M r (r + L) := anc0_of_par M 0 r (r + L) hp
  have hxc : ∀ i c, c ∈ children M i → r + L ≤ c → c = r + L ∧ i = r := by
    intro i c hc hcx
    have := (mem_children hc).2
    have hcx' : c = r + L := by omega
    refine ⟨hcx', ?_⟩
    have h' := (mem_children_iff.mp hc).2; rw [hcx', hp] at h'; exact (Option.some.inj h').symm
  have hchN : ∀ i, i < r + L → i ≠ r → children (M.take (r + L)) i = children M i := by
    intro i _ hir
    rw [children_take, children_filter_x hlen (fun h => hir (hxc i (r + L) h (le_refl _)).2)]
  have hkr : k ≠ r := by
    intro h; have := upg_target_e2 hu; rw [h] at this; omega
  have hcnt : ∀ i c, i < r + L → c < r + L → (Counted (M.take (r + L)) i c ↔ Counted M i c) := by
    intro i c hi hc
    by_cases hcr : c = r
    · subst hcr
      unfold Counted
      rw [col_take M hc, bump_take M hi, isUpg_take_eq hlen (by
        rw [hu]; intro h; exact hkr (Option.some.inj h)) hc, hrU]
      simp
    · by_cases hck : c = k
      · subst hck
        unfold Counted
        rw [col_take M hc, bump_take M hi,
          topped_take_eq hlen hc (fun h => hcr (hxc c (r + L) h (le_refl _)).2), hkT]
        simp
      · by_contra h
        rcases cnt_change hlen hi hc h with h' | h'
        · exact hcr (hxc c (r + L) h' (le_refl _)).2
        · rw [hu] at h'; cases h'; exact hck rfl
  have hRD : ∀ R, R < r + L → Anc0 M R (r + L) → col M R = (0, 0, 0) →
      DepS M (SV r (r + L - 1)) true R ∧ ¬ (fun _ _ => False : Bool → Nat → Prop) true R := by
    intro R hR hRA _
    have hRr : Anc0 M R r := anc0_par hRA (by omega) hp
    refine ⟨?_, id⟩
    apply path_upS hUAT hZ2 hR12 hBE (r - R) R r (le_refl _) (by omega) hRr (ne_of_e2z he2r)
      (DepS.seed (Or.inl ⟨rfl, rfl⟩))
    intro t _ htr
    have := htr.le
    exact ⟨r + L, by omega, hA, not_anc_out (by omega) (by omega)⟩
  have hCLnil : ∀ c, c < r + L → ¬ (fun _ _ => False : Bool → Nat → Prop) true c → CL M c = [] →
      CL (M.take (r + L)) c = [] := by
    intro c hc _ hcl
    by_cases hcr : c = r
    · exact (hrCL (by rw [← hcr]; exact hcl)).elim
    · unfold CL at hcl ⊢
      rw [hchN c hc hcr, ← hcl]
      apply List.filter_congr
      intro d hd
      have hdx : d < r + L := by
        have := (mem_children hd).2
        by_contra h'
        exact hcr (hxc c d hd (by omega)).2
      simp only [hcnt c d hc hdx]
  set j := r + L - 1 with hj
  have hjx : j < r + L := by omega
  have hprj : pr < j := par_lt M 0 j pr hpr
  have hjch : j ∈ children M pr := mem_children_iff.mpr ⟨by omega, hpr⟩
  have he2j : entry M 2 j = 0 := by have := hZ2 j; have := (upg_e12 hu).2; omega
  have hjcb : col M j ≠ bump M pr := fun h => by
    have := e2_of_col (show col M j = (entry M 0 pr + 1, entry M 1 pr, 1) from h); omega
  have hjU : ∀ j', upg M j' ≠ some j := fun j' h => by have := upg_target_e2 h; omega
  have hjcu : ¬ (isUpg M j = true ∧ topped M j = true) := by
    rintro ⟨h, _⟩
    unfold isUpg at h
    obtain ⟨k', _, hk'⟩ := List.any_eq_true.mp h
    exact hjU k' (of_decide_eq_true hk')
  have hcntj : Counted M pr j := ⟨hjcb, hjcu⟩
  have hjCLp : j ∈ CL M pr := by
    unfold CL; rw [List.mem_filter]; exact ⟨hjch, by simpa using hcntj⟩
  -- `D` from the new seeds is `D` from `SV r j`
  have hconv : ∀ {b i}, DepS M (SVp r j pr) b i → DepS M (SV r j) b i := by
    intro b i h
    induction h with
    | seed hs =>
      rcases hs with hs | ⟨rfl, rfl⟩
      · exact DepS.seed hs
      · exact DepS.ochild hjch hjcb hjcu (DepS.ov (DepS.seed (Or.inr ⟨rfl, rfl⟩)))
    | ochild hc hcb hcu _ ih => exact DepS.ochild hc hcb hcu ih
    | ov _ ih => exact DepS.ov ih
    | vpar h1 hpm _ ih => exact DepS.vpar h1 hpm ih
    | vupg h1 h2 hu _ ih => exact DepS.vupg h1 h2 hu ih
    | vbump h1 h2 hj hjb hk _ ih => exact DepS.vbump h1 h2 hj hjb hk ih
  have hmono : ∀ {b i}, DepS M (SV r j) b i → DepS M (SVp r j pr) b i :=
    fun h => DepS.mono (fun _ _ hs => Or.inl hs) h
  set Wj : Bool → Nat → Prop := fun _ i => i = j with hWj
  exact t2_assemble2 (S := SVp r j pr) (W := Wj) (bnd := r + L) (p := r) hC hG hRM
    hCN hGN hRN hF hVS hTD hKD hR01 hR12 h00 hlen (by rw [hlT]) (fun i hi hir => hchN i hi hir)
    (Or.inl (Or.inl (Or.inl ⟨rfl, rfl⟩))) (Or.inl he2r) (fun i hr hb => hrb i (mem_children_iff.mp hr).2 hb)
    (fun y i hi => entry_take M y hi) (fun i hi => par_take M 1 i hi)
    (fun i hi hs => by
      rcases Nat.lt_or_ge (i + 1) (r + L) with h | h
      · exact upg_take M h
      · exact absurd (Or.inl (Or.inr ⟨rfl, by omega⟩)) hs)
    (fun i c hi _ _ hcx => hcnt i c hi hcx)
    (fun i c hi hc hcx => by obtain ⟨_, rfl⟩ := hxc i c hc hcx; exact Or.inl (Or.inl (Or.inl ⟨rfl, rfl⟩)))
    (fun i k hi hk hkx => by
      obtain ⟨_, _, _, _, hcase⟩ := upg_spec hk
      exact Or.inl (Or.inr ⟨rfl, by rcases hcase with h | ⟨_, h⟩ <;> omega⟩))
    (fun i j hi hj hjx _ => by have := (mem_children hj).2; rw [hlT] at this; omega)
    (fun i j hi hj hjx hjb => by
      obtain ⟨hjx', hir⟩ := hxc i j hj hjx
      rw [hjx', hir] at hjb; exact absurd hjb hXb)
    (fun i j k hi hj hjx hjb hk hkx => by
      obtain ⟨_, hjr⟩ := hxc j k hk hkx
      rw [hjr] at hj hjb
      exact absurd hjb (hrb i (mem_children_iff.mp hj).2))
    (fun j hj0 hj => by rw [hlT] at hj; omega)
    (by have := anc0_e0_lt hA (by omega); omega)
    -- the weak calls `o(j)`, `v(j)`
    (fun i (h : i = j) => by subst h; exact DepS.ov (DepS.seed (Or.inl (Or.inr ⟨rfl, rfl⟩))))
    (fun i (h : i = j) => ⟨h, fun j' hj' => by rw [h] at hj'; exact hjU j' hj'⟩)
    (fun i c hc _ (hw : c = j) => by
      subst hw
      have h1 := (mem_children_iff.mp hc).2; rw [hpr] at h1; cases h1
      exact Or.inr ⟨rfl, rfl⟩)
    (fun i jj c _ _ hj hjb hc (hw : c = j) => by
      subst hw
      have h1 := (mem_children_iff.mp hc).2; rw [hpr] at h1; cases h1
      exact absurd hjb (hpb i (mem_children_iff.mp hj).2))
    (fun c hc hw hs hd => by
      have hcr : c ≠ r := fun h => hs (Or.inl (Or.inl ⟨rfl, h⟩))
      exact hDvNil c hc hcr (hconv hd))
    (fun c hc (hw : ¬ c = j) hs hd => by
      rcases hs with (⟨_, hcr⟩ | ⟨h, _⟩) | ⟨_, hcp⟩
      · subst hcr
        exact absurd (hconv hd) (hvr hw)
      · cases h
      · subst hcp
        by_cases hpr' : c = r
        · subst hpr'; exact absurd (hconv hd) (hvr hw)
        · have := hDvNil c hc hpr' (hconv hd)
          rw [this] at hjCLp; simp at hjCLp)
    (fun c hc _ hcl => hCLnil c hc id hcl)
    (fun i hi hns hnw hD hv => by
      obtain ⟨Lp, c, R, h1, h2, h3, h4, h5⟩ :=
        hOS i hi (fun h => hns (Or.inl h)) (hconv hD) (fun h => hv (hmono h))
      exact ⟨Lp, c, R, h1, h2, hmono h3, h4, fun d hd hc' hdD => h5 d hd hc' (hconv hdD)⟩)
    (fun i hi hns hD => by
      obtain ⟨h1, h2⟩ := hVSh i hi (fun h => hns (Or.inl h)) (hconv hD)
      refine ⟨fun m hm hdm => h1 m hm (hconv hdm), fun he => ?_⟩
      obtain ⟨Lb, Kb, j, k, a1, a2, a3, a4, a5⟩ := h2 he
      exact ⟨Lb, Kb, j, k, a1, a2, a3, fun d hd hdD => a4 d hd (hconv hdD),
        fun d hd e he' hdD => a5 d hd e he' (hconv hdD)⟩)
    (fun R hR hRA hR0c => by
      refine ⟨hmono (hRD R hR hRA hR0c).1, fun (hw : R = j) => ?_⟩
      subst hw
      have := anc0_e0_lt (anc0_of_par M 0 pr _ hpr) (by omega)
      rw [col_eq_entries] at hR0c; simp only [Prod.mk.injEq] at hR0c; omega)
    (fun i hi (hw : i = j) => by subst hw; exact (hdrop _ hi).1.le)
    hAbs
    (fun b i hs (hw : ¬ i = j) hi _ hoff _ => by
      rcases hs with (⟨hb, hir⟩ | ⟨_, hij⟩) | ⟨hb, hip⟩
      · subst hb; subst hir; exact hseed hw
      · exact absurd hij hw
      · subst hb; subst hip
        by_cases hpr' : i = r
        · subst hpr'; exact hseed hw
        show Lhd z (σ.o i) (ρ.o i)
        have hiM : i < M.length := by omega
        -- `o′(j) < o(j)`
        have hojlt : σ.o j < ρ.o j := by
          by_cases hrj : r = j
          · have hjM : j < r + L := hjx
            rw [← hrj]
            exact o_strict_frame2 (show r + L + 1 = M.length from hlen) hR0 hZ2 hSD hZ1 hUAT hUAB hC hG hCN hRN
              hdrop (by omega) (hxCL hrj) (fun d hd => by have := (mem_children (cl_mem_children hd)).2; omega)
              (fun h => absurd h (Nat.lt_irrefl _))
          · have hjM : j < M.length := by omega
            have hjT : j < (M.take (r + L)).length := by rw [hlT]; exact hjx
            have hvlt : σ.v j < ρ.v j := by
              apply v_upg_drop_lt hZ2 hC hG hCN hjM (by omega) hjT hu
                (entry_take M 1 hjx) (entry_take M 2 hjx) _ (upg_take_last M (by omega) (by omega))
              rw [par_take M 1 _ hjx]
              cases hm : par M 1 j with
              | none => rfl
              | some m =>
                show σ.v m = ρ.v m
                exact (hoff m (by have := par_lt M 1 _ m hm; omega)).2 (fun h => hP1 m hm (hconv h))
            have hclj : CL M j = [] := hDvNil j hjx (Ne.symm hrj) (DepS.seed (Or.inr ⟨rfl, rfl⟩))
            have hclT : CL (M.take (r + L)) j = [] := hCLnil j hjx id hclj
            rw [o_of_no_counted hCN hjT (hGN.ot_v j hjT) (no_cnt_of_cl_nil hclT),
              o_of_no_counted hC hjM (hG.ot_v j hjM) (no_cnt_of_cl_nil hclj)]
            exact psi_lt_psi_z_iff.mpr (Or.inl hvlt)
        have hlt : σ.o i < ρ.o i :=
          o_strict_frame2 (show r + L + 1 = M.length from hlen) hR0 hZ2 hSD hZ1 hUAT hUAB hC hG hCN hRN hdrop
            (show i < r + L by omega) hjCLp
            (fun d hd => by
              by_contra h'
              have hdc := cl_mem_children hd
              have hdM := (mem_children hdc).2
              have hdx : d = r + L := by omega
              have h1 := (mem_children_iff.mp hdc).2
              rw [hdx, hp] at h1; cases h1; exact hpr' rfl)
            (fun _ => hojlt)
        rcases PO.zero_of_ne2 (show i + 2 ≠ M.length by omega) hC hG hiM (hdrop i (by omega)).1
            (hdrop i (by omega)).2 h3 with h | ⟨_, w, hw'⟩
        · rcases h with h | h
          · rw [h] at hlt; exact absurd hlt (lt_irrefl _)
          · exact h
        · exfalso
          have hne : CL M i ≠ [] := List.ne_nil_of_mem hjCLp
          have hlt' := arg_lt_of_cl (σ := ρ) hC hG hiM hne
          rw [o_cl_eq hC hG hiM] at hw'
          simp only [psi.injEq] at hw'
          rw [hw'.2.1] at hlt'; exact lt_irrefl' _ hlt')
end

-- copied from V3T2UpgAbs.T2UpgAbs.strong_seed_of_drop
namespace T2UpgAbs
open T
section

/-- Strong o-seeds before x-1 need no global upgrade absorption. -/
theorem strong_seed_of_drop2 {M : Mat} {ρ σ : Valn} {x p : Nat}
    (hx : x + 1 = M.length) (hC : Cons M ρ) (hG : Good3 M ρ)
    (hp : p < x) (hne : p ≠ x - 1) (hCL : CL M p ≠ [])
    (hdrop : PO ρ σ p ∧ PV2 M ρ σ p) (ho : σ.o p ≠ ρ.o p) (h3 : NoBad3 M ρ) :
    Lhd z (σ.o p) (ρ.o p) := by
  rcases PO.zero_of_ne2 (show p + 2 ≠ M.length by omega) hC hG (by omega)
      hdrop.1 hdrop.2 h3 with hE | ⟨_,w,hw⟩
  · rcases hE with heq | hl
    · exact False.elim (ho heq)
    · exact hl
  · have hor := o_cl_eq hC hG (show p < M.length by omega)
    have harg := arg_lt_of_cl hC hG (show p < M.length by omega) hCL
    rw [hw] at hor
    simp only [psi.injEq] at hor
    rw [← hor.2.1] at harg
    exact False.elim ((lt_irrefl _) harg)
end
end T2UpgAbs

-- copied from V3T2UpgAbs.T2UpgAbs.qnu_take_weak_full
namespace T2UpgAbs
open T
section
variable {M : Mat} {r L qp : Nat} (hlen : r + L + 1 = M.length) (hL : 0 < L)
  (hA : Anc0 M r (r + L)) (hp : par M 0 (r + L) = some (r + qp)) (hqp : qp < L)
  (hxb : col M (r + L) = bump M (r + qp)) (hBE : BumpE2 M)
include hlen hL hA hp hqp hxb hBE
/-- **`t = 2`, `q ≠ r`, `x − 1` upgrades to `k`, `n ≤ 1`** (`M[n] = M.take x`). -/
theorem qnu_take_weak_full2 (hR0 : R0P M) (hZ2 : Z2 M) (hSD : SibDec M) (hZ1 : Z1C M) (hUAT : UAT M)
    (hUAB : UAB M)
    (hR12 : R12 M) (hR01 : R01 M)
    (h00 : entry M 0 0 = 0) {pq : Nat} (hpq : par M 0 (r + qp) = some pq)
    (hqb : col M (r + qp) ≠ bump M pq) (he2pq : entry M 2 pq = 0) (hCLq : CL M (r + qp) = [])
    (hpqCL : CL M pq ≠ []) {k : Nat} (hu : upg M (r + L - 1) = some k)
    -- the shape of `D` in `M`
    (hP1q : ∀ m, par M 1 (r + qp) = some m → ¬ DepS M (SQU (r + qp) pq (r + L - 1)) false m)
    (hP1a : ∀ m, par M 1 (r + L - 1) = some m → ¬ DepS M (SQU (r + qp) pq (r + L - 1)) false m)
    (hqsh : ∃ Lb d Kb e, children M (r + qp) = Lb ++ [d, r + L] ∧ children M d = Kb ++ [e] ∧
      (∀ f ∈ Kb, ¬ DepS M (SQU (r + qp) pq (r + L - 1)) true f) ∧
      (∀ d' ∈ Lb, ∀ e' ∈ children M d', ¬ DepS M (SQU (r + qp) pq (r + L - 1)) true e'))
    (hDvNil : ∀ c, c < r + L → DepS M (SQU (r + qp) pq (r + L - 1)) false c → CL M c = [])
    (hOS : ∀ i, i < r + L → ¬ (SQU (r + qp) pq (r + L - 1)) true i →
      DepS M (SQU (r + qp) pq (r + L - 1)) true i → ¬ DepS M (SQU (r + qp) pq (r + L - 1)) false i →
      ∃ Lp c R, children M i = Lp ++ c :: R ∧ Counted M i c ∧ DepS M (SQU (r + qp) pq (r + L - 1)) true c ∧
        (∀ d ∈ R, ¬ Counted M i d) ∧ (∀ d ∈ Lp, Counted M i d → ¬ DepS M (SQU (r + qp) pq (r + L - 1)) true d))
    (hVSh : ∀ i, i < r + L → ¬ (SQU (r + qp) pq (r + L - 1)) false i → DepS M (SQU (r + qp) pq (r + L - 1)) false i →
      (∀ m, par M 1 i = some m → ¬ DepS M (SQU (r + qp) pq (r + L - 1)) false m) ∧
      (entry M 2 i ≠ 0 → ∃ Lb Kb j k, children M i = Lb ++ [j] ∧ col M j = bump M i ∧
        children M j = Kb ++ [k] ∧ (∀ d ∈ Kb, ¬ DepS M (SQU (r + qp) pq (r + L - 1)) true d) ∧
        (∀ d ∈ Lb, ∀ e ∈ children M d, ¬ DepS M (SQU (r + qp) pq (r + L - 1)) true e)))
    -- values
    {ρ σ : Valn} {rkM rkN : Bool → Nat → Nat}
    (hC : Cons M ρ) (hG : Good3 M ρ) (hRM : Rk M rkM)
    (hCN : Cons (M.take (r + L)) σ) (hGN : Good3 (M.take (r + L)) σ) (hRN : Rk (M.take (r + L)) rkN)
    (hF : FrameClosed M ρ) (hVS : VSmallF M ρ) (hTD : BumpTermDec M ρ) (hKD : BumpKidsDec M ρ)
    (hNB : NBPar M (r + L - 1))
    (h3 : NoBad3 M ρ)
    (hdrop : ∀ i, i < r + L → PO ρ σ i ∧ PV2 M ρ σ i)
    (hAbs : AbsWN M (M.take (r + L)) (r + L) ρ σ)
    (hseed : Lhd z (σ.o pq) (ρ.o pq)) :
    (isOT (root (M.take (r + L)) σ) = true ∧ root (M.take (r + L)) σ < root M ρ) ∧
      Lhd z (σ.v (r + qp)) (ρ.v (r + qp)) := by
  have hlT : (M.take (r + L)).length = r + L := by rw [List.length_take]; omega
  have hqx : r + qp < r + L := by omega
  have hqM : r + qp < M.length := by omega
  have hxq : r + L ∈ children M (r + qp) := mem_children_iff.mpr ⟨by omega, hp⟩
  have hpqq : pq < r + qp := par_lt M 0 _ _ hpq
  have he2q := e2_q hlen hp hxb hBE
  have he1q : entry M 1 (r + qp) ≠ 0 := by
    have h1 : entry M 1 (r + L) = entry M 1 (r + qp) :=
      e1_of_col (show col M (r + L) = (entry M 0 (r + qp) + 1, entry M 1 (r + qp), 1) from hxb)
    intro h0; rw [← h1] at h0; have := hR12 _ h0; have := e2_x hxb; omega
  have hcolN : ∀ i, i < r + L → col (M.take (r + L)) i = col M i := fun i hi => col_take M hi
  have hbumpN : ∀ i, i < r + L → bump (M.take (r + L)) i = bump M i := fun i hi => bump_take M hi
  have hchN : ∀ i, i < r + L → i ≠ r + qp → children (M.take (r + L)) i = children M i := by
    intro i _ hiq
    rw [children_take, children_filter_x hlen (fun h => hiq (by
      have h' := (mem_children_iff.mp h).2; rw [hp] at h'; exact (Option.some.inj h').symm))]
  have hxc : ∀ i c, c ∈ children M i → r + L ≤ c → c = r + L ∧ i = r + qp := by
    intro i c hc hcx
    have := (mem_children hc).2
    have hcx' : c = r + L := by omega
    refine ⟨hcx', ?_⟩
    have h' := (mem_children_iff.mp hc).2; rw [hcx', hp] at h'; exact (Option.some.inj h').symm
  have hchx : ∀ i c, c ∈ children M i → i ≠ r + qp → c < r + L := by
    intro i c hc hiq; by_contra h; exact hiq (hxc i c hc (by omega)).2
  -- the upgrade target `k`
  have hax : r + L - 1 < r + L := by omega
  have hkx : k < r + L := by
    by_contra h
    exact upg_not_x hlen hA hp hxb hBE hu (by omega) hax
  have hkT : topped M k = false := hUAT _ k hu (by omega)
  have hcqM : children M (r + qp) =
      (children M (r + qp)).filter (fun d => decide (d < r + L)) ++ [r + L] :=
    split_last_max _ _ (children_sorted M _) hxq (fun d hd => by have := (mem_children hd).2; omega)
  have hqT : topped M (r + qp) = true := by
    unfold topped; rw [hcqM]; simp [hxb]
  have hkq : k ≠ r + qp := by intro h; rw [h, hqT] at hkT; cases hkT
  have hupgN : ∀ i, i < r + L → i ≠ r + L - 1 → upg (M.take (r + L)) i = upg M i := by
    intro i hi hia; exact upg_take M (by omega)
  have hcntS : ∀ i c, i < r + L → i ≠ pq → c ∈ children M i → c < r + L →
      (Counted (M.take (r + L)) i c ↔ Counted M i c) := by
    intro i c hi hipq hc hcx
    by_cases hck : c = k
    · rw [hck]
      unfold Counted
      rw [col_take M hkx, bump_take M hi,
        topped_take_eq hlen hkx (fun h => hkq (hxc k (r + L) h (le_refl _)).2), hkT]
      simp
    by_contra h
    rcases cnt_change hlen hi hcx h with h' | h'
    · apply hipq
      have hc' := (mem_children_iff.mp h').2; rw [hp] at hc'
      have hcq : c = r + qp := (Option.some.inj hc').symm
      have h'' := (mem_children_iff.mp hc).2; rw [hcq, hpq] at h''; exact (Option.some.inj h'').symm
    · rw [hu] at h'; exact hck (Option.some.inj h').symm
  have hCLnil : ∀ c, c < r + L → CL M c = [] → CL (M.take (r + L)) c = [] := by
    intro c hc hcl
    by_cases hcpq : c = pq
    · exact (hpqCL (by rw [← hcpq]; exact hcl)).elim
    · unfold CL at hcl ⊢
      rw [List.filter_eq_nil_iff] at hcl ⊢
      intro d hd hdc
      rw [children_take, List.mem_filter] at hd
      have hdx : d < r + L := by simpa using hd.2
      exact hcl d hd.1 (decide_eq_true ((hcntS c d hc hcpq hd.1 hdx).mp (of_decide_eq_true hdc)))
  -- the roots
  have hRD : ∀ R, R < r + L → Anc0 M R (r + L) → col M R = (0, 0, 0) →
      DepS M (SQU (r + qp) pq (r + L - 1)) true R ∧ ¬ (fun _ _ => False : Bool → Nat → Prop) true R := by
    intro R hR hRA hR0
    have he2R : entry M 2 R = 0 := e2_of_col hR0
    have hRq : R ≠ r + qp := by intro h; rw [h] at he2R; omega
    have hRq' : Anc0 M R (r + qp) := anc0_par hRA (by omega) hp
    have hRpq : Anc0 M R pq := anc0_par hRq' hRq hpq
    refine ⟨?_, id⟩
    apply path_upS hUAT hZ2 hR12 hBE (pq - R) R pq (le_refl _) (by omega) hRpq (ne_of_e2z he2pq)
      (DepS.seed (Or.inr (Or.inl ⟨rfl, rfl⟩)))
    intro t _ htpq
    have := htpq.le
    exact ⟨r + L, by omega, Anc0.step hp (Anc0.step hpq (Anc0.refl pq)), not_anc_out (by omega) (by omega)⟩
  -- the seeds
  have hSeed : ∀ b i, (SQU (r + qp) pq (r + L - 1)) b i → i ≠ r + L - 1 → i < r + L → DepS M (SQU (r + qp) pq (r + L - 1)) b i →
      (∀ i, i < r + L → (¬ DepS M (SQU (r + qp) pq (r + L - 1)) true i → σ.o i = ρ.o i) ∧
        (¬ DepS M (SQU (r + qp) pq (r + L - 1)) false i → σ.v i = ρ.v i)) →
      (∀ b' i', rkM b' i' < rkM b i → DepS M (SQU (r + qp) pq (r + L - 1)) b' i' → i' < r + L →
        i' ≠ r + L - 1 → Lhd z (valB σ b' i') (valB ρ b' i')) →
      Lhd z (valB σ b i) (valB ρ b i) := by
    intro b i hs hnj _ _ hoff ih
    rcases hs with hiq | ⟨hb, hipq⟩ | ⟨hb, hia⟩
    · subst hiq
      cases b with
      | true =>
        show Lhd z (σ.o (r + qp)) (ρ.o (r + qp))
        have hv : Lhd z (σ.v (r + qp)) (ρ.v (r + qp)) :=
          ih false (r + qp) (hRM (r + qp) hqM).1 (DepS.seed (Or.inl rfl)) hqx hnj
        rw [o_of_no_counted hCN (by rw [hlT]; omega) (hGN.ot_v _ (by rw [hlT]; omega))
            (no_cnt_of_cl_nil (hCLnil _ hqx hCLq)),
          o_of_no_counted hC hqM (hG.ot_v _ hqM) (no_cnt_of_cl_nil hCLq)]
        exact lhd_of_lhdE_lt (lhdE_oq_v (Or.inr hv)) (psi_lt_psi_z_iff.mpr (Or.inl hv.1))
      | false =>
        show Lhd z (σ.v (r + qp)) (ρ.v (r + qp))
        obtain ⟨Lb, d, Kb, e, hchq, hchd, hKnd, hLnd⟩ := hqsh
        have hs := children_sorted M (r + qp)
        rw [hchq] at hs
        have hp3 := List.pairwise_append.mp hs
        have hdx : d < r + L := (List.pairwise_cons.mp hp3.2.1).1 (r + L) (by simp)
        have hLd : ∀ d' ∈ Lb, d' < d := fun d' hd' => hp3.2.2 d' hd' d (by simp)
        have hdM : d ∈ children M (r + qp) := by rw [hchq]; simp
        have hdq : d ≠ r + qp := by have := (mem_children hdM).1; omega
        have hall := all_bump_of_last hR0 hZ2 hSD hZ1 he2q
          (show children M (r + qp) = (Lb ++ [d]) ++ [r + L] by rw [hchq]; simp) hxb
        have hdb : col M d = bump M (r + qp) := hall d hdM
        have heM : e ∈ children M d := by rw [hchd]; simp
        have hex : e < r + L := hchx d e heM hdq
        have hej : e ≠ r + L - 1 := by
          intro heq
          exact hNB d (r + qp) (by simpa [heq] using (mem_children_iff.mp heM).2)
            (mem_children_iff.mp hdM).2 hdb
        have heMl : e < M.length := (mem_children heM).2
        have heN : e < (M.take (r + L)).length := by rw [hlT]; exact hex
        have hcqN : children (M.take (r + L)) (r + qp) = Lb ++ [d] := by
          rw [children_take]
          have h := hcqM.symm.trans (show children M (r + qp) = (Lb ++ [d]) ++ [r + L] by rw [hchq]; simp)
          exact List.append_inj_left' h rfl
        have hV : vOpt σ (par (M.take (r + L)) 1 (r + qp)) = vOpt ρ (par M 1 (r + qp)) := by
          rw [par_take M 1 _ hqx]
          cases hm : par M 1 (r + qp) with
          | none => rfl
          | some m =>
            show σ.v m = ρ.v m
            exact (hoff m (by have := par_lt M 1 _ m hm; omega)).2 (hP1q m hm)
        have hbL : ∀ d' ∈ Lb, bumpTerm (M.take (r + L)) σ (r + qp) d' = bumpTerm M ρ (r + qp) d' := by
          intro d' hd'
          have hd'x : d' < r + L := by have := hLd d' hd'; omega
          have hd'M : d' ∈ children M (r + qp) := by rw [hchq]; simp [hd']
          have hd'q : d' ≠ r + qp := by have := (mem_children hd'M).1; omega
          apply bumpTerm_eq_of
          · rw [hcolN d' hd'x, hbumpN _ hqx]
          · intro _
            rw [hchN d' hd'x hd'q]
            apply List.map_congr_left
            intro e' he'
            exact (hoff e' (hchx d' e' he' hd'q)).1 (hLnd d' hd' e' he')
        have hKv : Kb.map σ.o = Kb.map ρ.o := List.map_congr_left (fun f hf => by
          have hfM : f ∈ children M d := by rw [hchd]; simp [hf]
          exact (hoff f (hchx d f hfM hdq)).1 (hKnd f hf))
        have hbdM : bumpTerm M ρ (r + qp) d = omega (sumN (Kb.map ρ.o ++ [ρ.o e])) := by
          unfold bumpTerm; rw [if_pos hdb, hchd, List.map_append, List.map_singleton]
        have hbdN : bumpTerm (M.take (r + L)) σ (r + qp) d = omega (sumN (Kb.map ρ.o ++ [σ.o e])) := by
          unfold bumpTerm
          rw [if_pos (by rw [hcolN d hdx, hbumpN _ hqx]; exact hdb), hchN d hdx hdq, hchd,
            List.map_append, List.map_singleton, hKv]
        have hbxM : bumpTerm M ρ (r + qp) (r + L) = one := by
          unfold bumpTerm; rw [if_pos hxb, children_last_nil hlen]; exact omega_z
        have hsK : ∀ u ∈ Kb.map ρ.o, Single u := fun u hu => by
          obtain ⟨f, hf, rfl⟩ := List.mem_map.mp hu
          exact single_o hC hG (mem_children (show f ∈ children M d by rw [hchd]; simp [hf])).2
        have hGot : isOT (sumN (Kb.map ρ.o ++ [ρ.o e])) = true := isOT_sumN _ (fun u hu => by
          rcases List.mem_append.mp hu with h | h
          · exact (hsK u h).1
          · simp at h; rw [h]; exact hG.ot_o e heMl)
        have hrel : (sumN (Kb.map ρ.o ++ [σ.o e]) = sumN (Kb.map ρ.o ++ [ρ.o e]) ∨
            BRelS (sumN (Kb.map ρ.o ++ [σ.o e])) (sumN (Kb.map ρ.o ++ [ρ.o e]))) ∧
            isOT (sumN (Kb.map ρ.o ++ [σ.o e])) = true := by
          by_cases hDe : DepS M (SQU (r + qp) pq (r + L - 1)) true e
          · have hrke : rkM true e < rkM false (r + qp) :=
              ((hRM (r + qp) hqM).2.2 he1q).2.2 (by omega) d hdM hdb e heM
            have hIH : Lhd z (σ.o e) (ρ.o e) := ih true e hrke hDe hex hej
            have hdec := hKD (r + qp) he1q (by omega) d hdM hdb
            rw [hchd, List.map_append, List.map_singleton] at hdec
            have hform : (∃ s y y', ρ.o e = psi s y z ∧ σ.o e = psi s y' z) ∨
                (∃ w' w Y, σ.o e = psi w' z z ∧ ρ.o e = psi w Y z ∧ LhdE w' w ∧ one ≤ w') := by
              obtain ⟨y1, hy1⟩ := o_psi_sub hC heMl
              rw [sf_ot (hG.ot_v e heMl)] at hy1
              by_cases hve : σ.v e = ρ.v e
              · obtain ⟨y0, hy0⟩ := o_psi_sub hCN heN
                rw [sf_ot (hGN.ot_v e heN), hve] at hy0
                exact Or.inl ⟨_, _, _, hy1, hy0⟩
              · have hdv : DepS M (SQU (r + qp) pq (r + L - 1)) false e := by
                  by_contra hn'; exact hve ((hoff e hex).2 hn')
                have ho0 : σ.o e = psi (σ.v e) z z :=
                  o_of_no_counted hCN heN (hGN.ot_v e heN)
                    (no_cnt_of_cl_nil (hCLnil e hex (hDvNil e hex hdv)))
                have hvIH : Lhd z (σ.v e) (ρ.v e) :=
                  ih false e (by have := (hRM e heMl).1; omega) hdv hex hej
                have he1e : entry M 1 e ≠ 0 := by
                  intro he; apply hve
                  rw [v_z_of_e1 hC heMl he, v_z_of_e1 hCN heN (by rw [entry_take M 1 hex]; exact he)]
                have hv0 : σ.v e ≠ z := v_ne_z_of_e1 hCN heN (by rw [entry_take M 1 hex]; exact he1e)
                exact Or.inr ⟨_, _, _, ho0, hy1, Or.inr hvIH, one_le_of_ne_z hv0⟩
            obtain ⟨hS, _, hG'ot⟩ := g_brel hsK hdec (single_o hC hG heMl) (single_o hCN hGN heN) hIH hform
            exact ⟨Or.inr hS, hG'ot⟩
          · rw [(hoff e hex).1 hDe]; exact ⟨Or.inl rfl, hGot⟩
        exact v_bump_drop_upg hC hG hCN hqM (by rw [hlT]; omega) he1q (by omega)
          (entry_take M 1 hqx) (entry_take M 2 hqx) hV hchq hcqN hbL hbdM hbdN hbxM hGot hrel.2 hrel.1
          hTD (hAbs _ hqx he1q (by omega))
    · subst hb; rw [hipq]; exact hseed
    · exact False.elim (hnj hia)
  set j := r + L - 1 with hj
  have hjx : j < r + L := by omega
  have hjM : j < M.length := by omega
  have he1j : entry M 1 j ≠ 0 := (upg_e12 hu).1
  have he2j : entry M 2 j = 0 := by have := hZ2 j; have := (upg_e12 hu).2; omega
  have hj0 : 0 < j := by
    by_contra h
    have hjz : j = 0 := by omega
    exact he1j (hR01 j (by rw [hjz]; exact h00))
  have he0j : 0 < entry M 0 j := by
    have hne : entry M 0 j ≠ 0 := fun h => he1j (hR01 j h)
    omega
  obtain ⟨pr, hpr⟩ := par0_some_of (M := M) hj0 (by omega)
  have hprj : pr < j := par_lt M 0 j pr hpr
  have hjch : j ∈ children M pr := mem_children_iff.mpr ⟨hjM, hpr⟩
  have hjcb : col M j ≠ bump M pr := by
    intro h
    have := e2_of_col h
    change entry M 2 j = 1 at this
    omega
  have hjU : ∀ t, upg M t ≠ some j := fun t h => by
    have := upg_target_e2 h

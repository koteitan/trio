          (Anc0.step hp (Anc0.step hg (Anc0.refl g))))
      have hFrame := v_frame_xm1 hVot hWot hW1 (fun t ht _ hlt => hs t ht hlt)
      rw [sf_ot hot1] at hFrame
      exact hFrame
end
end T0UpgAbs


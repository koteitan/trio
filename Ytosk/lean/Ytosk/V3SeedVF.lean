/- QVSF/QFO/QFCo seed producers on the consistent V3 context (generated by tmp/claude/make_seedvf.py). -/
import Ytosk.V3SeedPF
import Ytosk.V3T2SeedFr
import Ytosk.V3T2SeedFr2

namespace Ytosk.V3Main.SeedPF
open T Classical WfExQ1 WfExQ2 G
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

theorem seed_last_qrV3 {M : Mat} {ρ : Valn} {rk : Bool → Nat → Nat}
    (hM : Std M) (hS : M ≠ SRO) (I : Inv3W M ρ rk) (Ctx : StepCtx3 M ρ rk)
    (hz : col M (M.length - 1) ≠ (0, 0, 0)) (h2 : TRIO.srow M (M.length - 1) = 2)
    {r L : Nat} (hlen : r + L + 1 = M.length) (hr : par M 2 (r + L) = some r)
    (hq : par M 0 (r + L) = some r) (hXu : ∀ i, upg M i ≠ some (r + L))
    {Lc : List Nat} (hCLM : CL M r = Lc ++ [r + L]) (hRes : QRRel M ρ r L Lc)
    {τ0 : Valn} (hC0 : Cons (M.take (r + L)) τ0) (hR0 : ∃ rk0, Rk (M.take (r + L)) rk0)
    (n : Nat) (hn : 2 ≤ n)
    (hGlow : ∀ m, 1 ≤ m → m < n → ∀ τ, Cons (TRIO.gexp M r L (entry M 0 (r + L) - entry M 0 r)
        (entry M 1 (r + L) - entry M 1 r) m) τ → Good3 (TRIO.gexp M r L (entry M 0 (r + L) - entry M 0 r)
        (entry M 1 (r + L) - entry M 1 r) m) τ)
    (σ : Valn) (hCN : Cons (TRIO.gexp M r L (entry M 0 (r + L) - entry M 0 r) (entry M 1 (r + L) - entry M 1 r) n) σ) :
    ∃ Y, σ.o (r + L) = psi (succ (ρ.v r)) Y z ∧
      ((n = 2 ∧ ¬ t2B (ρ.v r) ρ Lc < Y) ∨
        (3 ≤ n ∧ Y = sh (ρ.v r) (succ (ρ.v r)) (seqZ (ρ.v r) (t2B (ρ.v r) ρ Lc)
          (t2W1 (M.take (r + L)) (ρ.v r) τ0 r) (n - 3)))) ∧
      CL (TRIO.gexp M r L (entry M 0 (r + L) - entry M 0 r) (entry M 1 (r + L) - entry M 1 r) n) r = Lc ++ [r + L] ∧
      σ.v r = ρ.v r ∧ ∀ d ∈ Lc, σ.o d = ρ.o d := by
  obtain ⟨hX, hJ⟩ := sInvXJ_std hM hS
  set d0 := entry M 0 (r + L) - entry M 0 r with hd0def
  set d1 := entry M 1 (r + L) - entry M 1 r with hd1def
  have hrx : r < r + L := par_lt M 0 _ _ hq
  have hlen2 : 2 ≤ M.length := by omega
  have hzT : ¬ (TRIO.entry M 0 (M.length - 1) = 0 ∧ TRIO.entry M 1 (M.length - 1) = 0 ∧
      TRIO.entry M 2 (M.length - 1) = 0) := fun h => hz ((col_zero_iff M _).mpr h)
  have hexp : ∀ m, expand M m = TRIO.gexp M r L d0 d1 m := by
    intro m
    have h := expand_eq_gexp M m hlen2 hzT (by rw [h2, show M.length - 1 = r + L by omega]; exact hr)
    rw [h2, show M.length - 1 = r + L by omega] at h
    simp only [show (0 < 2) from by omega, show (1 < 2) from by omega, if_true,
      Nat.add_sub_cancel_left] at h
    exact h
  have hRk : ∀ m, 1 ≤ m → ∃ rk', Rk (TRIO.gexp M r L d0 d1 m) rk' := fun m hm => by
    obtain ⟨rk', h'⟩ := rk_expand_t2 hX hJ hz h2 I.rank m hm
    rw [hexp m] at h'; exact ⟨rk', h'⟩
  obtain ⟨rkN, hRN⟩ := hRk n (by omega)
  rcases Nat.lt_or_ge n 3 with hn3 | hn3
  · have hn2 : n = 2 := by omega
    subst hn2
    have hP1 : TRIO.gexp M r L d0 d1 1 = M.take (r + L) := gexp_one_gen hlen
    have hCP : Cons (TRIO.gexp M r L d0 d1 (2 - 1)) τ0 := by rw [show (2 - 1 : Nat) = 1 from rfl, hP1]; exact hC0
    have hGP : Good3 (TRIO.gexp M r L d0 d1 (2 - 1)) τ0 := hGlow 1 (le_refl 1) (by omega) τ0 hCP
    obtain ⟨rk0, hRk0⟩ := hR0
    have hRP : Rk (TRIO.gexp M r L d0 d1 (2 - 1)) rk0 := by rw [show (2 - 1 : Nat) = 1 from rfl, hP1]; exact hRk0
    obtain ⟨hCLN, hvr, hLc, hox⟩ :=
      seed_frame_data_qrV3 hM hS I Ctx hz h2 hlen hr hq hXu hCLM (le_refl 2) hCN hRN hCP hGP hRP
    rw [← hd0def, ← hd1def] at hCLN hox
    rw [show (2 - 1 : Nat) = 1 from rfl, hP1] at hox
    exact ⟨_, hox, Or.inl ⟨rfl, hRes.w1 τ0 hC0⟩, hCLN, hvr, hLc⟩
  · obtain ⟨rkP, hRP⟩ := hRk (n - 1) (by omega)
    have hCP : Cons (TRIO.gexp M r L d0 d1 (n - 1)) (rhsIt _ (rkBound _ rkP)) := cons_of_rk hRP
    have hGP := hGlow (n - 1) (by omega) (by omega) _ hCP
    obtain ⟨hCLN, hvr, hLc, hox⟩ :=
      seed_frame_data_qrV3 hM hS I Ctx hz h2 hlen hr hq hXu hCLM hn hCN hRN hCP hGP hRP
    rw [← hd0def, ← hd1def] at hCLN hox
    have hval := seed_r_value_qrV3 hM hS I Ctx hz h2 hlen hr hq hXu hCLM hRes hC0 ⟨_, hR0.choose_spec⟩ (n - 1)
      (by omega) (fun m h1 h2' τ hτ => hGlow m h1 (by omega) τ hτ) _ hCP
    have hlP : (TRIO.gexp M r L d0 d1 (n - 1)).length = r + (n - 1) * L := TRIO.gexp_length hlen
    have hrP : r < (TRIO.gexp M r L d0 d1 (n - 1)).length := by
      have : L ≤ (n - 1) * L := Nat.le_mul_of_pos_left L (by omega)
      omega
    have hform := o_cl_eq hCP hGP hrP
    rw [hval] at hform
    simp only [psi.injEq] at hform
    have h21 := hform.2.1
    rw [← hform.1] at h21
    rw [← hform.1, ← h21, show n - 1 - 2 = n - 3 by omega] at hox
    exact ⟨_, hox, Or.inr ⟨hn3, rfl⟩, hCLN, hvr, hLc⟩

theorem seed_frames_qr3V3 {M : Mat} {ρ : Valn} {rk : Bool → Nat → Nat}
    (hM : Std M) (hS : M ≠ SRO) (I : Inv3W M ρ rk) (Ctx : StepCtx3 M ρ rk)
    (hz : col M (M.length - 1) ≠ (0, 0, 0)) (h2 : TRIO.srow M (M.length - 1) = 2)
    {r L : Nat} (hlen : r + L + 1 = M.length) (hr : par M 2 (r + L) = some r)
    (hq : par M 0 (r + L) = some r) (hXu : ∀ i, upg M i ≠ some (r + L))
    {Lc : List Nat} (hCLM : CL M r = Lc ++ [r + L]) (hRes : QRRel M ρ r L Lc)
    {τ0 : Valn} (hC0 : Cons (M.take (r + L)) τ0) (hR0 : ∃ rk0, Rk (M.take (r + L)) rk0) :
    G.SeedFr QVSF M r L r ∧ G.SeedFr QFO M r L r ∧ G.SeedFr QFCo M r L r := by
  have hrM : r < M.length := by have := par_lt M 0 _ _ hq; omega
  have hVot : isOT (ρ.v r) = true := I.good.ot_v r hrM
  have hrx : r < r + L := par_lt M 0 _ _ hq
  obtain ⟨hBc, hBot, _⟩ := qr_M_side I hlen hrx hCLM
  have hσB := tame_sigmaB_std hM hS I hlen hr hq hXu hCLM
  have hQV := clField_of_vsmallF I.cons I.good I.vs r hrM
  have hQO : CLField QFO M ρ := I.fo
  have hQC := clField_QFCo I.good I.fc r hrM
  refine ⟨fun n hn hGlow σ hCN hGN => ?_, fun n hn hGlow σ hCN hGN => ?_, fun n hn hGlow σ hCN hGN => ?_⟩
  all_goals obtain ⟨Y, hox, hcase, hCLN, hvr, hLc⟩ :=
    seed_last_qrV3 hM hS I Ctx hz h2 hlen hr hq hXu hCLM hRes hC0 hR0 n hn hGlow σ hCN
  · -- VSmallF: at the level `V` the subscript `V + 1` has only the component `z`
    refine G.seed_frames_lift hCLM hCLN hvr hLc (fun Lc' c R' h => hQV Lc' c R' h) ?_
    rw [hox]
    intro s y hsy g hg
    simp only [psi.injEq] at hsy
    obtain ⟨rfl, -⟩ := hsy
    left; rw [comps_succ_self hVot g hg]; exact z_le _
  · -- FrameOT: the state before the last child is that of `M`
    exact G.seed_frames_lift hCLM hCLN hvr hLc (fun Lc' c R' h => hQO r hrM Lc' c R' h)
      (hQO r hrM Lc (r + L) [] hCLM)
  · -- FrameClosed: no rewrite at `n = 2`; at `n ≥ 3` the new state extends `B`
    refine G.seed_frames_lift hCLM hCLN hvr hLc (fun Lc' c R' h => hQC Lc' c R' h) ?_
    have hxN : r + L < (TRIO.gexp M r L (entry M 0 (r + L) - entry M 0 r)
        (entry M 1 (r + L) - entry M 1 r) n).length := by
      rw [TRIO.gexp_length hlen]
      have : 2 * L ≤ n * L := Nat.mul_le_mul_right L hn
      omega
    refine ⟨hGN.ot_o _ hxN, ?_⟩
    rw [hox]
    intro s y hsy ht
    simp only [psi.injEq] at hsy
    obtain ⟨rfl, rfl, -⟩ := hsy
    rcases hcase with ⟨_, hnr⟩ | ⟨hn3, hY⟩
    · exact absurd ht.1 hnr
    · have hot : isOT (psi (succ (ρ.v r)) Y z) = true := by rw [← hox]; exact hGN.ot_o _ hxN
      have hall : ∀ q ∈ summands Y, ¬ q < psi (succ (succ (ρ.v r))) z z := by
        rw [hY]; exact G.sh_seqZ_allGe hVot hσB hBc hRes.ks (n - 3)
      have hH : H (succ (ρ.v r)) Y = Y := by
        rw [H_eq hot, split_all_ge hall]; simp
      have hsz := G.sh_seqZ hVot hσB hBc hRes.ks (W1 := t2W1 (M.take (r + L)) (ρ.v r) τ0 r) (n - 3)
      rw [hH, hY, show t2B (ρ.v r) ρ Lc = spArg (ρ.v r) z (sumN (Lc.map ρ.o)) from rfl, hsz]
      apply frameDom_prefix
      intro u hu g hg
      rcases comps_succ_sub u g hg with h | h
      · exact Or.inl h
      · exact Or.inr (Or.inr (Or.inr ⟨g, h, le_refl _⟩))

theorem seed_last_qnV3 {M : Mat} {ρ : Valn} {rk : Bool → Nat → Nat}
    (hM : Std M) (hS : M ≠ SRO) (I : Inv3W M ρ rk) (Ctx : StepCtx3 M ρ rk)
    (hz : col M (M.length - 1) ≠ (0, 0, 0)) (h2 : TRIO.srow M (M.length - 1) = 2)
    {r L q : Nat} (hlen : r + L + 1 = M.length) (hr : par M 2 (r + L) = some r)
    (hq : par M 0 (r + L) = some q) (hqr : q ≠ r)
    {Lc : List Nat} (hCLM : CL M r = Lc ++ [q]) (hRes : QNRel M ρ r L q Lc)
    {τ0 : Valn} (hC0 : Cons (M.take (r + L)) τ0) (hR0 : ∃ rk0, Rk (M.take (r + L)) rk0)
    (n : Nat) (hn : 2 ≤ n)
    (hGlow : ∀ m, 1 ≤ m → m < n → ∀ τ, Cons (TRIO.gexp M r L (entry M 0 (r + L) - entry M 0 r)
        (entry M 1 (r + L) - entry M 1 r) m) τ → Good3 (TRIO.gexp M r L (entry M 0 (r + L) - entry M 0 r)
        (entry M 1 (r + L) - entry M 1 r) m) τ)
    (σ : Valn) (hCN : Cons (TRIO.gexp M r L (entry M 0 (r + L) - entry M 0 r) (entry M 1 (r + L) - entry M 1 r) n) σ) :
    ∃ ft, CL (TRIO.gexp M r L (entry M 0 (r + L) - entry M 0 r) (entry M 1 (r + L) - entry M 1 r) n) r = Lc ++ [q] ∧
      CL (TRIO.gexp M r L (entry M 0 (r + L) - entry M 0 r) (entry M 1 (r + L) - entry M 1 r) n) q = [r + L] ∧
      σ.v r = ρ.v r ∧ (∀ d ∈ Lc, σ.o d = ρ.o d) ∧ σ.v (r + L) = qnS M ρ r L q ∧
      σ.v q = qnS M ρ r L q ∧
      σ.o q = psi (qnS M ρ r L q) (app (t2B (ρ.v r) ρ Lc) (psi ft z z)) z ∧
      (∀ g ∈ summands (app (t2B (ρ.v r) ρ Lc) (psi ft z z)), ¬ g < psi (succ (qnS M ρ r L q)) z z) ∧
      (Lc = [] → ∃ X, X ≠ z ∧ ft = app (qnS M ρ r L q) X) := by
  obtain ⟨hX, hJ⟩ := sInvXJ_std hM hS
  set d0 := entry M 0 (r + L) - entry M 0 r with hd0def
  set d1 := entry M 1 (r + L) - entry M 1 r with hd1def
  set V := ρ.v r with hVdef
  set B := t2B V ρ Lc with hBdef
  set s' := qnS M ρ r L q with hs'def
  have hqcl : q ∈ CL M r := by rw [hCLM]; simp
  have hpq : par M 0 q = some r := (mem_children_iff.mp (cl_mem_children hqcl)).2
  have hrq : r < q := par_lt M 0 _ _ hpq
  have hqx : q < r + L := par_lt M 0 _ _ hq
  have hrM : r < M.length := by omega
  have hlen2 : 2 ≤ M.length := by omega
  have hzT : ¬ (TRIO.entry M 0 (M.length - 1) = 0 ∧ TRIO.entry M 1 (M.length - 1) = 0 ∧
      TRIO.entry M 2 (M.length - 1) = 0) := fun h => hz ((col_zero_iff M _).mpr h)
  have hexp : ∀ m, expand M m = TRIO.gexp M r L d0 d1 m := by
    intro m
    have h := expand_eq_gexp M m hlen2 hzT (by rw [h2, show M.length - 1 = r + L by omega]; exact hr)
    rw [h2, show M.length - 1 = r + L by omega] at h
    simp only [show (0 < 2) from by omega, show (1 < 2) from by omega, if_true,
      Nat.add_sub_cancel_left] at h
    exact h
  have hRk : ∀ m, 1 ≤ m → ∃ rk', Rk (TRIO.gexp M r L d0 d1 m) rk' := fun m hm => by
    obtain ⟨rk', h'⟩ := rk_expand_t2 hX hJ hz h2 I.rank m hm
    rw [hexp m] at h'; exact ⟨rk', h'⟩
  have hs'ot : isOT s' = true := qnS_ot I hrM L q
  have hP1 : TRIO.gexp M r L d0 d1 1 = M.take (r + L) := gexp_one_gen hlen
  have hv0 := v_take_of_untopped I hlen (par_lt M 2 _ _ hr) (topP_C hM hS I hlen hr hq hqr) hC0
  obtain ⟨t1, ht1, hch⟩ := hRes.base τ0 hC0
  obtain ⟨rkN, hRN⟩ := hRk n (by omega)
  have hvq : σ.v q = s' := vq_eq_gexp hM hS I hz h2 hlen hr hn hCN hq hqr
  obtain ⟨hCLN, hCLNq, hvr, hLc, hvx, hoq⟩ : CL (TRIO.gexp M r L d0 d1 n) r = Lc ++ [q] ∧
      CL (TRIO.gexp M r L d0 d1 n) q = [r + L] ∧ σ.v r = V ∧ (∀ d ∈ Lc, σ.o d = ρ.o d) ∧
      σ.v (r + L) = s' ∧
      σ.o q = psi s' (step s' z s' (sh V s' (app B (psi (tqN V s' t1 (n - 2)) z z))) z) z := by
    rcases Nat.lt_or_ge n 3 with hn3 | hn3
    · have hn2 : n = 2 := by omega
      subst hn2
      have hCP : Cons (TRIO.gexp M r L d0 d1 (2 - 1)) τ0 := by rw [show (2 - 1 : Nat) = 1 from rfl, hP1]; exact hC0
      have hGP : Good3 (TRIO.gexp M r L d0 d1 (2 - 1)) τ0 := hGlow 1 (le_refl 1) (by omega) τ0 hCP
      obtain ⟨rk0, hRk0⟩ := hR0
      have hRP : Rk (TRIO.gexp M r L d0 d1 (2 - 1)) rk0 := by rw [show (2 - 1 : Nat) = 1 from rfl, hP1]; exact hRk0
      obtain ⟨hCLN, hCLNq, hvr, hLc, hvx, hoq⟩ :=
        seed_frame_data_qnV3 hM hS I Ctx hz h2 hlen hr hq hqr hCLM (le_refl 2) hCN hRN hCP hGP hRP
      rw [← hd0def, ← hd1def] at hCLN hCLNq hoq
      rw [show (2 - 1 : Nat) = 1 from rfl, hP1, ht1, hv0] at hoq
      rw [hvq, qnS_vxs] at hvx
      rw [hvq, hvx, G.spArg_nil] at hoq
      exact ⟨hCLN, hCLNq, hvr, hLc, hvx, hoq⟩
    · obtain ⟨rkP, hRP⟩ := hRk (n - 1) (by omega)
      have hCP : Cons (TRIO.gexp M r L d0 d1 (n - 1)) (rhsIt _ (rkBound _ rkP)) := cons_of_rk hRP
      have hGP := hGlow (n - 1) (by omega) (by omega) _ hCP
      obtain ⟨hCLN, hCLNq, hvr, hLc, hvx, hoq⟩ :=
        seed_frame_data_qnV3 hM hS I Ctx hz h2 hlen hr hq hqr hCLM hn hCN hRN hCP hGP hRP
      rw [← hd0def, ← hd1def] at hCLN hCLNq hoq
      have hlP : (TRIO.gexp M r L d0 d1 (n - 1)).length = r + (n - 1) * L := TRIO.gexp_length hlen
      have hrP : r < (TRIO.gexp M r L d0 d1 (n - 1)).length := by
        have : L ≤ (n - 1) * L := Nat.le_mul_of_pos_left L (by omega)
        omega
      have hqP : q < (TRIO.gexp M r L d0 d1 (n - 1)).length := by
        have : L ≤ (n - 1) * L := Nat.le_mul_of_pos_left L (by omega)
        omega
      have hval := seed_r_value_qnV3 hM hS I Ctx hz h2 hlen hr hq hqr hCLM hRes hC0 hR0 hv0 ht1
        (fun k => ⟨(hch k).1, (hch k).2⟩) (n - 1) (by omega)
        (fun m h1 h2' τ hτ => hGlow m h1 (by omega) τ hτ) _ hCP (hGP.ot_o q hqP) (cl_vals hCP hGP hrP).2
      have hform := o_cl_eq hCP hGP hrP
      rw [hval] at hform
      simp only [psi.injEq] at hform
      have h21 := hform.2.1
      rw [← hform.1] at h21
      rw [← hform.1, ← h21, show n - 1 - 1 = n - 2 by omega] at hoq
      rw [hvq, qnS_vxs] at hvx
      rw [hvq, hvx, G.spArg_nil] at hoq
      exact ⟨hCLN, hCLNq, hvr, hLc, hvx, hoq⟩
  set t := tqN V s' t1 (n - 2) with htdef
  have hat : V < t := (hch (n - 2)).1
  have hts : ¬ shf V s' t < succ s' := (hch (n - 2)).2
  have hσB := hRes.σB
  have hBc := hRes.Bc
  have hhigh : ∀ g ∈ summands (app B (psi (shf V s' t) z z)), ¬ g < psi (succ s') z z := by
    intro g hg
    rw [summands_app] at hg
    rcases List.mem_append.mp hg with hg | hg
    · exact hBc g hg
    · simp [summands] at hg; rw [hg]
      intro hlt
      rw [psi_lt_psi_z_iff] at hlt
      rcases hlt with h | ⟨_, h⟩
      · exact hts h
      · exact T.not_lt_z _ h
  have hinner : step s' z s' (sh V s' (app B (psi t z z))) z = app B (psi (shf V s' t) z z) := by
    rw [sh_app, hσB, sh_psi_gt hat, sh_z]
    have hne : app B (psi (shf V s' t) z z) ≠ z := by
      intro h; cases hB : B with
      | z => rw [hB] at h; simp at h
      | psi _ _ _ => rw [hB] at h; simp at h
    have hzlt : z < app B (psi (shf V s' t) z z) := by
      cases h : app B (psi (shf V s' t) z z) with
      | z => exact absurd h hne
      | psi _ _ _ => exact T.z_lt_psi _ _ _
    unfold step
    rw [if_pos ⟨hzlt, psi_lt_psi_z_iff.mpr (Or.inr ⟨rfl, hzlt⟩)⟩]
    exact H_of_high hs'ot hhigh
  rw [hinner] at hoq
  refine ⟨shf V s' t, hCLN, hCLNq, hvr, hLc, hvx, hvq, hoq, hhigh, fun hLc0 => ?_⟩
  obtain ⟨X, hX0, hXe⟩ := t2SeedQNFC_holdsV3 hM hS I Ctx hlen hr hq hqr hCLM hLc0 τ0 hC0 t1 ht1 (n - 2)
  exact ⟨X, hX0, hXe⟩

theorem seed_frames_qn3V3 {M : Mat} {ρ : Valn} {rk : Bool → Nat → Nat}
    (hM : Std M) (hS : M ≠ SRO) (I : Inv3W M ρ rk) (Ctx : StepCtx3 M ρ rk)
    (hz : col M (M.length - 1) ≠ (0, 0, 0)) (h2 : TRIO.srow M (M.length - 1) = 2)
    {r L q : Nat} (hlen : r + L + 1 = M.length) (hr : par M 2 (r + L) = some r)
    (hq : par M 0 (r + L) = some q) (hqr : q ≠ r)
    {Lc : List Nat} (hCLM : CL M r = Lc ++ [q]) (hRes : QNRel M ρ r L q Lc)
    (hDom : T2SeedQNDom M ρ r L q Lc)
    {τ0 : Valn} (hC0 : Cons (M.take (r + L)) τ0) (hR0 : ∃ rk0, Rk (M.take (r + L)) rk0) :
    ∀ i, (i = r ∨ i = q) → G.SeedFr QVSF M r L i ∧ G.SeedFr QFO M r L i ∧ G.SeedFr QFCo M r L i := by
  have hqcl : q ∈ CL M r := by rw [hCLM]; simp
  have hpq : par M 0 q = some r := (mem_children_iff.mp (cl_mem_children hqcl)).2
  have hrq : r < q := par_lt M 0 _ _ hpq
  have hqx : q < r + L := par_lt M 0 _ _ hq
  have hrM : r < M.length := by omega
  have hVot : isOT (ρ.v r) = true := I.good.ot_v r hrM
  have hs'ot : isOT (qnS M ρ r L q) = true := qnS_ot I hrM L q
  have hVs' : ρ.v r < qnS M ρ r L q := qnS_gt M ρ r L q
  have hQV := clField_of_vsmallF I.cons I.good I.vs r hrM
  have hQO : CLField QFO M ρ := I.fo
  have hQC := clField_QFCo I.good I.fc r hrM
  intro i hi
  refine ⟨fun n hn hGlow σ hCN hGN => ?_, fun n hn hGlow σ hCN hGN => ?_, fun n hn hGlow σ hCN hGN => ?_⟩
  all_goals
    obtain ⟨ft, hCLN, hCLNq, hvr, hLc, hvx, hvq, hoq, hhigh, hfc⟩ :=
      seed_last_qnV3 hM hS I Ctx hz h2 hlen hr hq hqr hCLM hRes hC0 hR0 n hn hGlow σ hCN
    have hxN : r + L < (TRIO.gexp M r L (entry M 0 (r + L) - entry M 0 r)
        (entry M 1 (r + L) - entry M 1 r) n).length := by
      rw [TRIO.gexp_length hlen]
      have : 2 * L ≤ n * L := Nat.mul_le_mul_right L hn
      omega
    have hqN : q < (TRIO.gexp M r L (entry M 0 (r + L) - entry M 0 r)
        (entry M 1 (r + L) - entry M 1 r) n).length := by omega
    obtain ⟨y0, hy0⟩ := o_psi_sub hCN hxN
    rw [sf_ot (hGN.ot_v _ hxN), hvx] at hy0
    have hfrq : ∀ {Q : T → List T → T → Prop}, Q (σ.v q) [] (σ.o (r + L)) →
        ∀ (Lc' : List Nat) (c : Nat) (R' : List Nat),
          CL (TRIO.gexp M r L (entry M 0 (r + L) - entry M 0 r) (entry M 1 (r + L) - entry M 1 r) n) q =
            Lc' ++ c :: R' → Q (σ.v q) (Lc'.map σ.o) (σ.o c) := by
      intro Q h Lc' c R' hCL
      rw [hCLNq] at hCL
      rcases Lc' with _ | ⟨a, l⟩
      · simp at hCL; rw [← hCL.1]; exact h
      · simp at hCL
    rcases hi with hi | hi <;> subst i
  · -- VSmallF, the frames of `r`
    refine G.seed_frames_lift hCLM hCLN hvr hLc (fun Lc' c R' h => hQV Lc' c R' h) ?_
    rw [hoq]
    intro s y hsy g hg
    simp only [psi.injEq] at hsy
    obtain ⟨rfl, -⟩ := hsy
    exact hDom.2 g hg
  · -- VSmallF, the frame of `q`: the subscript is `v(q)`, which has no components at its own level
    refine hfrq ?_
    rw [hy0, hvq]
    intro s y hsy g hg
    simp only [psi.injEq] at hsy
    obtain ⟨rfl, -⟩ := hsy
    rw [comps_eq_nil_of_lev (fun q hq => lev_lt_of_summand hs'ot hq)] at hg; simp at hg
  · -- FrameOT, the frames of `r`
    exact G.seed_frames_lift hCLM hCLN hvr hLc (fun Lc' c R' h => hQO r hrM Lc' c R' h)
      (hQO r hrM Lc q [] hCLM)
  · -- FrameOT, the frame of `q`
    refine hfrq ?_
    show isOT (psi (σ.v q) (spArg (σ.v q) z (sumN ([] : List T))) z) = true
    rw [G.spArg_nil, hvq]
    exact isOT_psi_zz hs'ot
  · -- FrameClosed, the frames of `r`
    refine G.seed_frames_lift hCLM hCLN hvr hLc (fun Lc' c R' h => hQC Lc' c R' h) ⟨hGN.ot_o q hqN, ?_⟩
    rw [hoq]
    intro s y hsy _
    simp only [psi.injEq] at hsy
    obtain ⟨rfl, rfl, -⟩ := hsy
    rw [H_of_high hs'ot hhigh]
    by_cases hL0 : Lc = []
    · obtain ⟨X, _, hX⟩ := hfc hL0
      have hB : t2B (ρ.v r) ρ Lc = z := by rw [hL0]; rfl
      show FrameDom (ρ.v r) (t2B (ρ.v r) ρ Lc) _ _
      rw [hB, app_z]
      exact frameDom_first (le_of_lt hVs') (by rw [lev_psi, hX])
    · exact frameDom_prefixB (hDom.1 hL0)
  · -- FrameClosed, the frame of `q`: the child's subscript is `v(q)`
    refine hfrq ⟨hGN.ot_o _ hxN, ?_⟩
    rw [hy0, hvq]
    intro s y hsy _
    simp only [psi.injEq] at hsy
    obtain ⟨rfl, -⟩ := hsy
    exact frameDom_self (fun u _ => by rw [G.spArg_nil]; rfl)

theorem seed_frames_sv3V3 {M : Mat} {ρ : Valn} {rk : Bool → Nat → Nat}
    (hM : Std M) (hS : M ≠ SRO) (I : Inv3W M ρ rk) (Ctx : StepCtx3 M ρ rk)
    (hz : col M (M.length - 1) ≠ (0, 0, 0)) (h2 : TRIO.srow M (M.length - 1) = 2)
    {r L : Nat} (hlen : r + L + 1 = M.length) (hr : par M 2 (r + L) = some r)
    (hq : par M 0 (r + L) = some r) (hux : upg M (r + L - 1) = some (r + L))
    (hRes : SVRel M ρ r L) (hFix : T2SeedSVFix M ρ r L)
    {τ0 : Valn} {rk0 : Bool → Nat → Nat} (hC0 : Cons (M.take (r + L)) τ0) (hR0 : Rk (M.take (r + L)) rk0)
    (hTV : VSmallF (M.take (r + L)) τ0) (hTO : FrameOT (M.take (r + L)) τ0)
    (hTC : FrameClosed (M.take (r + L)) τ0) :
    SeedFr QVSF M r L r ∧ SeedFr QFO M r L r ∧ SeedFr QFCo M r L r := by
  obtain ⟨hX, hJ⟩ := sInvXJ_std hM hS
  set d0 := entry M 0 (r + L) - entry M 0 r with hd0def
  set d1 := entry M 1 (r + L) - entry M 1 r with hd1def
  set V := ρ.v r with hVdef
  set X1 := t2X1 M r L τ0 with hX1def
  have hrx : r < r + L := par_lt M 0 _ _ hq
  have hrM : r < M.length := by omega
  have hlen2 : 2 ≤ M.length := by omega
  have hzT : ¬ (TRIO.entry M 0 (M.length - 1) = 0 ∧ TRIO.entry M 1 (M.length - 1) = 0 ∧
      TRIO.entry M 2 (M.length - 1) = 0) := fun h => hz ((col_zero_iff M _).mpr h)
  have hexp : ∀ m, expand M m = TRIO.gexp M r L d0 d1 m := by
    intro m
    have h := expand_eq_gexp M m hlen2 hzT (by rw [h2, show M.length - 1 = r + L by omega]; exact hr)
    rw [h2, show M.length - 1 = r + L by omega] at h
    simp only [show (0 < 2) from by omega, show (1 < 2) from by omega, if_true,
      Nat.add_sub_cancel_left] at h
    exact h
  have hRk : ∀ m, 1 ≤ m → ∃ rk', Rk (TRIO.gexp M r L d0 d1 m) rk' := fun m hm => by
    obtain ⟨rk', h'⟩ := rk_expand_t2 hX hJ hz h2 I.rank m hm
    rw [hexp m] at h'; exact ⟨rk', h'⟩
  have hVot : isOT V = true := I.good.ot_v r hrM
  have hV' : isOT (succ V) = true := isOT_succ hVot
  have hVV : V < succ V := lt_succ_self V
  have hP1 : TRIO.gexp M r L d0 d1 1 = M.take (r + L) := gexp_one_gen hlen
  have hlT : (M.take (r + L)).length = r + L := by rw [List.length_take]; omega
  have hrT : r < (M.take (r + L)).length := by omega
  have hvP : τ0.v r = V := v_take_of_untopped I hlen (par_lt M 0 _ _ hq) (topP_sv hlen I.z2 I.z1 hr hq hux) hC0
  have hX1e : X1 = spArg V z (sumN ((CL (M.take (r + L)) r).map τ0.o)) := by
    rw [hX1def]; unfold t2X1; rw [hvP]
  have hBhi := hFix.hi τ0 hC0
  have hFx := hFix.fix τ0 hC0
  -- the common data of the last frame
  have key : ∀ n, 2 ≤ n →
      (∀ m, 1 ≤ m → m < n → ∀ τ, Cons (TRIO.gexp M r L d0 d1 m) τ → Good3 (TRIO.gexp M r L d0 d1 m) τ) →
      ∀ σ, Cons (TRIO.gexp M r L d0 d1 n) σ → Good3 (TRIO.gexp M r L d0 d1 n) σ →
      Good3 (M.take (r + L)) τ0 ∧ isOT X1 = true ∧
      σ.o (r + L) = psi (succ V) (sh V (succ V) (shIt V (succ V) X1 (n - 2))) z ∧
      CL (TRIO.gexp M r L d0 d1 n) r = CL (M.take (r + L)) r ++ [r + L] ∧ σ.v r = τ0.v r ∧
      (∀ d ∈ CL (M.take (r + L)) r, σ.o d = τ0.o d) ∧ SeedExt (succ V) X1 (shIt V (succ V) X1 (n - 2)) := by
    intro n hn hGlow σ hCN _
    have hG0 : Good3 (M.take (r + L)) τ0 := by
      have := hGlow 1 (le_refl 1) (by omega) τ0 (by rw [hP1]; exact hC0)
      rw [hP1] at this; exact this
    have hX1ot : isOT X1 = true := by
      have := hG0.ot_o r hrT
      rw [o_cl_eq hC0 hG0 hrT] at this
      rw [hX1def]; exact isOT_arg this
    obtain ⟨rkN, hRN⟩ := hRk n (by omega)
    obtain ⟨hox, hCLN, hvr, hval⟩ : σ.o (r + L) = psi (succ V) (sh V (succ V) (shIt V (succ V) X1 (n - 2))) z ∧
        CL (TRIO.gexp M r L d0 d1 n) r = CL (M.take (r + L)) r ++ [r + L] ∧ σ.v r = τ0.v r ∧
        ∀ d ∈ CL (M.take (r + L)) r, σ.o d = τ0.o d := by
      rcases Nat.lt_or_ge n 3 with hn3 | hn3
      · have hn2 : n = 2 := by omega
        subst hn2
        have hCP : Cons (TRIO.gexp M r L d0 d1 (2 - 1)) τ0 := by rw [show (2 - 1 : Nat) = 1 from rfl, hP1]; exact hC0
        have hGP : Good3 (TRIO.gexp M r L d0 d1 (2 - 1)) τ0 := hGlow 1 (le_refl 1) (by omega) τ0 hCP
        have hRP : Rk (TRIO.gexp M r L d0 d1 (2 - 1)) rk0 := by rw [show (2 - 1 : Nat) = 1 from rfl, hP1]; exact hR0
        obtain ⟨hCLN, hvr, hval, hox⟩ :=
          seed_frame_data_svV3 hM hS I Ctx hz h2 hlen hr hq hux (topP_sv hlen I.z2 I.z1 hr hq hux) (le_refl 2) hCN hRN hCP hGP hRP hC0 hG0 hR0
        rw [← hd0def, ← hd1def] at hCLN hox
        rw [show (2 - 1 : Nat) = 1 from rfl, hP1, hvP, ← hX1e] at hox
        exact ⟨hox, hCLN, hvr, hval⟩
      · obtain ⟨rkP, hRP⟩ := hRk (n - 1) (by omega)
        have hCP : Cons (TRIO.gexp M r L d0 d1 (n - 1)) (rhsIt _ (rkBound _ rkP)) := cons_of_rk hRP
        have hGP := hGlow (n - 1) (by omega) (by omega) _ hCP
        obtain ⟨hCLN, hvr, hval, hox⟩ :=
          seed_frame_data_svV3 hM hS I Ctx hz h2 hlen hr hq hux (topP_sv hlen I.z2 I.z1 hr hq hux) hn hCN hRN hCP hGP hRP hC0 hG0 hR0
        rw [← hd0def, ← hd1def] at hCLN hox
        have hlP : (TRIO.gexp M r L d0 d1 (n - 1)).length = r + (n - 1) * L := TRIO.gexp_length hlen
        have hrP : r < (TRIO.gexp M r L d0 d1 (n - 1)).length := by
          have : L ≤ (n - 1) * L := Nat.le_mul_of_pos_left L (by omega)
          omega
        have hval' := seed_r_value_svV3 hM hS I Ctx hz h2 hlen hr hq hux hRes hC0 hR0 (n - 1) (by omega)
          (fun m h1 h2' τ hτ => hGlow m h1 (by omega) τ hτ) _ hCP (cl_vals hCP hGP hrP).2
        have hform := o_cl_eq hCP hGP hrP
        rw [hval'] at hform
        simp only [psi.injEq] at hform
        have h21 := hform.2.1
        rw [← hform.1] at h21
        rw [← hform.1, ← h21, show n - 1 - 1 = n - 2 by omega] at hox
        exact ⟨hox, hCLN, hvr, hval⟩
    have hOT : ∀ j, j + 1 < n → isOT (psi V (shIt V (succ V) X1 j) z) = true := by
      intro j hj
      rcases Nat.eq_zero_or_pos j with rfl | hj0
      · have := hG0.ot_o r hrT
        rw [o_cl_eq hC0 hG0 hrT] at this
        show isOT (psi V X1 z) = true
        rw [hX1e]; rw [hvP] at this; exact this
      · obtain ⟨rkj, hRj⟩ := hRk (j + 1) (by omega)
        have hCj : Cons (TRIO.gexp M r L d0 d1 (j + 1)) (rhsIt _ (rkBound _ rkj)) := cons_of_rk hRj
        have hGj := hGlow (j + 1) (by omega) hj _ hCj
        have hlj : (TRIO.gexp M r L d0 d1 (j + 1)).length = r + (j + 1) * L := TRIO.gexp_length hlen
        have hrj : r < (TRIO.gexp M r L d0 d1 (j + 1)).length := by
          have : L ≤ (j + 1) * L := Nat.le_mul_of_pos_left L (by omega)
          omega
        have hv := seed_r_value_svV3 hM hS I Ctx hz h2 hlen hr hq hux hRes hC0 hR0 (j + 1) (by omega)
          (fun m h1 h2' τ hτ => hGlow m h1 (by omega) τ hτ) _ hCj (cl_vals hCj hGj hrj).2
        have := hGj.ot_o r hrj
        rw [hv, show j + 1 - 1 = j by omega] at this
        exact this
    have hE : ∀ k, k + 1 < n → SeedExt (succ V) X1 (shIt V (succ V) X1 k) := by
      intro k
      induction k with
      | zero => intro _; exact Or.inl rfl
      | succ k ih =>
        intro hk
        have hcv : isOT (psi (succ V) (sh V (succ V) (shIt V (succ V) X1 k)) z) = true := by
          have := isOT_shTop (V' := succ V) hVot hV' hVV (hOT k (by omega)) (le_refl _)
          rwa [shf_self] at this
        have h := seed_ext (a := V) hVot hV' hVV hX1ot (isOT_shIt hVot hV' hVV hX1ot k) hBhi hFx (ih (by omega)) hcv
        rw [hRes.rw τ0 hC0 k] at h
        exact h
    exact ⟨hG0, hX1ot, hox, hCLN, hvr, hval, hE (n - 2) (by omega)⟩
  refine ⟨fun n hn hGlow σ hCN hGN => ?_, fun n hn hGlow σ hCN hGN => ?_, fun n hn hGlow σ hCN hGN => ?_⟩
  all_goals obtain ⟨hG0, hX1ot, hox, hCLN, hvr, hval, hEn⟩ := key n hn hGlow σ hCN hGN
  · refine seed_frames_liftE (G := M.take (r + L)) (E := []) (by simp) hCLN hvr hval
      (fun Lc' c R' h => clField_of_vsmallF hC0 hG0 hTV r hrT Lc' c R' h) ?_
    rw [hox, hvP]
    intro s y hsy g hg
    simp only [psi.injEq] at hsy
    obtain ⟨rfl, -⟩ := hsy
    left; rw [comps_succ_self hVot g hg]; exact z_le _
  · refine seed_frames_liftE (G := M.take (r + L)) (E := []) (by simp) hCLN hvr hval
      (fun Lc' c R' h => hTO r hrT Lc' c R' h) ?_
    show isOT (psi (τ0.v r) (spArg (τ0.v r) z (sumN ((CL (M.take (r + L)) r).map τ0.o))) z) = true
    rw [← o_cl_eq hC0 hG0 hrT]; exact hG0.ot_o r hrT
  · have hxN : r + L < (TRIO.gexp M r L d0 d1 n).length := by
      rw [TRIO.gexp_length hlen]
      have : 2 * L ≤ n * L := Nat.mul_le_mul_right L hn
      omega
    refine seed_frames_liftE (G := M.take (r + L)) (E := []) (by simp) hCLN hvr hval
      (fun Lc' c R' h => clField_QFCo hG0 hTC r hrT Lc' c R' h) ⟨hGN.ot_o _ hxN, ?_⟩
    have hot := hGN.ot_o _ hxN
    rw [hox] at hot ⊢
    intro s y hsy ht
    simp only [psi.injEq] at hsy
    obtain ⟨rfl, rfl, -⟩ := hsy
    have hst : spArg (τ0.v r) z (sumN ((CL (M.take (r + L)) r).map τ0.o)) = X1 := rfl
    rw [hst] at ht ⊢
    rw [hvP] at ht ⊢
    refine frameDom_of_kind hot
      (seed_kind hVot hV' hVV hX1ot (isOT_shIt hVot hV' hVV hX1ot (n - 2)) hBhi hFx hEn ht.1) ?_
    intro u hu g hg
    rcases comps_succ_sub u g hg with h | h
    · exact Or.inl h
    · exact Or.inr (Or.inr (Or.inr ⟨g, h, le_refl _⟩))

/-! ## C -/

theorem seed_last_CV3 {M : Mat} {ρ : Valn} {rk : Bool → Nat → Nat}
    (hM : Std M) (hS : M ≠ SRO) (I : Inv3W M ρ rk) (Ctx : StepCtx3 M ρ rk)
    (hz : col M (M.length - 1) ≠ (0, 0, 0)) (h2 : TRIO.srow M (M.length - 1) = 2)
    {r L q : Nat} (hlen : r + L + 1 = M.length) (hr : par M 2 (r + L) = some r)
    (hq : par M 0 (r + L) = some q) (hqr : q ≠ r) (hncl : ¬ ∃ Lc, CL M r = Lc ++ [q])
    (hRes : CRel M ρ r L q) (hFix : T2SeedCFix M ρ r L q)
    {τ0 : Valn} {rk0 : Bool → Nat → Nat} (hC0 : Cons (M.take (r + L)) τ0) (hR0 : Rk (M.take (r + L)) rk0) :
    ∀ n, 2 ≤ n →
    (∀ m, 1 ≤ m → m < n → ∀ τ, Cons (TRIO.gexp M r L (entry M 0 (r + L) - entry M 0 r) (entry M 1 (r + L) - entry M 1 r) m) τ → Good3 (TRIO.gexp M r L (entry M 0 (r + L) - entry M 0 r) (entry M 1 (r + L) - entry M 1 r) m) τ) →
    ∀ σ, Cons (TRIO.gexp M r L (entry M 0 (r + L) - entry M 0 r) (entry M 1 (r + L) - entry M 1 r) n) σ → Good3 (TRIO.gexp M r L (entry M 0 (r + L) - entry M 0 r) (entry M 1 (r + L) - entry M 1 r) n) σ →
    Good3 (M.take (r + L)) τ0 ∧ isOT (t2X1 M r L τ0) = true ∧
    CL (TRIO.gexp M r L (entry M 0 (r + L) - entry M 0 r) (entry M 1 (r + L) - entry M 1 r) n) r = CL (M.take (r + L)) r ++ [q] ∧
    (∀ d ∈ CL (M.take (r + L)) r, σ.o d = τ0.o d) ∧ σ.v r = (ρ.v r) ∧ σ.v (r + L) = (qnS M ρ r L q) ∧ σ.v q = (qnS M ρ r L q) ∧
    σ.o q = psi (qnS M ρ r L q) (step (qnS M ρ r L q) z (qnS M ρ r L q) (sh (ρ.v r) (qnS M ρ r L q) (shIt (ρ.v r) (qnS M ρ r L q) (t2X1 M r L τ0) (n - 2))) z) z ∧
    CL (TRIO.gexp M r L (entry M 0 (r + L) - entry M 0 r) (entry M 1 (r + L) - entry M 1 r) n) q = [r + L] ∧
    ((t2X1 M r L τ0) ≠ z → step (qnS M ρ r L q) z (qnS M ρ r L q) (sh (ρ.v r) (qnS M ρ r L q) (shIt (ρ.v r) (qnS M ρ r L q) (t2X1 M r L τ0) (n - 2))) z = sh (ρ.v r) (qnS M ρ r L q) (shIt (ρ.v r) (qnS M ρ r L q) (t2X1 M r L τ0) (n - 2)) ∧
      SeedExt (qnS M ρ r L q) (t2X1 M r L τ0) (shIt (ρ.v r) (qnS M ρ r L q) (t2X1 M r L τ0) (n - 2))) := by
  obtain ⟨hX, hJ⟩ := sInvXJ_std hM hS
  set d0 := entry M 0 (r + L) - entry M 0 r with hd0def
  set d1 := entry M 1 (r + L) - entry M 1 r with hd1def
  set V := ρ.v r with hVdef
  set s' := qnS M ρ r L q with hs'def
  set X1 := t2X1 M r L τ0 with hX1def
  have hrx : r < r + L := par_lt M 2 _ _ hr
  have hqx : q < r + L := par_lt M 0 _ _ hq
  have hrM : r < M.length := by omega
  have hlen2 : 2 ≤ M.length := by omega
  have hzT : ¬ (TRIO.entry M 0 (M.length - 1) = 0 ∧ TRIO.entry M 1 (M.length - 1) = 0 ∧
      TRIO.entry M 2 (M.length - 1) = 0) := fun h => hz ((col_zero_iff M _).mpr h)
  have hexp : ∀ m, expand M m = TRIO.gexp M r L d0 d1 m := by
    intro m
    have h := expand_eq_gexp M m hlen2 hzT (by rw [h2, show M.length - 1 = r + L by omega]; exact hr)
    rw [h2, show M.length - 1 = r + L by omega] at h
    simp only [show (0 < 2) from by omega, show (1 < 2) from by omega, if_true,
      Nat.add_sub_cancel_left] at h
    exact h
  have hRk : ∀ m, 1 ≤ m → ∃ rk', Rk (TRIO.gexp M r L d0 d1 m) rk' := fun m hm => by
    obtain ⟨rk', h'⟩ := rk_expand_t2 hX hJ hz h2 I.rank m hm
    rw [hexp m] at h'; exact ⟨rk', h'⟩
  have hVot : isOT V = true := I.good.ot_v r hrM
  have hs'ot : isOT s' = true := qnS_ot I hrM L q
  have hVs' : V < s' := qnS_gt M ρ r L q
  have hP1 : TRIO.gexp M r L d0 d1 1 = M.take (r + L) := gexp_one_gen hlen
  have hlT : (M.take (r + L)).length = r + L := by rw [List.length_take]; omega
  have hrT : r < (M.take (r + L)).length := by omega
  have hv0 : τ0.v r = V := v_take_of_untopped I hlen (par_lt M 2 _ _ hr) (topP_C hM hS I hlen hr hq hqr) hC0
  have hX1e : X1 = spArg V z (sumN ((CL (M.take (r + L)) r).map τ0.o)) := by
    rw [hX1def]; unfold t2X1; rw [hv0]
  have hBhi := hFix.hi τ0 hC0
  have hFx := hFix.fix τ0 hC0
  intro n hn hGlow σ hCN _
  obtain ⟨rkN, hRN⟩ := hRk n (by omega)
  have hG0 : Good3 (M.take (r + L)) τ0 := by
    have := hGlow 1 (le_refl 1) (by omega) τ0 (by rw [hP1]; exact hC0)
    rw [hP1] at this; exact this
  have hX1ot : isOT X1 = true := by
    have := hG0.ot_o r hrT
    rw [o_cl_eq hC0 hG0 hrT] at this
    rw [hX1def]; exact isOT_arg this
  have hvq : σ.v q = s' := vq_eq_gexp hM hS I hz h2 hlen hr hn hCN hq hqr
  have hvq0 : τ0.v q = σ.v q := by rw [hvq]; exact hRes.vqP τ0 hC0
  have hdata : CL (TRIO.gexp M r L d0 d1 n) r = CL (M.take (r + L)) r ++ [q] ∧
      (∀ d ∈ CL (M.take (r + L)) r, σ.o d = τ0.o d) ∧ σ.v r = V ∧ σ.v (r + L) = s' ∧
      σ.o q = psi s' (step s' z s' (sh V s' (shIt V s' X1 (n - 2))) z) z ∧
      CL (TRIO.gexp M r L d0 d1 n) q = [r + L] := by
    rcases Nat.lt_or_ge n 3 with hn3 | hn3
    · have hn2 : n = 2 := by omega
      subst hn2
      have hCP : Cons (TRIO.gexp M r L d0 d1 (2 - 1)) τ0 := by rw [show (2 - 1 : Nat) = 1 from rfl, hP1]; exact hC0
      have hGP : Good3 (TRIO.gexp M r L d0 d1 (2 - 1)) τ0 := hGlow 1 (le_refl 1) (by omega) τ0 hCP
      have hRP : Rk (TRIO.gexp M r L d0 d1 (2 - 1)) rk0 := by rw [show (2 - 1 : Nat) = 1 from rfl, hP1]; exact hR0
      obtain ⟨hCLN, hval, hvr, hvx, hoq, hCLNq⟩ := C_frameV3 hM hS I Ctx hz h2 hlen hr hq hqr (qP_C hM hS I hlen hr hq hqr hncl hRes.un) hRes.un
        (le_refl 2) hCN hRN hCP hGP hRP hC0 hG0 hR0 hv0 hvq0
      rw [← hd0def, ← hd1def] at hCLN hoq hCLNq
      rw [hvq, qnS_vxs] at hvx
      rw [show (2 - 1 : Nat) = 1 from rfl, hP1, hv0, hvq, hvx, ← hX1e] at hoq
      exact ⟨hCLN, hval, hvr, hvx, hoq, hCLNq⟩
    · obtain ⟨rkP, hRP⟩ := hRk (n - 1) (by omega)
      have hCP : Cons (TRIO.gexp M r L d0 d1 (n - 1)) (rhsIt _ (rkBound _ rkP)) := cons_of_rk hRP
      have hGP := hGlow (n - 1) (by omega) (by omega) _ hCP
      obtain ⟨hCLN, hval, hvr, hvx, hoq, hCLNq⟩ := C_frameV3 hM hS I Ctx hz h2 hlen hr hq hqr (qP_C hM hS I hlen hr hq hqr hncl hRes.un) hRes.un
        hn hCN hRN hCP hGP hRP hC0 hG0 hR0 hv0 hvq0
      rw [← hd0def, ← hd1def] at hCLN hoq hCLNq
      have hlP : (TRIO.gexp M r L d0 d1 (n - 1)).length = r + (n - 1) * L := TRIO.gexp_length hlen
      have hrP : r < (TRIO.gexp M r L d0 d1 (n - 1)).length := by
        have : L ≤ (n - 1) * L := Nat.le_mul_of_pos_left L (by omega)
        omega
      have hqP : q < (TRIO.gexp M r L d0 d1 (n - 1)).length := by
        have : L ≤ (n - 1) * L := Nat.le_mul_of_pos_left L (by omega)
        omega
      have hval' := seed_r_value_CV3 hM hS I Ctx hz h2 hlen hr hq hqr hncl hRes hC0 hR0 (n - 1) (by omega)
        (fun m h1 h2' τ hτ => hGlow m h1 (by omega) τ hτ) _ hCP (hGP.ot_o q hqP) (cl_vals hCP hGP hrP).2
      have hform := o_cl_eq hCP hGP hrP
      rw [hval'] at hform
      simp only [psi.injEq] at hform
      have h21 := hform.2.1
      rw [← hform.1] at h21
      rw [hvq, qnS_vxs] at hvx
      rw [← hform.1, ← h21, show n - 1 - 1 = n - 2 by omega, hvq, hvx] at hoq
      exact ⟨hCLN, hval, hvr, hvx, hoq, hCLNq⟩
  obtain ⟨hCLN, hval, hvr, hvx, hoq, hCLNq⟩ := hdata
  have hOT : ∀ j, j + 1 < n → isOT (psi V (shIt V s' X1 j) z) = true := by
    intro j hj
    rcases Nat.eq_zero_or_pos j with rfl | hj0
    · have := hG0.ot_o r hrT
      rw [o_cl_eq hC0 hG0 hrT] at this
      show isOT (psi V X1 z) = true
      rw [hX1e]; rw [hv0] at this; exact this
    · obtain ⟨rkj, hRj⟩ := hRk (j + 1) (by omega)
      have hCj : Cons (TRIO.gexp M r L d0 d1 (j + 1)) (rhsIt _ (rkBound _ rkj)) := cons_of_rk hRj
      have hGj := hGlow (j + 1) (by omega) hj _ hCj
      have hlj : (TRIO.gexp M r L d0 d1 (j + 1)).length = r + (j + 1) * L := TRIO.gexp_length hlen
      have hrj : r < (TRIO.gexp M r L d0 d1 (j + 1)).length := by
        have : L ≤ (j + 1) * L := Nat.le_mul_of_pos_left L (by omega)
        omega
      have hqj : q < (TRIO.gexp M r L d0 d1 (j + 1)).length := by
        have : L ≤ (j + 1) * L := Nat.le_mul_of_pos_left L (by omega)
        omega
      have hv := seed_r_value_CV3 hM hS I Ctx hz h2 hlen hr hq hqr hncl hRes hC0 hR0 (j + 1) (by omega)
        (fun m h1 h2' τ hτ => hGlow m h1 (by omega) τ hτ) _ hCj (hGj.ot_o q hqj) (cl_vals hCj hGj hrj).2
      have := hGj.ot_o r hrj
      rw [hv, show j + 1 - 1 = j by omega] at this
      exact this
  have hinner : ∀ k, k + 1 < n → X1 ≠ z → SeedExt s' X1 (shIt V s' X1 k) →
      step s' z s' (sh V s' (shIt V s' X1 k)) z = sh V s' (shIt V s' X1 k) := by
    intro k hk hX0 hEk
    have hYot := isOT_shIt hVot hs'ot hVs' hX1ot k
    have hall := allGe_sh hVot hs'ot hVs' hYot (seedExt_allGe hVot hs'ot hVs' hBhi hEk)
    have hYne : shIt V s' X1 k ≠ z := by
      rcases hEk with h | ⟨R0, _, _, h⟩ | ⟨hc3, _, _⟩
      · rw [h]; exact hX0
      · rw [h]; intro h'; cases hB : X1 with
        | z => exact hX0 hB
        | psi _ _ _ => rw [hB] at h'; simp at h'
      · intro h'
        rw [h'] at hc3
        have : (split z (psi (succ s') z z)).1 = z := rfl
        rw [this] at hc3
        simp [cutsNSG] at hc3
    have hne := sh_ne_z (V := V) (V' := s') hYne
    have hzlt : z < sh V s' (shIt V s' X1 k) := by
      cases h : sh V s' (shIt V s' X1 k) with
      | z => exact absurd h hne
      | psi _ _ _ => exact T.z_lt_psi _ _ _
    unfold step
    rw [if_pos ⟨hzlt, psi_lt_psi_z_iff.mpr (Or.inr ⟨rfl, hzlt⟩)⟩]
    exact H_of_high hs'ot hall
  have hE : X1 ≠ z → ∀ k, k + 1 < n → SeedExt s' X1 (shIt V s' X1 k) := by
    intro hX0 k
    induction k with
    | zero => intro _; exact Or.inl rfl
    | succ k ih =>
      intro hk
      have hEk := ih (by omega)
      have hcv : isOT (psi s' (sh V s' (shIt V s' X1 k)) z) = true := by
        have := isOT_shTop (V' := s') hVot hs'ot hVs' (hOT k (by omega)) (le_refl _)
        rwa [shf_self] at this
      have h := seed_ext (a := V) hVot hs'ot hVs' hX1ot (isOT_shIt hVot hs'ot hVs' hX1ot k) hBhi hFx hEk hcv
      have hrw := hRes.rw τ0 hC0 k
      rw [hinner k (by omega) hX0 hEk] at hrw
      rw [hrw] at h
      exact h
  exact ⟨hG0, hX1ot, hCLN, hval, hvr, hvx, hvq, hoq, hCLNq,
    fun hX0 => ⟨hinner (n - 2) (by omega) hX0 (hE hX0 (n - 2) (by omega)), hE hX0 (n - 2) (by omega)⟩⟩

theorem seed_frames_C3V3 {M : Mat} {ρ : Valn} {rk : Bool → Nat → Nat}
    (hM : Std M) (hS : M ≠ SRO) (I : Inv3W M ρ rk) (Ctx : StepCtx3 M ρ rk)
    (hz : col M (M.length - 1) ≠ (0, 0, 0)) (h2 : TRIO.srow M (M.length - 1) = 2)
    {r L q : Nat} (hlen : r + L + 1 = M.length) (hr : par M 2 (r + L) = some r)
    (hq : par M 0 (r + L) = some q) (hqr : q ≠ r) (hncl : ¬ ∃ Lc, CL M r = Lc ++ [q])
    (hRes : CRel M ρ r L q) (hFix : T2SeedCFix M ρ r L q) (hDom : T2SeedCDom M ρ r L q)
    {τ0 : Valn} {rk0 : Bool → Nat → Nat} (hC0 : Cons (M.take (r + L)) τ0) (hR0 : Rk (M.take (r + L)) rk0)
    (hTV : VSmallF (M.take (r + L)) τ0) (hTO : FrameOT (M.take (r + L)) τ0)
    (hTC : FrameClosed (M.take (r + L)) τ0) :
    ∀ i, (i = r ∨ i = q) → SeedFr QVSF M r L i ∧ SeedFr QFO M r L i ∧ SeedFr QFCo M r L i := by
  obtain ⟨hX, hJ⟩ := sInvXJ_std hM hS
  set d0 := entry M 0 (r + L) - entry M 0 r with hd0def
  set d1 := entry M 1 (r + L) - entry M 1 r with hd1def
  set V := ρ.v r with hVdef
  set s' := qnS M ρ r L q with hs'def
  set X1 := t2X1 M r L τ0 with hX1def
  have hrx : r < r + L := par_lt M 2 _ _ hr
  have hqx : q < r + L := par_lt M 0 _ _ hq
  have hrM : r < M.length := by omega
  have hlen2 : 2 ≤ M.length := by omega
  have hzT : ¬ (TRIO.entry M 0 (M.length - 1) = 0 ∧ TRIO.entry M 1 (M.length - 1) = 0 ∧
      TRIO.entry M 2 (M.length - 1) = 0) := fun h => hz ((col_zero_iff M _).mpr h)
  have hexp : ∀ m, expand M m = TRIO.gexp M r L d0 d1 m := by
    intro m
    have h := expand_eq_gexp M m hlen2 hzT (by rw [h2, show M.length - 1 = r + L by omega]; exact hr)
    rw [h2, show M.length - 1 = r + L by omega] at h
    simp only [show (0 < 2) from by omega, show (1 < 2) from by omega, if_true,
      Nat.add_sub_cancel_left] at h
    exact h
  have hRk : ∀ m, 1 ≤ m → ∃ rk', Rk (TRIO.gexp M r L d0 d1 m) rk' := fun m hm => by
    obtain ⟨rk', h'⟩ := rk_expand_t2 hX hJ hz h2 I.rank m hm
    rw [hexp m] at h'; exact ⟨rk', h'⟩
  have hVot : isOT V = true := I.good.ot_v r hrM
  have hs'ot : isOT s' = true := qnS_ot I hrM L q
  have hVs' : V < s' := qnS_gt M ρ r L q
  have hP1 : TRIO.gexp M r L d0 d1 1 = M.take (r + L) := gexp_one_gen hlen
  have hlT : (M.take (r + L)).length = r + L := by rw [List.length_take]; omega
  have hrT : r < (M.take (r + L)).length := by omega
  have hv0 : τ0.v r = V := v_take_of_untopped I hlen (par_lt M 2 _ _ hr) (topP_C hM hS I hlen hr hq hqr) hC0
  have hX1e : X1 = spArg V z (sumN ((CL (M.take (r + L)) r).map τ0.o)) := by
    rw [hX1def]; unfold t2X1; rw [hv0]
  have hBhi := hFix.hi τ0 hC0
  have hFx := hFix.fix τ0 hC0
  have key := fun n hn hGlow σ hCN hGN => seed_last_CV3 hM hS I Ctx hz h2 hlen hr hq hqr hncl hRes hFix hC0 hR0 n hn hGlow σ hCN hGN
  intro i hi
  refine ⟨fun n hn hGlow σ hCN hGN => ?_, fun n hn hGlow σ hCN hGN => ?_, fun n hn hGlow σ hCN hGN => ?_⟩
  all_goals
    obtain ⟨hG0, hX1ot, hCLN, hval, hvr, hvx, hvq, hoq, hCLNq, hX1n⟩ := key n hn hGlow σ hCN hGN
    have hxN : r + L < (TRIO.gexp M r L d0 d1 n).length := by
      rw [TRIO.gexp_length hlen]
      have : 2 * L ≤ n * L := Nat.mul_le_mul_right L hn
      omega
    have hqN : q < (TRIO.gexp M r L d0 d1 n).length := by omega
    obtain ⟨y0, hy0⟩ := o_psi_sub hCN hxN
    rw [sf_ot (hGN.ot_v _ hxN), hvx] at hy0
    have hvr' : σ.v r = τ0.v r := by rw [hvr, hv0]
    have hfrq : ∀ {Q : T → List T → T → Prop}, Q (σ.v q) [] (σ.o (r + L)) →
        ∀ (Lc' : List Nat) (c : Nat) (R' : List Nat),
          CL (TRIO.gexp M r L d0 d1 n) q = Lc' ++ c :: R' → Q (σ.v q) (Lc'.map σ.o) (σ.o c) := by
      intro Q h Lc' c R' hCL
      rw [hCLNq] at hCL
      rcases Lc' with _ | ⟨a, l⟩
      · simp at hCL; rw [← hCL.1]; exact h
      · simp at hCL
    rcases hi with hi | hi <;> subst i
  · -- VSmallF, the frames of `r`
    refine seed_frames_liftE (G := M.take (r + L)) (E := []) (by simp) hCLN hvr' hval
      (fun Lc' c R' h => clField_of_vsmallF hC0 hG0 hTV r hrT Lc' c R' h) ?_
    rw [hoq, hv0]
    intro s y hsy g hg
    simp only [psi.injEq] at hsy
    obtain ⟨rfl, -⟩ := hsy
    rw [← hX1e]; exact (hDom τ0 hC0).2 g hg
  · -- VSmallF, the frame of `q`
    refine hfrq ?_
    rw [hy0, hvq]
    intro s y hsy g hg
    simp only [psi.injEq] at hsy
    obtain ⟨rfl, -⟩ := hsy
    rw [comps_eq_nil_of_lev (fun q hq => lev_lt_of_summand hs'ot hq)] at hg; simp at hg
  · -- FrameOT, the frames of `r`
    refine seed_frames_liftE (G := M.take (r + L)) (E := []) (by simp) hCLN hvr' hval
      (fun Lc' c R' h => hTO r hrT Lc' c R' h) ?_
    show isOT (psi (τ0.v r) (spArg (τ0.v r) z (sumN ((CL (M.take (r + L)) r).map τ0.o))) z) = true
    rw [← o_cl_eq hC0 hG0 hrT]; exact hG0.ot_o r hrT
  · -- FrameOT, the frame of `q`
    refine hfrq ?_
    show isOT (psi (σ.v q) (spArg (σ.v q) z (sumN ([] : List T))) z) = true
    rw [spArg_nil, hvq]
    exact isOT_psi_zz hs'ot
  · -- FrameClosed, the frames of `r`
    refine seed_frames_liftE (G := M.take (r + L)) (E := []) (by simp) hCLN hvr' hval
      (fun Lc' c R' h => clField_QFCo hG0 hTC r hrT Lc' c R' h) ⟨hGN.ot_o q hqN, ?_⟩
    have hot := hGN.ot_o q hqN
    rw [hoq] at hot ⊢
    intro s y hsy ht
    simp only [psi.injEq] at hsy
    obtain ⟨rfl, rfl, -⟩ := hsy
    have hst : spArg (τ0.v r) z (sumN ((CL (M.take (r + L)) r).map τ0.o)) = X1 := rfl
    rw [hst] at ht ⊢
    rw [hv0] at ht ⊢
    by_cases hX0 : X1 = z
    · -- the child is `ψ_{s′}(Ω_{s′})`
      have hstep : step s' z s' (sh V s' (shIt V s' X1 (n - 2))) z = psi s' z z := by
        rw [hX0, shIt_z, sh_z]; unfold step; rw [if_neg (by simp [lt])]; rfl
      rw [hstep] at hot ⊢
      rw [hX0]
      have hsp : split (psi s' z z) (psi (succ s') z z) = (z, psi s' z z) := by
        simp only [split]
        rw [if_pos (show lt (psi s' z z) (psi (succ s') z z) = true from
          psi_lt_psi_z_iff.mpr (Or.inl (lt_succ_self _)))]
      have hH : H s' (psi s' z z) = psi s' (psi s' z z) z := by
        rw [H_eq hot, hsp]; simp [hs'def]
      rw [hH]
      exact frameDom_first (le_of_lt hVs') (X := z) (by rw [lev_psi, app_z_right])
    · obtain ⟨hin, hEn⟩ := hX1n hX0
      rw [hin] at hot ⊢
      rw [hin] at ht
      have hshall := allGe_sh hVot hs'ot hVs' (isOT_shIt hVot hs'ot hVs' hX1ot (n - 2))
        (seedExt_allGe hVot hs'ot hVs' hBhi hEn)
      have hsp := (split_all_hi hshall).1
      -- `X₁` moves under `σ` (else the trigger `X₁ < σ^{n−1} X₁` fails), so it is a cut of `σ X₁`
      have hcut : X1 ∈ cutsNSG s' (sh V s' X1) := by
        rcases hFx with hfx | hc
        · exfalso
          have hit : ∀ k, shIt V s' X1 k = X1 := by
            intro k; induction k with
            | zero => rfl
            | succ k ih => show sh V s' (shIt V s' X1 k) = X1; rw [ih, hfx]
          have h1 := ht.1
          rw [hit, hfx] at h1
          exact lt_irrefl' _ h1
        · exact hc
      have hhi1 : AllGeT (psi (succ s') z z) (sh V s' X1) :=
        allGe_sh hVot hs'ot hVs' hX1ot (allGe_mono (om_le_succ hVot hs'ot hVs' s') hBhi)
      have hcutP := G.cutsPNS_of_fix hVot hs'ot hVs' hs'ot hVs' ((hDom τ0 hC0).1 hX0) hcut
      refine frameDom_of_cutP hot (fun u hu h' => hu (T.lt_trans' hVs' h')) ?_ ?_
      · rw [hsp]; exact (G.cutP_all hVot hs'ot hVs' hX1ot hhi1 hcutP (n - 2)).1
      · rw [hsp]; exact allGe_mono (om_le_succ hVot hs'ot hVs' s') hshall
  · -- FrameClosed, the frame of `q`
    refine hfrq ⟨hGN.ot_o _ hxN, ?_⟩
    rw [hy0, hvq]
    intro s y hsy _
    simp only [psi.injEq] at hsy
    obtain ⟨rfl, -⟩ := hsy
    exact frameDom_self (fun u _ => by rw [spArg_nil]; rfl)

end Ytosk.V3Main.SeedPF

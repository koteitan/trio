def ρ : Valn := ⟨fun i => ρO.getD i z, fun i => ρV.getD i z⟩
def σ : Valn := ⟨fun i => σO.getD i z, fun i => σV.getD i z⟩

private theorem std_fold : ∀ (ns : List Nat) (N : Mat), Std N → Std (ns.foldl expand N)
  | [], _, h => h
  | n :: ns, N, h => std_fold ns (expand N n) (Std.exp n h)

theorem standard : Std N := by
  have h : trace.foldl expand SRO = N := by decide
  rw [← h]
  exact std_fold trace SRO Std.sro

theorem ne_sro : N ≠ SRO := by decide

theorem cons : Cons N ρ := by unfold Cons; decide

theorem consT : Cons (N.take 25) σ := by unfold Cons; decide

/-- Under any ranking of N, the drop valuation is σ at r = 22. -/
theorem drop_o (rk : Bool → Nat → Nat) (hR : Rk N rk) : (drop1 N 25 rk).o 22 = σ.o 22 := by
  have hRt : Rk (N.take 25) rk := rk_take (by decide) hR (by
    have h : ∀ i, i < 25 → ∀ c, c ∈ children (N.take 25) i → Counted (N.take 25) i c → Counted N i c := by decide
    exact fun i c hi => h i hi c)
  exact (cons_unique (cons_of_rk hRt) consT hRt 22 (by decide)).1

theorem dep20 : DepX N 25 false 20 := (DepX.vbump (j := 21) (k := 22) (by decide) (by decide) (by decide) (by decide) (by decide) (DepX.ochild (c := 23) (by decide) (by decide) (by decide) (DepX.ov (DepX.vbump (j := 24) (k := 25) (by decide) (by decide) (by decide) (by decide) (by decide) DepX.leaf))))

theorem dep4 : DepX N 25 true 4 := (DepX.ochild (c := 19) (by decide) (by decide) (by decide) (DepX.ochild (c := 20) (by decide) (by decide) (by decide) (DepX.ov (DepX.vbump (j := 21) (k := 22) (by decide) (by decide) (by decide) (by decide) (by decide) (DepX.ochild (c := 23) (by decide) (by decide) (by decide) (DepX.ov (DepX.vbump (j := 24) (k := 25) (by decide) (by decide) (by decide) (by decide) (by decide) DepX.leaf)))))))

theorem hW : bumpW N ρ 20 = Wl := by decide

theorem hole : OHole Wl := by
  have hc : cof (psi (psi (psi z z z) z z) z z) = .big z := by decide
  show OHole (psi z (psi (psi (psi z z z) z z) z z) z)
  simp only [OHole, hc]
  decide

theorem hole_a : OHole a4 := by
  have hc : cof (psi (psi (psi z z z) z z) z z) = .big z := by decide
  show OHole (psi z (psi (psi (psi z z z) z z) z z) z)
  simp only [OHole, hc]
  decide

/-- bumpW at 20 only reads `o` of columns of N. -/
theorem bumpW_congr (ρ' : Valn) (hu : ∀ i, i < N.length → ρ'.o i = ρ.o i ∧ ρ'.v i = ρ.v i) :
    bumpW N ρ' 20 = bumpW N ρ 20 := by
  unfold bumpW
  congr 2
  congr 1
  apply List.map_congr_left
  intro j hj
  unfold bumpTerm
  split
  · congr 2
    apply List.map_congr_left
    intro c hc
    exact (hu c (mem_children hc).2).1
  · rfl

theorem absDS_fails (ρ' : Valn) (rk : Bool → Nat → Nat) (hR : Rk N rk)
    (hu : ∀ i, i < N.length → ρ'.o i = ρ.o i ∧ ρ'.v i = ρ.v i) : ¬ AbsDS N ρ' rk := by
  intro h
  have hp : par N 1 20 = some 19 := by decide
  have hW' : bumpW N ρ' 20 = Wl := (bumpW_congr ρ' hu).trans hW
  have ho : ρ'.o 22 = psi μ0 b0 z := (hu 22 (by decide)).1.trans (by decide)
  have hv : vOpt ρ' (par N 1 20) = ρ.v 19 := by rw [hp]; exact (hu 19 (by decide)).2
  have h1 := h 22 μ0 b0 (by decide) (by decide) (by decide) ho 20 (by decide) dep20 (by decide) (by decide)
    (hW' ▸ hole) (by rw [hW']; decide) q0 (by rw [hv]; decide) (by rw [hW']; decide)
  rw [show List.length N - 1 = 25 from rfl, drop_o rk hR, hW'] at h1
  exact (by decide : ¬ q0 < fsD Wl (σ.o 22)) h1

theorem tpLoS_fails (ρ' : Valn) (rk : Bool → Nat → Nat) (hR : Rk N rk)
    (hu : ∀ i, i < N.length → ρ'.o i = ρ.o i ∧ ρ'.v i = ρ.v i) : ¬ TPLoS N ρ' rk := by
  intro h
  have ho : ρ'.o 22 = psi μ0 b0 z := (hu 22 (by decide)).1.trans (by decide)
  have h4 : ρ'.o 4 = psi s4 y4 z := (hu 4 (by decide)).1.trans (by decide)
  have h1 := h 22 μ0 b0 (by decide) (by decide) (by decide) ho 4 (by decide) dep4 s4 y4 h4
    (by decide) a4 (by decide) (by decide) hole_a (by decide)
  rw [show List.length N - 1 = 25 from rfl, drop_o rk hR] at h1
  exact h1 (by decide)

theorem not_absDS (rk : Bool → Nat → Nat) (hR : Rk N rk) : ¬ AbsDS N ρ rk :=
  absDS_fails ρ rk hR (fun _ _ => ⟨rfl, rfl⟩)

theorem not_tpLoS (rk : Bool → Nat → Nat) (hR : Rk N rk) : ¬ TPLoS N ρ rk :=
  tpLoS_fails ρ rk hR (fun _ _ => ⟨rfl, rfl⟩)

/-- **No valuation of the standard matrix N has `Inv3V2`** (fields `ads` and `tplos`, each alone). -/
theorem no_inv3V2 : ¬ ∃ ρ' rk, Inv3V2 N ρ' rk := by
  rintro ⟨ρ', rk, I⟩
  exact absDS_fails ρ' rk I.rank (cons_unique I.cons cons I.rank) I.ads

theorem no_inv3V2' : ¬ ∃ ρ' rk, Inv3V2 N ρ' rk := by
  rintro ⟨ρ', rk, I⟩
  exact tpLoS_fails ρ' rk I.rank (cons_unique I.cons cons I.rank) I.tplos

theorem good : Good3 N ρ := by
  refine ⟨?_, ?_, ?_⟩
  · decide
  · decide
  · unfold cvals nzs
    decide

/-- **`HFrameV2` is false** (field `ads`; its premises Std, Cons, Rk, Good3 hold at N). -/
theorem not_HFrameV2 : ¬ HFrameV2 := by
  intro h
  obtain ⟨rk, hrk⟩ := rk_std standard ne_sro
  exact not_absDS rk hrk (h N ρ rk standard ne_sro (by decide) cons hrk good).ads

theorem main : Std N ∧ N ≠ SRO ∧ ¬ ∃ ρ' rk, Inv3V2 N ρ' rk := ⟨standard, ne_sro, no_inv3V2⟩


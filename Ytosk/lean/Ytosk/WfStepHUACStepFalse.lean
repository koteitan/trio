def rkV : List Nat := [1, 8, 2, 6, 5, 2, 3, 2, 3, 10, 4, 8, 7, 4, 3, 4, 4, 8, 10, 9, 8, 8, 11, 12, 12, 8, 8, 13, 14, 14, 8, 12, 13, 14, 14, 8, 8, 15, 16]

def σ : Valn := ⟨fun i => oT.getD i z, fun i => vT.getD i z⟩

def rk : Bool → Nat → Nat := fun b i => if b then rkO.getD i 0 else rkV.getD i 0

theorem cons : Cons M σ := by
  unfold Cons
  decide

theorem rank : Rk M rk := WfHUACShapeFalse.rk_of_rkB (by decide)

theorem good : Good3 M σ := by
  refine ⟨?_, ?_, ?_⟩
  · decide
  · decide
  · unfold cvals nzs
    decide

theorem danger : HUACShapes.Danger (vOpt σ (par M 1 37)) (bumpW M σ 33) :=
  ⟨psi z one z, by decide, by decide, one, by decide, by decide⟩

theorem children33 : children M 33 = [34, 37] := by decide
theorem children34 : children M 34 = [35, 36] := by decide

theorem not_zero : lev (bumpW M σ 33) ≠ z := by decide

theorem up1_17_32 : Up1 M 17 32 :=
  Up1.step (y := 22) (by decide) (Up1.step (y := 17) (by decide) (Up1.refl 17))

theorem not_stepDom : ¬ StepDom M σ 17 32 := by
  intro h
  have h22 := h 22 (Up1.step (y := 17) (by decide) (Up1.refl 17))
    (Up1.step (y := 22) (by decide) (Up1.refl 22)) (by decide) 18 (by decide) z
  unfold Dom at h22
  revert h22
  decide

/-- **The residual `HUACStep` is false** (on a standard matrix below SRO). -/
theorem not_HUACStep : ¬ WfHUAC2Canon.HUACStep := by
  intro h
  rcases h M σ rk standard ne_sro cons rank good 37 33 32 (by decide) (by decide) (by decide)
      danger with h0 | ⟨L, j, R, c, C, hL, hjb, _, hC, hst⟩
  · exact not_zero h0
  · have hj : j ∈ children M 33 := by rw [hL]; simp
    rw [children33] at hj
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hj
    rcases hj with rfl | rfl
    swap
    · exact absurd hjb (by decide)
    rw [children34] at hC
    cases hC
    exact not_stepDom (hst 17 up1_17_32 (by decide))


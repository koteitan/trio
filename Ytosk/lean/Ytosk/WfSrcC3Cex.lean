    32 (by decide) (by decide) (by decide) dropFail σ consN s s_mem s_ge2 s_geN s_lt)

/-- **`AbsWN M M[2]` (what `t2_absWN_bad` concludes) fails at i = 32.** -/
theorem not_absWN : ¬ AbsWN M (expand M 2) 35 ρ σ := by
  intro h

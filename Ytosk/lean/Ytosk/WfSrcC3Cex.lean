/-- The same in the `gexp` form read by `t2_absWN_bad`. -/
theorem not_absWN_gexp :
    ¬ AbsWN M (TRIO.gexp M 34 1 (entry M 0 35 - entry M 0 34) (entry M 1 35 - entry M 1 34) 2) 35 ρ σ := by
  have he := expand_eq_gexp M 2 (by decide) (by decide) (r := 34) (by decide)
  have hs : TRIO.srow M (M.length - 1) = 2 := by decide
  have hl : M.length - 1 = 35 := by decide
  rw [hs, if_pos (by decide), if_pos (by decide), hl] at he
  have h0 : TRIO.entry M 0 35 = entry M 0 35 := rfl
  have h1 : TRIO.entry M 1 35 = entry M 1 35 := rfl
  have h0' : TRIO.entry M 0 34 = entry M 0 34 := rfl
  have h1' : TRIO.entry M 1 34 = entry M 1 34 := rfl
  rw [h0, h1, h0', h1', show 35 - 34 = 1 from rfl] at he
  rw [← he]
  exact not_absWN


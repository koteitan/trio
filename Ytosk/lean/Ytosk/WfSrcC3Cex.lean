def ρ : Valn := ⟨fun i => ρO.getD i z, fun i => ρV.getD i z⟩
def τ : Valn := ⟨fun i => τO.getD i z, fun i => τV.getD i z⟩
def σ : Valn := ⟨fun i => σO.getD i z, fun i => σV.getD i z⟩

theorem cons : Cons M ρ := by unfold Cons; decide

theorem consT : Cons (M.take 35) τ := by unfold Cons; decide

theorem consN : Cons (expand M 2) σ := by unfold Cons; decide

theorem s_mem : s ∈ summands (vOpt ρ (par M 1 32)) := by decide

theorem s_ge2 : ¬ s < psi z two z := by decide

theorem s_lt : s < bumpW M ρ 32 := by decide

theorem s_geT : ¬ s < bumpW (M.take 35) τ 32 := by decide

theorem s_geN : ¬ s < bumpW (expand M 2) σ 32 := by decide

/-- `s` is not `◁ W_M(i)`: at `u = 0`, `c = W_M(i)` a component of `s` is above every component of `W_M(i)`. -/
theorem s_not_lhd : ¬ Lhd z s (bumpW M ρ 32) := by
  intro h
  have hd := h.2 z (bumpW M ρ 32) h.1 (le_refl _)
  have hno : ¬ ∀ g ∈ comps z s, ∃ y ∈ comps z (bumpW M ρ 32) ++ Gc z z, g ≤ y := by decide
  exact hno hd

theorem dropFail : WfT2Abs.DropFail M ρ τ 35 32 := by
  intro h
  exact s_not_lhd (h s s_mem s_ge2 s_geT s_lt)

theorem not_bumpAbsC : ¬ BumpAbsC M 35 ρ := by
  intro h
  have hx : ∀ j ∈ children M 32, col M j = bump M 32 → children M j = [35] → ρ.v 35 = z := by decide
  have hnb : XParNB M 35 := by
    intro q i hq hi
    have hq' : par M 0 35 = some 34 := by decide
    have hi' : par M 0 34 = some 33 := by decide
    rw [hq'] at hq; cases hq
    rw [hi'] at hi; cases hi
    decide
  exact s_not_lhd (h τ consT 32 (by decide) (by decide) hx (Or.inr (Or.inl hnb)) s s_mem s_geT s_lt)

theorem bad2 : Bad2 M := by
  refine ⟨⟨7, by decide⟩, 33, 32, by decide, by decide, by decide, Or.inr ⟨by decide, by decide, ρ, cons, ?_⟩⟩
  exact not_bumpAbsC

theorem s_not_lt_bnd : ¬ s < WfT2Abs.Bnd (ρ.v 34) := by decide

theorem s_eq_bumpW : s = bumpW M ρ 24 := by decide

/-- c = 26 is not `SmallB (v r)`: v(26) = v(r) and its counted child 27 has v(27) > v(r). -/
theorem not_smallB : ¬ WfSrcC2.SmallB M ρ (ρ.v 34) 26 := by
  intro h
  cases h with
  | lo hlt => exact (by decide : ¬ ρ.v 26 < ρ.v 34) hlt
  | eq _ hd =>
    have h27 := hd 27 (by decide) (by unfold Counted; decide)
    cases h27 with
    | lo hlt => exact (by decide : ¬ ρ.v 27 < ρ.v 34) hlt
    | eq hv _ => exact (by decide : ρ.v 27 ≠ ρ.v 34) hv

theorem o_not_lt_bnd : ¬ ρ.o 26 < WfT2Abs.Bnd (ρ.v 34) := by decide

/-- **`T2AbsNSrc` without `StepCtxT2` is false.** -/
theorem t2AbsNSrc_core_false :
    ¬ (∀ M ρ, Std M → Cons M ρ → Bad2 M → col M (M.length - 1) ≠ (0, 0, 0) → TRIO.srow M (M.length - 1) = 2 →
        ∀ r L, r + L + 1 = M.length → par M 2 (r + L) = some r → ∀ τ, Cons (M.take (r + L)) τ →
        ∀ i, i < r + L → entry M 1 i ≠ 0 → entry M 2 i ≠ 0 → WfT2Abs.DropFail M ρ τ (r + L) i →
          ∀ s ∈ summands (vOpt ρ (par M 1 i)), ¬ s < psi z two z → s < bumpW M ρ i →
            ¬ Lhd z s (bumpW M ρ i) → s < WfT2Abs.Bnd (ρ.v r)) := by
  intro h
  exact s_not_lt_bnd (h M ρ standard cons bad2 (by decide) (by decide) 34 1 (by decide) (by decide) τ consT
    32 (by decide) (by decide) (by decide) dropFail s s_mem s_ge2 s_lt s_not_lhd)

/-- **`SrcC3Res` without `StepCtxT2` and `SrcFacts` is false** (every other premise holds at M). -/
theorem srcC3_core_false :
    ¬ (∀ M ρ, Std M → Cons M ρ → Bad2 M → col M (M.length - 1) ≠ (0, 0, 0) → TRIO.srow M (M.length - 1) = 2 →
      ∀ r, r + 2 = M.length → par M 2 (r + 1) = some r → par M 0 (r + 1) = some r → par M 1 (r + 1) = some r →
      ∀ τ, Cons (M.take (r + 1)) τ →
      ∀ p i, par M 0 r = some p → par M 0 p = some i → entry M 1 i ≠ 0 → entry M 2 i ≠ 0 →
        WfT2Abs.DropFail M ρ τ (r + 1) i →
        ∀ s ∈ summands (vOpt ρ (par M 1 i)), ¬ s < psi z two z → s < bumpW M ρ i →
          ¬ Lhd z s (bumpW M ρ i) →
          ∀ m b k, par M 1 i = some m → WfHUACDeep.Up1 M b m → upg M b = some k → s = bumpW M ρ k →
            ∀ j ∈ children M k, col M j = bump M k → ∀ c ∈ children M j, WfSrcC2.SmallB M ρ (ρ.v r) c) := by
  intro h
  exact not_smallB (h M ρ standard cons bad2 (by decide) (by decide) 34 (by decide) (by decide) (by decide)
    (by decide) τ consT 33 32 (by decide) (by decide) (by decide) (by decide) dropFail s s_mem s_ge2 s_lt s_not_lhd
    31 31 24 (by decide) (WfHUACDeep.Up1.refl 31) (by decide) s_eq_bumpW 25 (by decide) (by decide) 26 (by decide))

/-- **The consumer `T2AbsNBad` without `StepCtxT2` is false** (at n = 2). -/
theorem t2AbsNBad_core_false :
    ¬ (∀ M ρ, Std M → Cons M ρ → Bad2 M → col M (M.length - 1) ≠ (0, 0, 0) → TRIO.srow M (M.length - 1) = 2 →
        ∀ r L, r + L + 1 = M.length → par M 2 (r + L) = some r → ∀ τ, Cons (M.take (r + L)) τ →
        ∀ i, i < r + L → entry M 1 i ≠ 0 → entry M 2 i ≠ 0 → WfT2Abs.DropFail M ρ τ (r + L) i →
        ∀ σ, Cons (expand M 2) σ →

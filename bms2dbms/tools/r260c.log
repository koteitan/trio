## ★★★ W の閉包性だけを使う反例の鎖（oper_closed ＋ W_dropLast）
   D_2 =                              [(0, 0, 0), (1, 1, 1), (2, 2, 1)]   C4=★真
   oper D_2 3 =                       [(0, 0, 0), (1, 1, 1), (2, 2, 0), (3, 3, 1), (4, 4, 0), (5, 5, 1)]   C4=★真
   .dropLast =                        [(0, 0, 0), (1, 1, 1), (2, 2, 0), (3, 3, 1), (4, 4, 0)]   C4=★真
   oper (.dropLast) 2 =               [(0, 0, 0), (1, 1, 1), (2, 2, 0), (3, 3, 1), (4, 3, 1)]   C4=⛔偽

## ★ さらに短い鎖（D_1 から）
   D_1 =                              [(0, 0, 0), (1, 1, 1)]   C4=★真
   oper D_1 3 =                       [(0, 0, 0), (1, 1, 0), (2, 2, 0)]   C4=★真
   oper (oper D_1 3) 2 =              [(0, 0, 0), (1, 1, 0), (2, 1, 0)]   C4=⛔偽

## ⚠ C4 を破る最小の形は「le0 で隣り合って行 1 が等しい 2 列」
   [(0, 0, 0), (1, 1, 0), (2, 1, 0)]  [(0, 0, 0), (1, 1, 0), (2, 1, 0)]   C4=⛔偽
   [(0, 0, 0), (1, 1, 1), (2, 1, 1)]  [(0, 0, 0), (1, 1, 1), (2, 1, 1)]   C4=⛔偽
